@page "/"
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Caching.Memory
@using QRCoder
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Services
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IMemoryCache Cache
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>HarmoniQ – Startseite</PageTitle>

<img src="img/harmoniq-logo.svg" alt="HarmoniQ" style="height:88px;max-width:100%;margin-bottom:8px;" />

<AuthorizeView>
    <NotAuthorized>
        @* Positionierung B+A (UX-Spec 6.2): Tagebuch führt, Entdeckung direkt darunter. *@
        <MudPaper Class="pa-6 mb-8" Elevation="4"
                  Style="background:linear-gradient(135deg,#2d1657,#1a0030); border:1px solid #D4AF37;">
            <MudText Typo="Typo.h4" Style="color:#D4AF37;">Dein Konzert-Tagebuch für Blasmusik</MudText>
            <MudText Typo="Typo.body1" Class="mt-2 mb-4" Style="color:#F0E6FF;max-width:620px;">
                Merk dir die Konzerte, die du besuchst, bewerte die gespielten Stücke – und entdecke,
                wo du als Nächstes hingehst. Die Menschen und Aufnahmen dahinter findest du gleich mit.
            </MudText>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled" Size="Size.Large" Style="background:#D4AF37; color:#0e0018;"
                           StartIcon="@Icons.Material.Filled.MenuBook" Href="Account/Register">Kostenlos starten</MudButton>
                <MudButton Variant="Variant.Outlined" Style="color:#D4AF37; border-color:#D4AF37;"
                           StartIcon="@Icons.Material.Filled.Login" Href="Account/Login">Anmelden</MudButton>
                <MudText Typo="Typo.caption" Style="color:#A78FC0;">Stöbern geht auch ohne Konto.</MudText>
            </MudStack>
        </MudPaper>
    </NotAuthorized>
    <Authorized Context="auth">
        @if (_onboardingNoetig)
        {
            <MudPaper Class="pa-4 mb-8" Elevation="4"
                      Style="background:linear-gradient(135deg,#103d36,#1a0030); border:1px solid #1ABC9C;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Badge" Style="color:#1ABC9C;font-size:2.5rem;" />
                    <div style="flex:1;min-width:240px;">
                        <MudText Typo="Typo.h6" Style="color:#F0E6FF;">Verknüpfe dich mit „deiner“ Person</MudText>
                        <MudText Typo="Typo.body2" Style="color:#A78FC0;">
                            Dein Konto ist noch keiner Person zugeordnet. Finde dich (oder lege dich neu an),
                            um dein Profil zu pflegen und dich mit anderen zu vernetzen.
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Filled" Style="background:#1ABC9C; color:#0e0018;"
                               StartIcon="@Icons.Material.Filled.PersonSearch" Href="/account/onboarding">Los geht's</MudButton>
                </MudStack>
            </MudPaper>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-4" Style="color:#A78FC0;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="color:#9B59B6;" />
                Angemeldet als <b>@auth.User.Identity?.Name</b> – du kannst bewerten, Videos vorschlagen und Besetzungen ergänzen.
            </MudText>
        }

        @if (_offeneAnfragen > 0)
        {
            <MudPaper Class="pa-4 mb-8" Elevation="4"
                      Style="background:linear-gradient(135deg,#3a2a08,#1a0030); border:1px solid #D4AF37;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                    <MudBadge Content="_offeneAnfragen" Color="Color.Error" Overlap="true">
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Style="color:#D4AF37;font-size:2.5rem;" />
                    </MudBadge>
                    <div style="flex:1;min-width:240px;">
                        <MudText Typo="Typo.h6" Style="color:#F0E6FF;">
                            @_offeneAnfragen offene Freundschaftsanfrage@(_offeneAnfragen == 1 ? "" : "n")
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color:#A78FC0;">
                            Jemand möchte sich mit dir vernetzen. Schau dir die Anfragen an und entscheide.
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Filled" Style="background:#D4AF37; color:#0e0018;"
                               StartIcon="@Icons.Material.Filled.People" Href="/account/freunde">Anfragen ansehen</MudButton>
                </MudStack>
            </MudPaper>
        }
    </Authorized>
</AuthorizeView>

@* „Mein Konzert-Jahr" – persönlicher Tagebuch-Anker weit oben (UX-Spec 6.1). *@
@if (_teaser is { Gesamt: > 0 } t)
{
    <MudPaper Class="pa-4 mb-8" Elevation="4"
              Style="background:linear-gradient(135deg,#103d36,#1a0030); border:1px solid #1ABC9C;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Style="color:#1ABC9C;font-size:2.5rem;" />
            <div style="flex:1;min-width:240px;">
                <MudText Typo="Typo.h6" Style="color:#F0E6FF;">Mein Konzert-Jahr @_heuer</MudText>
                <MudText Typo="Typo.body2" Style="color:#A78FC0;">
                    @t.Heuer Konzert@(t.Heuer == 1 ? "" : "e") @_heuer · @t.Gesamt gesamt@(t.LetzterTitel != null ? $" · zuletzt: {t.LetzterTitel}" : "")
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Style="background:#1ABC9C; color:#0e0018;"
                       StartIcon="@Icons.Material.Filled.MenuBook" Href="/account/tagebuch">Mein Tagebuch</MudButton>
        </MudStack>
    </MudPaper>
}

@* „Für dich" – personalisierter Feed aus deinen UND gefolgten Bands (Wiederkehr-Schleife, UX-Spec 4.2). *@
@if (_feed is { Leer: false })
{
    <MudPaper Class="pa-4 mb-8" Elevation="4"
              Style="background:linear-gradient(135deg,#103d36,#1a0030); border:1px solid #1ABC9C;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Style="color:#1ABC9C;" />
            <MudText Typo="Typo.h5" Style="color:#1ABC9C;">Für dich</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Text" Size="Size.Small" Style="color:#9B59B6;"
                       Href="/account/benachrichtigungen" EndIcon="@Icons.Material.Filled.Notifications">
                Wochenüberblick
            </MudButton>
        </MudStack>
        @FeedBlock("Kommende Konzerte deiner Bands", Icons.Material.Filled.Event, _feed.Kommende)
        @FeedBlock("Warst du dabei? – ins Tagebuch eintragen", Icons.Material.Filled.MenuBook, _feed.Nachfragen)
        @FeedBlock("Neue Videos deiner Bands", Icons.Material.Filled.PlayCircle, _feed.Videos)
    </MudPaper>
}

@if (_kalender.Count > 0)
{
    <MudPaper Class="pa-4 mb-8" Elevation="4" Style="background:#1a0030; border:1px solid #D4AF37;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Event" Style="color:#D4AF37;" />
            <MudText Typo="Typo.h5" Style="color:#D4AF37;">Konzerte – demnächst</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="/konzerte"
                       EndIcon="@Icons.Material.Filled.ArrowForward">Alle Konzerte</MudButton>
        </MudStack>
        <MudGrid>
            @foreach (var k in _kalender)
            {
                <MudItem xs="12" sm="6" md="4">
                    <KonzertKarte Id="k.Id" Datum="k.Datum" Titel="@k.Titel" BandNamen="k.BandNamen"
                                  Ort="@k.Ort" Distanz="k.Distanz" VideoAnzahl="k.VideoAnzahl"
                                  RelativLabel="@k.RelativLabel" />
                </MudItem>
            }
        </MudGrid>
    </MudPaper>
}

@* Deine Bands (Neuigkeiten) – neue Aufnahmen der Bands, in denen du bist (UX-Spec 6.1). *@
@if (_deineBands.Count > 0)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
        <MudIcon Icon="@Icons.Material.Filled.Groups" Style="color:#9B59B6;" />
        <MudText Typo="Typo.h5" Style="color:#D4AF37;">Deine Bands</MudText>
        @foreach (var b in _deineBands)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="@($"/bands/{b.Id}")"
                       Style="color:#F0E6FF;border-color:#3a1060;">@b.Name</MudButton>
        }
    </MudStack>
    @if (_deineBandVideos.Count > 0)
    {
        <MudGrid Class="mb-8">
            @foreach (var v in _deineBandVideos)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
                        <MudLink Href="@($"/videos/{v.Id}")">
                            <img src="@VideoEinbettung.Thumbnail(v.Plattform, v.ExternId)" style="width:100%;display:block;" alt="@v.StueckTitel" />
                        </MudLink>
                        <MudCardContent Class="pa-3">
                            <MudLink Href="@($"/videos/{v.Id}")" Style="color:#F0E6FF;font-weight:500;" Underline="Underline.Hover">@v.StueckTitel</MudLink>
                            @if (v.BandName != null)
                            {
                                <MudText Typo="Typo.caption" Class="d-block" Style="color:#A78FC0;">@v.BandName</MudText>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-8" Style="color:#A78FC0;">Von deinen Bands gibt es noch keine Aufnahmen.</MudText>
    }
}

@* Feed der Freund:innen/Bandkolleg:innen – nur wenn nicht leer; ohne Schreibbox (die ist im Freunde-Fenster) *@
<div class="mb-8">
    <AktivitaetsFeed Titel="Neuigkeiten" Max="5" ZeigePostBox="false" MehrHref="/account/freunde" />
</div>

@if (_neueVideos.Count > 0)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
        <MudText Typo="Typo.h5" Style="color:#D4AF37;">Zuletzt hinzugefügt</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="/videos"
                   EndIcon="@Icons.Material.Filled.ArrowForward">Alle Videos</MudButton>
    </MudStack>
    <MudGrid Class="mb-8">
        @foreach (var v in _neueVideos)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
                    <MudLink Href="@($"/videos/{v.Id}")">
                        <div style="position:relative;">
                            <img src="@VideoEinbettung.Thumbnail(v.Plattform, v.ExternId)"
                                 style="width:100%;display:block;" alt="@v.StueckTitel" />
                            <MudIcon Icon="@Icons.Material.Filled.PlayCircle"
                                     Style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:#fff;opacity:0.85;"
                                     Size="Size.Large" />
                        </div>
                    </MudLink>
                    <MudCardContent Class="pa-3">
                        <MudLink Href="@($"/videos/{v.Id}")" Style="color:#F0E6FF;font-weight:500;"
                                 Underline="Underline.Hover">@v.StueckTitel</MudLink>
                        @if (v.BandName != null)
                        {
                            <MudText Typo="Typo.caption" Class="d-block" Style="color:#A78FC0;">@v.BandName</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
    <MudText Typo="Typo.h5" Style="color:#D4AF37;">Komponist:innen</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="/komponisten"
               EndIcon="@Icons.Material.Filled.ArrowForward">Alle Komponist:innen</MudButton>
</MudStack>
<MudGrid>
    @foreach (var k in _komponisten)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudAvatar Style="background:#3a1060; color:#D4AF37;" Size="Size.Large">
                            @if (k.BildUrl != null)
                            {
                                <img src="@k.BildUrl" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" alt="@k.Name" />
                            }
                            else { @(k.Name.Length > 0 ? k.Name[0].ToString() : "?") }
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.h6" Style="color:#F0E6FF;">@k.Name</MudText>
                            <MudText Typo="Typo.caption" Style="color:#A78FC0;">@k.AnzahlWerke Werke</MudText>
                        </div>
                    </MudStack>
                    @if (k.Biografie != null)
                    {
                        <MudText Typo="Typo.body2" Class="mt-3" Style="color:#C4B0D8;">
                            @(k.Biografie.Length > 140 ? k.Biografie[..140] + "…" : k.Biografie)
                        </MudText>
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Style="background:#D4AF37; color:#0e0018;"
                               Href="@($"/personen/{k.Id}")">Werke ansehen</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@if (_bands.Count > 0)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-10 mb-1">
        <MudText Typo="Typo.h5" Style="color:#D4AF37;">Bands &amp; Orchester</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="/bands"
                   EndIcon="@Icons.Material.Filled.ArrowForward">Alle Bands</MudButton>
    </MudStack>
    <MudGrid>
        @foreach (var b in _bands)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudAvatar Style="background:#3a1060; color:#9B59B6;" Size="Size.Large">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" />
                            </MudAvatar>
                            <div>
                                <MudLink Href="@($"/bands/{b.Id}")" Typo="Typo.h6"
                                         Style="color:#F0E6FF;" Underline="Underline.Hover">@b.Name</MudLink>
                                <MudText Typo="Typo.caption" Class="d-block" Style="color:#A78FC0;">
                                    @(b.Land ?? "")@(b.MitgliederCount > 0 ? $" · {b.MitgliederCount} Mitglieder" : "")@(b.VideosCount > 0 ? $" · {b.VideosCount} Aufnahmen" : "")
                                </MudText>
                            </div>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Style="color:#D4AF37;"
                                   Href="@($"/bands/{b.Id}")">Zur Band</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@* Statistik – „Beleg", bewusst klein und weit unten (UX-Spec 6.1/6.2). *@
<MudText Typo="Typo.overline" Class="mt-10 mb-1 d-block" Style="color:#6f5a86;">HarmoniQ in Zahlen</MudText>
<MudGrid Class="mb-4">
    @Kachel(Icons.Material.Filled.Person, _komponistenCount, "Komponist:innen", "#D4AF37", "/komponisten")
    @Kachel(Icons.Material.Filled.Groups2, _personenCount, "Personen", "#1ABC9C", "/personen")
    @Kachel(Icons.Material.Filled.Groups, _bandsCount, "Bands", "#9B59B6", "/bands")
    @Kachel(Icons.Material.Filled.MusicNote, _stueckeCount, "Stücke", "#8E44AD", "/stuecke")
    @Kachel(Icons.Material.Filled.VideoLibrary, _videosCount, "Videos", "#E67E22", "/videos")
    @Kachel(Icons.Material.Filled.Star, _bewertungenCount, "Bewertungen", "#F1C40F", null)
</MudGrid>

<MudPaper Class="pa-6 mt-6 d-flex flex-column align-center" Elevation="2"
          Style="background:#1a0030; border:1px solid #3a1060;">
    <MudText Typo="Typo.h6" GutterBottom="true" Style="color:#D4AF37;">HarmoniQ weitergeben</MudText>
    <MudText Typo="Typo.body2" Class="mb-4" Align="Align.Center" Style="color:#A78FC0; max-width:420px;">
        Scanne den Code mit dem Smartphone, um HarmoniQ direkt zu öffnen – ideal, um die App
        von Handy zu Handy weiterzugeben.
    </MudText>
    <div style="background:#fff; padding:14px; border-radius:14px; line-height:0;">
        @_qrSvg
    </div>
    <MudText Typo="Typo.caption" Class="mt-3" Style="color:#6f5a86;">harmoniq.q-no.ch</MudText>
</MudPaper>

@code {
    private RenderFragment Kachel(string icon, int anzahl, string titel, string farbe, string? ziel) => __builder =>
    {
        <MudItem xs="4" sm="4" md="2">
            <MudPaper Class="@($"pa-2 d-flex flex-column align-center{(ziel != null ? " cursor-pointer" : "")}")"
                      Elevation="2" Style="background:#1a0030; border:1px solid #3a1060;"
                      @onclick="@(() => { if (ziel != null) Nav.NavigateTo(ziel); })">
                <MudIcon Icon="@icon" Size="Size.Small" Style="@($"color:{farbe};")" />
                @if (_geladen)
                {
                    <MudText Typo="Typo.h6" Class="mt-1" Style="color:#F0E6FF;">@anzahl</MudText>
                }
                else
                {
                    @* Dezenter Lade-Platzhalter statt eines irreführenden „0" (UX-Spec Block 7/8, A4). *@
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="36px" Height="28px"
                                 Class="mt-1" Animation="Animation.Wave" />
                }
                <MudText Typo="Typo.body2" Style="color:#A78FC0;">@titel</MudText>
            </MudPaper>
        </MudItem>
    };

    private int _komponistenCount, _personenCount, _bandsCount, _stueckeCount, _videosCount, _bewertungenCount;
    private List<Zeile> _komponisten = [];
    private List<BandZeile> _bands = [];
    private List<VideoZeile> _neueVideos = [];
    private List<KalenderZeile> _kalender = [];
    private bool _onboardingNoetig;
    private int _offeneAnfragen;
    private bool _geladen;   // true sobald die Statistik geladen ist – steuert Skeleton statt „0"
    private TagebuchTeaser? _teaser;
    private readonly int _heuer = DateTime.Today.Year;
    private List<BandRef> _deineBands = [];
    private List<VideoZeile> _deineBandVideos = [];
    private DigestService.Digest? _feed;
    private MarkupString _qrSvg = QrErzeugen();

    private RenderFragment FeedBlock(string titel, string icon, List<DigestService.Posten> posten) => __builder =>
    {
        if (posten.Count == 0) return;
        <MudText Typo="Typo.subtitle2" Class="mt-3" Style="color:#9B59B6;">@titel</MudText>
        <MudList T="string" Dense="true">
            @foreach (var p in posten.Take(5))
            {
                <MudListItem T="string" Icon="@icon" Href="@p.Href" Style="color:#F0E6FF;">
                    @p.Titel
                    <MudText Typo="Typo.caption" Class="d-block" Style="color:#A78FC0;">@p.Detail</MudText>
                </MudListItem>
            }
        </MudList>
    };

    private static MarkupString QrErzeugen()
    {
        using var gen = new QRCodeGenerator();
        using var data = gen.CreateQrCode("https://harmoniq.q-no.ch", QRCodeGenerator.ECCLevel.M);
        var svg = new SvgQRCode(data).GetGraphic(5, "#1a0030", "#ffffff", drawQuietZones: false);
        return (MarkupString)svg;
    }

    private const string GlobalCacheKey = "home:global";

    protected override async Task OnInitializedAsync()
    {
        // (1) Globale, für alle User identische Daten (6 Zähler + Featured-Komponist:innen/Bands):
        // gecacht (5 min), damit ~8 DB-Round-Trips aus dem Hot-Path verschwinden. Sie ändern sich
        // selten; die teuerste Query (Featured-Komponist:innen) läuft so nur alle paar Minuten.
        var global = await Cache.GetOrCreateAsync(GlobalCacheKey, async entry =>
        {
            entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(5);
            return await GlobaleDatenLadenAsync();
        });
        _komponistenCount = global!.KomponistenCount;
        _personenCount = global.PersonenCount;
        _bandsCount = global.BandsCount;
        _stueckeCount = global.StueckeCount;
        _videosCount = global.VideosCount;
        _bewertungenCount = global.BewertungenCount;
        _komponisten = global.Komponisten;
        _bands = global.Bands;

        // (2) Verbleibende unabhängige Queries parallel ausführen – je Task ein eigener Kontext aus
        // der Factory (DbContext ist nicht thread-sicher), gesammelt via Task.WhenAll statt sequenziell.
        var neueVideosTask = NeueVideosLadenAsync();
        var kalenderTask = KalenderLadenAsync();
        var userStatusTask = UserStatusLadenAsync();
        var teaserTask = TagebuchTeaserLadenAsync();
        var deineBandsTask = DeineBandsLadenAsync();
        var feedTask = FeedLadenAsync();
        await Task.WhenAll(neueVideosTask, kalenderTask, userStatusTask, teaserTask, deineBandsTask, feedTask);

        _neueVideos = neueVideosTask.Result;
        _kalender = kalenderTask.Result;
        (_onboardingNoetig, _offeneAnfragen) = userStatusTask.Result;
        _teaser = teaserTask.Result;
        (_deineBands, _deineBandVideos) = deineBandsTask.Result;
        _feed = feedTask.Result;
        _geladen = true;
    }

    // Globale, gecachte Daten – einmalig pro Cache-Intervall für alle User berechnet.
    private async Task<GlobaleDaten> GlobaleDatenLadenAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var komponistenCount = await db.Personen.CountAsync(p => p.Rollen.Any(r => r.Rolle == PersonRolleTyp.Komponist));
        var personenCount = await db.Personen.CountAsync();
        var bandsCount = await db.Bands.CountAsync();
        var stueckeCount = await db.Stuecke.CountAsync();
        var videosCount = await db.Videos.CountAsync(v => v.Status == VideoStatus.Genehmigt);
        var bewertungenCount = await db.Bewertungen.CountAsync();

        // Nur Komponist:innen, deren Stücke mind. ein (genehmigtes) Video haben oder in einem
        // Konzertprogramm vorkommen – und davon die „werkreichsten" ersten paar (Rest via „Alle").
        var komponisten = await db.Personen
            .Where(p => p.Rollen.Any(r => r.Rolle == PersonRolleTyp.Komponist)
                && p.StueckBeitraege.Any(sb =>
                    sb.Stueck.Videos.Any(v => v.Status == VideoStatus.Genehmigt)
                    || db.KonzertStuecke.Any(ks => ks.StueckId == sb.StueckId)))
            .OrderByDescending(p => p.StueckBeitraege.Count)
            .ThenBy(p => p.Name)
            .Select(p => new Zeile(p.Id, p.Name, p.BildUrl, p.Biografie, p.StueckBeitraege.Count))
            .Take(6)
            .ToListAsync();

        // Bands mit den meisten Mitgliedern zuerst (max. 6 auf der Startseite).
        var bands = await db.Bands
            .OrderByDescending(b => b.Mitgliedschaften.Count)
            .ThenBy(b => b.Name)
            .Select(b => new BandZeile(b.Id, b.Name, b.Land, b.Mitgliedschaften.Count, b.Videos.Count))
            .Take(6)
            .ToListAsync();

        return new GlobaleDaten(komponistenCount, personenCount, bandsCount, stueckeCount,
            videosCount, bewertungenCount, komponisten, bands);
    }

    private async Task<List<VideoZeile>> NeueVideosLadenAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        return await db.Videos
            .Where(v => v.Status == VideoStatus.Genehmigt)
            .OrderByDescending(v => v.ErstelltAm)
            .Select(v => new VideoZeile(v.Id, v.Plattform, v.ExternId, v.Stueck.Titel,
                v.Band != null ? v.Band.Name : null))
            .Take(4)
            .ToListAsync();
    }

    private async Task<List<KalenderZeile>> KalenderLadenAsync()
    {
        // Konzert-Kalender: bewusst vorwärtsschauend – ab gestern bis ~6 Wochen voraus,
        // chronologisch aufsteigend, die nächsten 6 (nächstes zuerst).
        var heute = DateOnly.FromDateTime(DateTime.Today);
        var von = heute.AddDays(-1);
        var bis = heute.AddDays(42);
        await using var db = await DbFactory.CreateDbContextAsync();
        var konzerte = await db.Konzerte
            .Where(k => k.Datum >= von && k.Datum <= bis)
            .OrderBy(k => k.Datum)
            .Select(k => new
            {
                k.Id, k.Datum, k.Name,
                Ort = k.Lokal != null ? k.Lokal.Name : k.Ort,
                Lat = k.Lokal != null ? k.Lokal.Lat : null,
                Lng = k.Lokal != null ? k.Lokal.Lng : null,
                BandNamen = k.Bands.OrderBy(b => b.Band.Name).Select(b => b.Band.Name).ToList(),
                VideoAnzahl = k.Videos.Count(v => v.Status == VideoStatus.Genehmigt)
            })
            .Take(6)
            .ToListAsync();
        return konzerte
            .Select(k => new KalenderZeile(k.Id, k.Datum, k.Name, k.Ort,
                RelativLabel(k.Datum, heute), k.Datum == heute, k.Datum < heute)
            { Lat = k.Lat, Lng = k.Lng, BandNamen = k.BandNamen, VideoAnzahl = k.VideoAnzahl })
            .ToList();
    }

    // „Mein Konzert-Jahr"-Teaser (Tagebuch) – user-spezifisch, null wenn anonym/kein Eintrag.
    private async Task<TagebuchTeaser?> TagebuchTeaserLadenAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId)) return null;

        await using var db = await DbFactory.CreateDbContextAsync();
        var besuche = await db.KonzertBesuche
            .Where(b => b.BenutzerId == userId)
            .Select(b => new { b.KonzertId, b.Konzert.Datum, b.Konzert.Name })
            .ToListAsync();
        if (besuche.Count == 0) return new TagebuchTeaser(0, 0, null, null);

        var letzter = besuche.OrderByDescending(b => b.Datum).First();
        return new TagebuchTeaser(
            besuche.Count(b => b.Datum.Year == _heuer), besuche.Count,
            letzter.KonzertId, letzter.Name ?? letzter.Datum.ToString("dd.MM.yyyy"));
    }

    // „Deine Bands" – Bands, in denen die verknüpfte Person Mitglied ist, + deren neueste Videos.
    private async Task<(List<BandRef>, List<VideoZeile>)> DeineBandsLadenAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId)) return ([], []);

        await using var db = await DbFactory.CreateDbContextAsync();
        var meineId = await db.Personen.Where(p => p.BenutzerId == userId).Select(p => p.Id).FirstOrDefaultAsync();
        if (meineId == Guid.Empty) return ([], []);

        // Roh laden, dann client-seitig entdoppeln/sortieren (EF kann Distinct über die
        // Record-Projektion mit Join nicht übersetzen).
        var roh = await db.BandMitgliedschaften
            .Where(m => m.PersonId == meineId)
            .Select(m => new { m.BandId, Name = m.Band.Name })
            .ToListAsync();
        var bands = roh
            .GroupBy(x => x.BandId)
            .Select(g => new BandRef(g.Key, g.First().Name))
            .OrderBy(b => b.Name)
            .ToList();
        if (bands.Count == 0) return ([], []);

        var bandIds = bands.Select(b => b.Id).ToList();
        var videos = await db.Videos
            .Where(v => v.Status == VideoStatus.Genehmigt && v.BandId != null && bandIds.Contains(v.BandId!.Value))
            .OrderByDescending(v => v.ErstelltAm)
            .Select(v => new VideoZeile(v.Id, v.Plattform, v.ExternId, v.Stueck.Titel, v.Band!.Name))
            .Take(4)
            .ToListAsync();
        return (bands, videos);
    }

    // „Für dich"-Feed: Live-Zusammenstellung (ohne Dedup) aus Mitglied- ∪ gefolgten Bands.
    private async Task<DigestService.Digest> FeedLadenAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId)) return new([], [], []);
        await using var db = await DbFactory.CreateDbContextAsync();
        return await DigestService.ErstelleAsync(db, userId, nurUngesehene: false);
    }

    // User-spezifischer Onboarding-/Anfragen-Status – pro Request (nicht cachebar).
    private async Task<(bool OnboardingNoetig, int OffeneAnfragen)> UserStatusLadenAsync()
    {
        // Onboarding-Hinweis: eingeloggt, aber (noch) keine verknüpfte Person und kein offener Antrag.
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId))
            return (false, 0);

        await using var db = await DbFactory.CreateDbContextAsync();
        var meineId = await db.Personen.Where(p => p.BenutzerId == userId).Select(p => p.Id).FirstOrDefaultAsync();
        var hatPerson = meineId != Guid.Empty;
        var hatAntrag = await db.PersonAnsprueche.AnyAsync(a => a.BenutzerId == userId && a.Status == PersonAnspruchStatus.Offen);
        var onboardingNoetig = !hatPerson && !hatAntrag;

        // Offene (noch nicht entschiedene) Freundschaftsanfragen an mich.
        var offeneAnfragen = 0;
        if (hatPerson)
            offeneAnfragen = await db.Freundschaften.CountAsync(f =>
                f.EmpfaengerPersonId == meineId && f.Status == FreundschaftStatus.Offen);

        return (onboardingNoetig, offeneAnfragen);
    }

    // Dekoratives km-Label: Bezugspunkt aus localStorage lesen, Distanz berechnen (keine Umsortierung).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _kalender.All(k => k.Lat is null)) return;
        var pos = await JS.InvokeAsync<double[]?>("harmoniqGeo.autoStandort")
                  ?? await JS.InvokeAsync<double[]?>("harmoniqGeo.load");
        if (pos is not { Length: 2 }) return;
        foreach (var k in _kalender)
            if (k.Lat is double la && k.Lng is double lo)
                k.Distanz = Distanz(pos[0], pos[1], la, lo);
        StateHasChanged();
    }

    private static double Distanz(double lat1, double lng1, double lat2, double lng2)
    {
        const double R = 6371.0;
        double Rad(double g) => g * Math.PI / 180.0;
        var dLat = Rad(lat2 - lat1);
        var dLng = Rad(lng2 - lng1);
        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2)
              + Math.Cos(Rad(lat1)) * Math.Cos(Rad(lat2)) * Math.Sin(dLng / 2) * Math.Sin(dLng / 2);
        return R * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
    }

    private static string RelativLabel(DateOnly datum, DateOnly heute)
    {
        var tage = datum.DayNumber - heute.DayNumber;
        return tage switch
        {
            0 => "heute",
            1 => "morgen",
            -1 => "gestern",
            > 1 => $"in {tage} Tagen",
            _ => $"vor {-tage} Tagen"
        };
    }

    // Gecachte globale Daten (für alle User identisch) – ein Eintrag im IMemoryCache.
    private record GlobaleDaten(
        int KomponistenCount, int PersonenCount, int BandsCount, int StueckeCount,
        int VideosCount, int BewertungenCount,
        List<Zeile> Komponisten, List<BandZeile> Bands);

    private record TagebuchTeaser(int Heuer, int Gesamt, Guid? LetzterKonzertId, string? LetzterTitel);
    private record BandRef(Guid Id, string Name);

    private record Zeile(Guid Id, string Name, string? BildUrl, string? Biografie, int AnzahlWerke);
    private record BandZeile(Guid Id, string Name, string? Land, int MitgliederCount, int VideosCount);
    private record VideoZeile(Guid Id, VideoPlattform Plattform, string ExternId, string StueckTitel, string? BandName);
    private record KalenderZeile(Guid Id, DateOnly Datum, string? Name, string? Ort,
        string RelativLabel, bool IstHeute, bool IstVergangen)
    {
        public string Titel => Name ?? Datum.ToString("dd.MM.yyyy");
        public double? Lat { get; init; }
        public double? Lng { get; init; }
        public double? Distanz { get; set; }   // dekorativ, nur wenn Bezugspunkt bekannt
        public List<string> BandNamen { get; init; } = [];
        public int VideoAnzahl { get; init; }
    }

@page "/admin/personen"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Components.Pages.Admin.Dialogs
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Personen verwalten – Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="/admin"
               StartIcon="@Icons.Material.Filled.ArrowBack">Admin</MudButton>
    <MudText Typo="Typo.h4" Style="color:#D4AF37;">Personen</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Style="background:#D4AF37; color:#0e0018;"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Bearbeiten(null))">Neu</MudButton>
</MudStack>

<MudTextField @bind-Value="_suche" @bind-Value:after="Filtern" Label="Suchen" Variant="Variant.Outlined"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
              Clearable="true" Class="mb-3" Style="max-width:360px;" />

<MudDataGrid T="Zeile" Items="_gefiltert" Hover="true" Dense="true" SortMode="SortMode.Single" Style="background:#1a0030;">
    <Columns>
        <PropertyColumn Property="z => z.Name" Title="Name" />
        <TemplateColumn Title="Sichtbarkeit"><CellTemplate>@SichtbarkeitText(context.Item.Sichtbarkeit)</CellTemplate></TemplateColumn>
        <TemplateColumn Title="Rollen"><CellTemplate>@string.Join(", ", context.Item.Rollen.Select(RolleText))</CellTemplate></TemplateColumn>
        <PropertyColumn Property="z => z.AnzahlBands" Title="Bands" />
        <PropertyColumn Property="z => z.AnzahlWerke" Title="Werke" />
        <PropertyColumn Property="z => z.AnzahlAuftritte" Title="Auftritte" />
        <TemplateColumn Title="Aktionen" Sortable="false">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Style="color:#9B59B6;"
                               title="Öffentliche Ansicht" Href="@($"/personen/{context.Item.Id}")" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Style="color:#D4AF37;"
                               title="Bearbeiten (Stammdaten, Bands, Mitwirkungen)" Href="@($"/admin/personen/{context.Item.Id}")" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => Loeschen(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    private List<Zeile> _alle = [];
    private List<Zeile> _gefiltert = [];
    private List<PersonDialog.InstrumentOption> _instrumente = [];
    private string _suche = "";

    protected override async Task OnInitializedAsync() => await Laden();

    private async Task Laden()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _instrumente = await db.Instrumente.OrderBy(i => i.Name)
            .Select(i => new PersonDialog.InstrumentOption(i.Id, i.Name)).ToListAsync();
        var personen = await db.Personen
            .Include(p => p.Rollen)
            .OrderBy(p => p.Name)
            .ToListAsync();
        var werke = await db.StueckBeitraege.GroupBy(b => b.PersonId)
            .Select(g => new { g.Key, C = g.Count() }).ToDictionaryAsync(x => x.Key, x => x.C);
        var auftritte = await db.VideoMitwirkungen.GroupBy(m => m.PersonId)
            .Select(g => new { g.Key, C = g.Count() }).ToDictionaryAsync(x => x.Key, x => x.C);
        var bands = await db.BandMitgliedschaften.GroupBy(m => m.PersonId)
            .Select(g => new { g.Key, C = g.Count() }).ToDictionaryAsync(x => x.Key, x => x.C);

        _alle = personen.Select(p => new Zeile(
            p.Id, p.Name, p.Sichtbarkeit,
            p.Rollen.Select(r => r.Rolle).ToList(),
            bands.GetValueOrDefault(p.Id), werke.GetValueOrDefault(p.Id), auftritte.GetValueOrDefault(p.Id))).ToList();
        Filtern();
    }

    private void Filtern() =>
        _gefiltert = _suche == "" ? _alle
            : _alle.Where(z => z.Name.Contains(_suche, StringComparison.OrdinalIgnoreCase)).ToList();

    private async Task Bearbeiten(Guid? id)
    {
        PersonDialog.PersonModell? vorhanden = null;
        if (id is { } pid)
        {
            await using var db0 = await DbFactory.CreateDbContextAsync();
            var p = await db0.Personen.Include(x => x.Rollen).Include(x => x.Links).Include(x => x.Instrumente)
                .FirstOrDefaultAsync(x => x.Id == pid);
            if (p == null) return;
            vorhanden = new PersonDialog.PersonModell
            {
                Id = p.Id, Name = p.Name, Sichtbarkeit = p.Sichtbarkeit, Geburtsjahr = p.Geburtsjahr,
                Biografie = p.Biografie, BildUrl = p.BildUrl,
                Webseite = p.Webseite, Instagram = p.Instagram, X = p.X, Facebook = p.Facebook, YouTube = p.YouTube,
                Rollen = new HashSet<PersonRolleTyp>(p.Rollen.Select(r => r.Rolle)),
                InstrumentIds = new HashSet<Guid>(p.Instrumente.Select(pi => pi.InstrumentId))
            };
        }

        var parameters = new DialogParameters<PersonDialog>
        {
            { x => x.Vorhanden, vorhanden },
            { x => x.Instrumente, _instrumente }
        };
        var dialog = await DialogService.ShowAsync<PersonDialog>(id == null ? "Neue Person" : "Person bearbeiten",
            parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        var m = (PersonDialog.PersonModell)result.Data!;

        await using var db = await DbFactory.CreateDbContextAsync();
        Person entity;
        if (id == null)
        {
            entity = new Person();
            db.Personen.Add(entity);
        }
        else
        {
            entity = await db.Personen.Include(x => x.Rollen).Include(x => x.Links).Include(x => x.Instrumente)
                .FirstAsync(x => x.Id == m.Id);
        }

        entity.Name = m.Name.Trim();
        entity.Sichtbarkeit = m.Sichtbarkeit;
        entity.Geburtsjahr = m.Geburtsjahr;
        entity.Biografie = m.Biografie;
        entity.BildUrl = m.BildUrl;

        // Rollen synchronisieren (explizit über das DbSet)
        foreach (var weg in entity.Rollen.Where(r => !m.Rollen.Contains(r.Rolle)).ToList())
        {
            entity.Rollen.Remove(weg);
            db.PersonRollen.Remove(weg);
        }
        foreach (var neu in m.Rollen.Where(rt => entity.Rollen.All(r => r.Rolle != rt)))
        {
            var pr = new PersonRolle { PersonId = entity.Id, Rolle = neu };
            entity.Rollen.Add(pr);
            db.PersonRollen.Add(pr);
        }

        // Links explizit über das DbSet synchronisieren (zuverlässiger als nur Navigation)
        SyncLink(db, entity, LinkTyp.Webseite, m.Webseite);
        SyncLink(db, entity, LinkTyp.Instagram, m.Instagram);
        SyncLink(db, entity, LinkTyp.X, m.X);
        SyncLink(db, entity, LinkTyp.Facebook, m.Facebook);
        SyncLink(db, entity, LinkTyp.YouTube, m.YouTube);

        // Instrumente synchronisieren
        foreach (var weg in entity.Instrumente.Where(pi => !m.InstrumentIds.Contains(pi.InstrumentId)).ToList())
        {
            entity.Instrumente.Remove(weg);
            db.PersonInstrumente.Remove(weg);
        }
        foreach (var neu in m.InstrumentIds.Where(iid => entity.Instrumente.All(pi => pi.InstrumentId != iid)))
        {
            var pi = new PersonInstrument { PersonId = entity.Id, InstrumentId = neu };
            entity.Instrumente.Add(pi);
            db.PersonInstrumente.Add(pi);
        }

        await db.SaveChangesAsync();
        Snackbar.Add("Gespeichert.", Severity.Success);

        // Neue Person → direkt zur Bearbeiten-Seite (Bands/Mitwirkungen ergänzen).
        if (id == null) { Nav.NavigateTo($"/admin/personen/{entity.Id}"); return; }
        await Laden();
    }

    private async Task Loeschen(Zeile z)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Text, $"Person \"{z.Name}\" löschen? Damit werden auch ihre {z.AnzahlWerke} Werk-Beiträge und {z.AnzahlAuftritte} Auftritte entfernt (die Stücke/Videos selbst bleiben)." }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Löschen bestätigen", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Personen.FindAsync(z.Id);
        if (entity != null) { db.Personen.Remove(entity); await db.SaveChangesAsync(); Snackbar.Add("Gelöscht.", Severity.Success); }
        await Laden();
    }

    // Legt einen PersonLink an / aktualisiert / entfernt ihn explizit über das DbSet.
    private static void SyncLink(ApplicationDbContext db, Person e, LinkTyp typ, string? url)
    {
        var ex = e.Links.FirstOrDefault(l => l.Typ == typ);
        url = string.IsNullOrWhiteSpace(url) ? null : url.Trim();
        if (url == null)
        {
            if (ex != null) { e.Links.Remove(ex); db.PersonLinks.Remove(ex); }
        }
        else if (ex != null)
        {
            ex.Url = url;
        }
        else
        {
            var neu = new PersonLink { PersonId = e.Id, Typ = typ, Url = url };
            e.Links.Add(neu);
            db.PersonLinks.Add(neu);
        }
    }

    private static string RolleText(PersonRolleTyp r) => r switch
    {
        PersonRolleTyp.Komponist => "Komponist:in",
        PersonRolleTyp.Dirigent => "Dirigent:in",
        PersonRolleTyp.Musikant => "Musikant:in",
        _ => r.ToString()
    };

    private static string SichtbarkeitText(Sichtbarkeit s) => s switch
    {
        Sichtbarkeit.Oeffentlich => "Öffentlich",
        Sichtbarkeit.NurInitialen => "Nur Initialen",
        _ => "Nicht bekannt"
    };

    private record Zeile(Guid Id, string Name, Sichtbarkeit Sichtbarkeit, List<PersonRolleTyp> Rollen,
        int AnzahlBands, int AnzahlWerke, int AnzahlAuftritte);
}

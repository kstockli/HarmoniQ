@page "/admin/bands"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Components.Pages.Admin.Dialogs
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Bands verwalten – Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="/admin"
               StartIcon="@Icons.Material.Filled.ArrowBack">Admin</MudButton>
    <MudText Typo="Typo.h4" Style="color:#D4AF37;">Bands</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Style="background:#D4AF37; color:#0e0018;"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Bearbeiten(null))">Neu</MudButton>
</MudStack>

<MudDataGrid T="Band" Items="_items" Hover="true" Dense="true" SortMode="SortMode.Single" Style="background:#1a0030;">
    <Columns>
        <PropertyColumn Property="b => b.Name" Title="Name" />
        <PropertyColumn Property="b => b.Land" Title="Land" />
        <TemplateColumn Title="Videos"><CellTemplate>@context.Item.Videos.Count</CellTemplate></TemplateColumn>
        <TemplateColumn Title="Aktionen" Sortable="false">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Style="color:#D4AF37;"
                               OnClick="@(() => Bearbeiten(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => Loeschen(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    private List<Band> _items = [];

    protected override async Task OnInitializedAsync() => await Laden();

    private async Task Laden()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _items = await db.Bands.Include(b => b.Videos).OrderBy(b => b.Name).ToListAsync();
    }

    private async Task Bearbeiten(Band? b)
    {
        var parameters = new DialogParameters<BandDialog> { { x => x.Vorhanden, b } };
        var dialog = await DialogService.ShowAsync<BandDialog>(
            b == null ? "Neue Band" : "Band bearbeiten", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        var model = (Band)result.Data!;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (b == null)
        {
            db.Bands.Add(model);
        }
        else
        {
            var entity = await db.Bands.FindAsync(model.Id);
            if (entity == null) return;
            entity.Name = model.Name;
            entity.Land = model.Land;
            entity.Webseite = model.Webseite;
        }
        await db.SaveChangesAsync();
        Snackbar.Add("Gespeichert.", Severity.Success);
        await Laden();
    }

    private async Task Loeschen(Band b)
    {
        var hatVideos = b.Videos.Count;
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Text, hatVideos > 0
                ? $"Band \"{b.Name}\" wird gelöscht. Die {hatVideos} zugeordneten Videos bleiben erhalten (Band wird entfernt)."
                : $"Band \"{b.Name}\" löschen?" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Löschen bestätigen", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Bands.FindAsync(b.Id);
        if (entity != null)
        {
            // Videos behalten, aber Band-Zuordnung lösen (FK ist "No Action").
            var videos = await db.Videos.Where(v => v.BandId == b.Id).ToListAsync();
            foreach (var v in videos) v.BandId = null;
            db.Bands.Remove(entity);
            await db.SaveChangesAsync();
            Snackbar.Add("Gelöscht.", Severity.Success);
        }
        await Laden();
    }
}

@using HarmoniQ.Web.Data.Models

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_m.Name" Label="Name" Variant="Variant.Outlined" Required="true" Class="mb-3" />

        <MudGrid Spacing="2" Class="mb-1">
            <MudItem xs="12" sm="6">
                <MudSelect T="Sichtbarkeit" @bind-Value="_m.Sichtbarkeit" Label="Sichtbarkeit" Variant="Variant.Outlined">
                    <MudSelectItem Value="Sichtbarkeit.Oeffentlich">Öffentlich</MudSelectItem>
                    <MudSelectItem Value="Sichtbarkeit.NurInitialen">Nur Initialen</MudSelectItem>
                    <MudSelectItem Value="Sichtbarkeit.NichtBekannt">Nicht bekannt (?)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int?" @bind-Value="_m.Geburtsjahr" Label="Geburtsjahr" Variant="Variant.Outlined"
                                 Min="1800" Max="2100" />
            </MudItem>
        </MudGrid>

        <MudSelect T="PersonRolleTyp" MultiSelection="true" @bind-SelectedValues="_rollen" Label="Rollen"
                   Variant="Variant.Outlined" Class="mb-3"
                   MultiSelectionTextFunc="@(x => string.Join(", ", x))">
            <MudSelectItem Value="PersonRolleTyp.Komponist">Komponist:in</MudSelectItem>
            <MudSelectItem Value="PersonRolleTyp.Dirigent">Dirigent:in</MudSelectItem>
            <MudSelectItem Value="PersonRolleTyp.Musikant">Musikant:in</MudSelectItem>
            <MudSelectItem Value="PersonRolleTyp.Zuhoerer">Zuhörer:in</MudSelectItem>
        </MudSelect>

        <MudSelect T="Guid" MultiSelection="true" @bind-SelectedValues="_instrumentSel" Label="Instrumente"
                   Variant="Variant.Outlined" Class="mb-3" MultiSelectionTextFunc="NamenText">
            @foreach (var i in Instrumente)
            {
                <MudSelectItem T="Guid" Value="@i.Id">@i.Name</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="_m.Biografie" Label="Biografie" Variant="Variant.Outlined" Lines="3" Class="mb-3" />
        <MudTextField @bind-Value="_m.BildUrl" Label="Bild-URL" Variant="Variant.Outlined" Class="mb-3" />

        <MudText Typo="Typo.subtitle2" Class="mb-1" Style="color:#A78FC0;">Kontakt &amp; Links</MudText>
        <MudTextField @bind-Value="_m.EMail" Label="E-Mail" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Immediate="true"
                      HelperText="Bei kontoverknüpften Personen wird die E-Mail automatisch synchronisiert." />
        <MudTextField @bind-Value="_m.Mobile" Label="Mobile" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Immediate="true" />
        <MudTextField @bind-Value="_m.Webseite" Label="Webseite" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Immediate="true" />
        <MudTextField @bind-Value="_m.Instagram" Label="Instagram" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Immediate="true" />
        <MudTextField @bind-Value="_m.X" Label="X" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Immediate="true" />
        <MudTextField @bind-Value="_m.Facebook" Label="Facebook" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Immediate="true" />
        <MudTextField @bind-Value="_m.YouTube" Label="YouTube" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled" Style="background:#D4AF37; color:#0e0018;"
                   OnClick="Speichern" Disabled="@string.IsNullOrWhiteSpace(_m.Name)">Speichern</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public PersonModell? Vorhanden { get; set; }
    [Parameter] public List<InstrumentOption> Instrumente { get; set; } = [];

    private PersonModell _m = new();
    private IReadOnlyCollection<PersonRolleTyp> _rollen = new HashSet<PersonRolleTyp>();
    private IReadOnlyCollection<Guid> _instrumentSel = new HashSet<Guid>();

    private string NameOf(Guid id) => Instrumente.FirstOrDefault(i => i.Id == id)?.Name ?? "?";
    private string NamenText(IReadOnlyList<string> vals) => string.Join(", ", vals.Select(v => NameOf(Guid.Parse(v))));

    protected override void OnInitialized()
    {
        if (Vorhanden != null)
        {
            _m = new PersonModell
            {
                Id = Vorhanden.Id,
                Name = Vorhanden.Name,
                Sichtbarkeit = Vorhanden.Sichtbarkeit,
                Geburtsjahr = Vorhanden.Geburtsjahr,
                Biografie = Vorhanden.Biografie,
                BildUrl = Vorhanden.BildUrl,
                Webseite = Vorhanden.Webseite,
                Instagram = Vorhanden.Instagram,
                X = Vorhanden.X,
                Facebook = Vorhanden.Facebook,
                YouTube = Vorhanden.YouTube,
                EMail = Vorhanden.EMail,
                Mobile = Vorhanden.Mobile,
                Rollen = new HashSet<PersonRolleTyp>(Vorhanden.Rollen),
                InstrumentIds = new HashSet<Guid>(Vorhanden.InstrumentIds)
            };
            _rollen = new HashSet<PersonRolleTyp>(Vorhanden.Rollen);
            _instrumentSel = new HashSet<Guid>(Vorhanden.InstrumentIds);
        }
    }

    private void Speichern()
    {
        _m.Rollen = new HashSet<PersonRolleTyp>(_rollen);
        _m.InstrumentIds = new HashSet<Guid>(_instrumentSel);
        MudDialog.Close(DialogResult.Ok(_m));
    }

    /// <summary>Transport-Objekt (kein EF-Entity) für den Dialog.</summary>
    public class PersonModell
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public Sichtbarkeit Sichtbarkeit { get; set; } = Sichtbarkeit.Oeffentlich;
        public int? Geburtsjahr { get; set; }
        public string? Biografie { get; set; }
        public string? BildUrl { get; set; }
        public string? Webseite { get; set; }
        public string? Instagram { get; set; }
        public string? X { get; set; }
        public string? Facebook { get; set; }
        public string? YouTube { get; set; }
        public string? EMail { get; set; }
        public string? Mobile { get; set; }
        public HashSet<PersonRolleTyp> Rollen { get; set; } = [];
        public HashSet<Guid> InstrumentIds { get; set; } = [];
    }

    public record InstrumentOption(Guid Id, string Name);
}

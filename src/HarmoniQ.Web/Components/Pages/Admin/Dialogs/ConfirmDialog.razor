<MudDialog>
    <DialogContent>
        <MudText>@Text</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled" Color="ConfirmColor" OnClick="@(() => MudDialog.Close(DialogResult.Ok(true)))">
            @ConfirmText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Text { get; set; } = "Wirklich löschen?";
    [Parameter] public string ConfirmText { get; set; } = "Löschen";
    /// <summary>Farbe des Bestätigungs-Buttons – Default Rot (Löschen); für unkritische Aktionen überschreibbar.</summary>
    [Parameter] public Color ConfirmColor { get; set; } = Color.Error;
}

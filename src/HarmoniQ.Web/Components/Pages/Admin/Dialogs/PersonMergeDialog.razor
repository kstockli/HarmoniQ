@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            „<b>@QuelleName</b>" wird in die gewählte Person <b>hineingeschmolzen</b>: alle Beiträge,
            Mitwirkungen, Instrumente, Rollen, Bandmitgliedschaften, Konzert-Mitwirkungen, Freundschaften
            und Feed-Einträge werden übernommen (ohne Dubletten), der Name bleibt als Alias erhalten,
            danach wird „@QuelleName" gelöscht. <b>Nicht umkehrbar.</b>
        </MudAlert>
        <MudAutocomplete T="PersonRef" Label="Ziel-Person" Variant="Variant.Outlined" Required="true"
                         Value="_ziel" ValueChanged="@(v => _ziel = v)" SearchFunc="Suche"
                         ToStringFunc="@(p => p?.Name ?? "")" MaxItems="30" ResetValueOnEmptyText="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   OnClick="Bestaetigen" Disabled="@(_ziel is null)">Zusammenführen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid QuelleId { get; set; }
    [Parameter] public string QuelleName { get; set; } = "";

    private PersonRef? _ziel;
    private List<PersonRef> _personen = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _personen = await db.Personen.Where(p => p.Id != QuelleId).OrderBy(p => p.Name)
            .Select(p => new PersonRef(p.Id, p.Name)).ToListAsync();
    }

    private Task<IEnumerable<PersonRef>> Suche(string? v, CancellationToken ct)
    {
        IEnumerable<PersonRef> r = string.IsNullOrWhiteSpace(v)
            ? _personen : _personen.Where(p => p.Name.Contains(v, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(r.Take(30));
    }

    private void Bestaetigen()
    {
        if (_ziel is null) return;
        MudDialog.Close(DialogResult.Ok(_ziel.Id));
    }

    public record PersonRef(Guid Id, string Name);
}

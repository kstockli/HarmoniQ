@page "/admin/konzerte"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Components.Pages.Admin.Dialogs
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Konzerte verwalten – Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="/admin"
               StartIcon="@Icons.Material.Filled.ArrowBack">Admin</MudButton>
    <MudText Typo="Typo.h4" Style="color:#D4AF37;">Konzerte</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Text" Size="Size.Small" Style="color:#6f5a86;"
               StartIcon="@Icons.Material.Filled.History" OnClick="@(() => _zeigeAudit = !_zeigeAudit)">
        @(_zeigeAudit ? "Audit-Infos ausblenden" : "Audit-Infos")
    </MudButton>
    <MudButton Variant="Variant.Filled" Style="background:#D4AF37; color:#0e0018;"
               StartIcon="@Icons.Material.Filled.Add" Href="/admin/konzerte/erfassen">Neu (Wizard)</MudButton>
</MudStack>

<MudPaper Class="pa-4 mb-4" Elevation="2" Style="background:#1a0030; border:1px solid #3a1060;">
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="_suche" @bind-Value:after="Filtern" Label="Suchen (Name / Ort)"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="8" sm="4">
            <MudAutocomplete T="string" @bind-Value="_bandText" @bind-Value:after="Filtern" Label="Band"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" CoerceValue="true"
                             ResetValueOnEmptyText="true" Immediate="true" SearchFunc="SucheBand" MaxItems="20" />
        </MudItem>
        <MudItem xs="4" sm="3">
            <MudNumericField T="int?" @bind-Value="_jahr" @bind-Value:after="Filtern" Label="Jahr"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Min="1900" Max="2100" />
        </MudItem>
    </MudGrid>
    <MudText Typo="Typo.caption" Class="mt-2" Style="color:#A78FC0;">@_gefiltert.Count von @_items.Count Konzerten</MudText>
</MudPaper>

<MudDataGrid T="Konzert" Items="_gefiltert" Hover="true" Dense="true" SortMode="SortMode.Single" Style="background:#1a0030;">
    <Columns>
        <TemplateColumn Title="Datum" SortBy="@(k => k.Datum)">
            <CellTemplate>@KonzertZeitFormat.Kompakt(context.Item.Datum, context.Item.Uhrzeit)</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="k => k.Name" Title="Name" />
        <PropertyColumn Property="k => k.Ort" Title="Ort" />
        <TemplateColumn Title="Bands"><CellTemplate>@context.Item.Bands.Count</CellTemplate></TemplateColumn>
        <TemplateColumn Title="Videos"><CellTemplate>@context.Item.Videos.Count</CellTemplate></TemplateColumn>
        @if (_zeigeAudit)
        {
            <TemplateColumn Title="Erstellt" Sortable="false"><CellTemplate><span style="color:#6f5a86;font-size:.8rem;">@AuditFormat.Zeit(context.Item.CreateTime)@AuditFormat.Wer(context.Item.CreateUser)</span></CellTemplate></TemplateColumn>
            <TemplateColumn Title="Geändert" Sortable="false"><CellTemplate><span style="color:#6f5a86;font-size:.8rem;">@AuditFormat.Zeit(context.Item.ModifyTime)@AuditFormat.Wer(context.Item.ModifyUser)</span></CellTemplate></TemplateColumn>
        }
        <TemplateColumn Title="Aktionen" Sortable="false">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Style="color:#9B59B6;"
                               title="Ansehen" Href="@($"/konzerte/{context.Item.Id}")" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Style="color:#D4AF37;"
                               title="Bearbeiten (Wizard)" Href="@($"/admin/konzerte/{context.Item.Id}/bearbeiten")" />
                <MudIconButton Icon="@Icons.Material.Filled.Merge" Size="Size.Small" Style="color:#9B59B6;"
                               title="Mit anderem Konzert zusammenführen" OnClick="@(() => Zusammenfuehren(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => Loeschen(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    private List<Konzert> _items = [];
    private List<Konzert> _gefiltert = [];
    private bool _zeigeAudit;
    private List<string> _bandNamen = [];
    private string _suche = "";
    private string? _bandText;
    private int? _jahr;

    protected override async Task OnInitializedAsync() => await Laden();

    private async Task Laden()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _items = await db.Konzerte
            .Include(k => k.Bands).ThenInclude(kb => kb.Band)
            .Include(k => k.Videos)
            .OrderByDescending(k => k.Datum)
            .ToListAsync();
        _bandNamen = await db.Bands.OrderBy(b => b.Name).Select(b => b.Name).ToListAsync();
        Filtern();
    }

    private Task<IEnumerable<string>> SucheBand(string? v, CancellationToken ct)
    {
        IEnumerable<string> r = string.IsNullOrWhiteSpace(v)
            ? _bandNamen : _bandNamen.Where(n => n.Contains(v, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(r.Take(20));
    }

    private void Filtern()
    {
        var s = _suche.Trim();
        _gefiltert = _items
            .Where(k =>
                (s == "" || (k.Name ?? "").Contains(s, StringComparison.OrdinalIgnoreCase)
                          || (k.Ort ?? "").Contains(s, StringComparison.OrdinalIgnoreCase)) &&
                (_jahr == null || k.Datum.Year == _jahr) &&
                (string.IsNullOrWhiteSpace(_bandText)
                    || k.Bands.Any(kb => kb.Band != null && kb.Band.Name.Contains(_bandText, StringComparison.OrdinalIgnoreCase))))
            .OrderByDescending(k => k.Datum)
            .ToList();
    }

    private async Task Zusammenfuehren(Konzert k)
    {
        var parameters = new DialogParameters<KonzertMergeDialog> { { x => x.QuelleId, k.Id }, { x => x.QuelleName, Bez(k) } };
        var dialog = await DialogService.ShowAsync<KonzertMergeDialog>("Konzert zusammenführen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        var zielId = (Guid)result.Data!;

        await using var db = await DbFactory.CreateDbContextAsync();
        var (ok, meldung) = await HarmoniQ.Web.Services.KonzertMergeService.MergeAsync(db, k.Id, zielId);
        Snackbar.Add(meldung, ok ? Severity.Success : Severity.Error);
        await Laden();
    }

    private async Task Loeschen(Konzert k)
    {
        var hatVideos = k.Videos.Count;
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Text, hatVideos > 0
                ? $"Konzert \"{Bez(k)}\" wird gelöscht. Die {hatVideos} zugeordneten Videos bleiben erhalten (Konzert-Bezug wird entfernt)."
                : $"Konzert \"{Bez(k)}\" löschen?" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Löschen bestätigen", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Konzerte.FindAsync(k.Id);
        if (entity != null)
        {
            // Videos behalten (FK ist SetNull); KonzertBand-Zeilen werden per Cascade entfernt.
            db.Konzerte.Remove(entity);
            await db.SaveChangesAsync();
            Snackbar.Add("Gelöscht.", Severity.Success);
        }
        await Laden();
    }

    private static string Bez(Konzert k) =>
        k.Name ?? k.Datum.ToString("dd.MM.yyyy");
}

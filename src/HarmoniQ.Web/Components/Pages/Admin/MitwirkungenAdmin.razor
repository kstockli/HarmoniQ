@page "/admin/mitwirkungen"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISnackbar Snackbar

<PageTitle>Mitwirkungs-Vorschläge – Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="/admin"
               StartIcon="@Icons.Material.Filled.ArrowBack">Admin</MudButton>
    <MudText Typo="Typo.h4" Style="color:#D4AF37;">Mitwirkungs-Vorschläge</MudText>
</MudStack>

@if (_offen.Count == 0)
{
    <MudAlert Severity="Severity.Success">Keine offenen Besetzungs-Vorschläge.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var m in _offen)
        {
            <MudItem xs="12" md="6">
                <MudCard Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
                    <MudStack Row="true">
                        <VideoVorschau Plattform="@m.Plattform" ExternId="@m.ExternId" BildUrl="@m.BildUrl" Groesse="mqdefault"
                                       Style="width:140px;flex-shrink:0;" Alt="" />
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle1" Style="color:#F0E6FF;">@m.PersonName</MudText>
                            <MudText Typo="Typo.body2" Style="color:#A78FC0;">
                                @m.Rolle@(m.Instrument != null ? $" · {m.Instrument}" : "")@(m.Stimme != null ? $" · {m.Stimme}" : "")
                            </MudText>
                            <MudText Typo="Typo.caption" Class="d-block mt-1" Style="color:#A78FC0;">
                                Stück: @m.StueckTitel
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(m.Anmerkung))
                            {
                                <MudText Typo="Typo.caption" Class="d-block" Style="color:#C4B0D8;font-style:italic;">„@m.Anmerkung"</MudText>
                            }
                            <MudText Typo="Typo.caption" Class="d-block" Style="color:#6f5a86;">
                                vorgeschlagen von: @(m.VonEmail ?? "unbekannt")
                            </MudText>
                        </MudCardContent>
                    </MudStack>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Check"
                                   OnClick="@(() => Setze(m.Id, VideoStatus.Genehmigt))">Genehmigen</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Close"
                                   OnClick="@(() => Setze(m.Id, VideoStatus.Abgelehnt))">Ablehnen</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<Zeile> _offen = [];

    protected override async Task OnInitializedAsync() => await Laden();

    private async Task Laden()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _offen = await db.VideoMitwirkungen
            .Where(m => m.Status == VideoStatus.Ausstehend)
            .OrderBy(m => m.Video.Stueck.Titel)
            .Select(m => new Zeile(
                m.Id, m.Video.Plattform, m.Video.ExternId, m.Video.BildUrl, m.Video.Stueck.Titel, m.Person.Name, m.Rolle,
                m.Instrument != null ? m.Instrument.Name : null,
                m.Stimme != null ? m.Stimme.Bezeichnung : null,
                m.Anmerkung,
                m.VorgeschlagenVon != null ? m.VorgeschlagenVon.Email : null))
            .ToListAsync();
    }

    private async Task Setze(Guid id, VideoStatus status)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var m = await db.VideoMitwirkungen.FindAsync(id);
        if (m != null)
        {
            m.Status = status;
            await db.SaveChangesAsync();
            Snackbar.Add(status == VideoStatus.Genehmigt ? "Genehmigt." : "Abgelehnt.",
                status == VideoStatus.Genehmigt ? Severity.Success : Severity.Info);
        }
        await Laden();
    }

    private record Zeile(Guid Id, VideoPlattform Plattform, string ExternId, string? BildUrl, string StueckTitel, string PersonName,
        MitwirkungRolle Rolle, string? Instrument, string? Stimme, string? Anmerkung, string? VonEmail);
}

@page "/admin/lokale"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Services
@using HarmoniQ.Web.Components.Pages.Admin.Dialogs
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject GeocodingService Geo

<PageTitle>Lokale – Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4" Style="color:#D4AF37;">Lokale (Veranstaltungsorte)</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Style="background:#D4AF37;color:#0e0018;"
               StartIcon="@Icons.Material.Filled.Add" OnClick="NeuesLokal" Disabled="_geoLaeuft">
        Neues Lokal
    </MudButton>
    <MudButton Variant="Variant.Outlined" Style="color:#9B59B6;border-color:#9B59B6;"
               StartIcon="@Icons.Material.Filled.MyLocation" OnClick="KoordinatenErgaenzen" Disabled="_geoLaeuft">
        @(_geoLaeuft ? $"Koordinaten… {_geoFortschritt}" : "Koordinaten via Nominatim ergänzen")
    </MudButton>
</MudStack>

@if (_lokale == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-3" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="_suche" @bind-Value:after="Filtern" Label="Suchen (Name / Stadt)"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="flex:1;min-width:220px;" />
        <MudCheckBox T="bool" @bind-Value="_nurOhneKoord" @bind-Value:after="Filtern"
                     Label="Nur ohne Koordinaten" Color="Color.Primary" />
    </MudStack>

    <MudSimpleTable Dense="true" Hover="true" Bordered="true"
                    Style="background:#1a0030; border:1px solid #3a1060;">
        <thead>
            <tr>
                <th style="color:#9B59B6;">Name</th>
                <th style="color:#9B59B6;">Stadt</th>
                <th style="color:#9B59B6;">Kanton</th>
                <th style="color:#9B59B6;">Konzerte</th>
                <th style="color:#9B59B6;">Aliase</th>
                <th style="color:#9B59B6;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in _gefiltert)
            {
                <tr>
                    <td style="color:#F0E6FF;">@l.Name</td>
                    <td style="color:#A78FC0;">@(l.Stadt ?? "–")</td>
                    <td style="color:#A78FC0;">@(l.Kanton ?? "–")</td>
                    <td style="color:#A78FC0;">@l.KonzertAnzahl</td>
                    <td style="color:#A78FC0;">@l.AliasAnzahl</td>
                    <td>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Style="color:#9B59B6;"
                                   OnClick="@(() => Bearbeiten(l.Id))">Bearbeiten</MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Merge" Size="Size.Small" Title="Zusammenführen"
                                       Style="color:#D4AF37;" OnClick="@(() => Zusammenfuehren(l))" />
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    <MudText Typo="Typo.caption" Class="mt-2" Style="color:#A78FC0;">@_gefiltert.Count von @_lokale.Count</MudText>
}

@code {
    private List<Zeile>? _lokale;
    private List<Zeile> _gefiltert = [];
    private string _suche = "";
    private bool _nurOhneKoord;
    private bool _geoLaeuft;
    private string _geoFortschritt = "";

    protected override async Task OnInitializedAsync() => await Laden();

    private async Task Laden()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _lokale = await db.Lokale
            .OrderBy(l => l.Name)
            .Select(l => new Zeile(l.Id, l.Name, l.Stadt, l.Kanton,
                db.Konzerte.Count(k => k.LokalId == l.Id), l.Aliase.Count,
                l.Lat != null && l.Lng != null))
            .ToListAsync();
        Filtern();
    }

    private void Filtern()
    {
        var s = _suche.Trim();
        _gefiltert = (_lokale ?? [])
            .Where(l => (!_nurOhneKoord || !l.HatKoordinaten)
                && (s.Length == 0
                    || l.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || (l.Stadt ?? "").Contains(s, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    private async Task NeuesLokal()
    {
        // LokalId = Guid.Empty → Dialog im Anlege-Modus.
        var parameters = new DialogParameters<LokalDialog> { { x => x.LokalId, Guid.Empty } };
        var dialog = await DialogService.ShowAsync<LokalDialog>("Neues Lokal", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) await Laden();
    }

    private async Task Bearbeiten(Guid id)
    {
        var parameters = new DialogParameters<LokalDialog> { { x => x.LokalId, id } };
        var dialog = await DialogService.ShowAsync<LokalDialog>("Lokal bearbeiten", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) await Laden();
    }

    private async Task Zusammenfuehren(Zeile quelle)
    {
        var parameters = new DialogParameters<LokalMergeDialog>
        {
            { x => x.QuelleId, quelle.Id },
            { x => x.QuelleName, quelle.Name }
        };
        var dialog = await DialogService.ShowAsync<LokalMergeDialog>("Lokale zusammenführen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: Guid zielId })
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var (ok, meldung) = await LokalMergeService.MergeAsync(db, quelle.Id, zielId);
            Snackbar.Add(meldung, ok ? Severity.Success : Severity.Error);
            if (ok) await Laden();
        }
    }

    // Batch: füllt Koordinaten (+ Kanton, falls leer) für alle Lokale ohne Koordinaten via Nominatim.
    // Rate-limitiert (~1 Anfrage/s, Policy), pro Treffer sofort gespeichert (Wiederaufnahme möglich).
    private async Task KoordinatenErgaenzen()
    {
        _geoLaeuft = true;
        int erfolg = 0;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var offen = await db.Lokale.Where(l => l.Lat == null || l.Lng == null).ToListAsync();
            for (var i = 0; i < offen.Count; i++)
            {
                var l = offen[i];
                _geoFortschritt = $"{i + 1}/{offen.Count}";
                StateHasChanged();

                var query = string.Join(", ", new[] { l.Name, l.Adresse, l.Stadt }
                    .Where(x => !string.IsNullOrWhiteSpace(x)));
                if (!query.Contains("schweiz", StringComparison.OrdinalIgnoreCase)) query += ", Schweiz";

                var t = await Geo.GeocodeDetailAsync(query);
                if (t is not null)
                {
                    l.Lat = t.Lat;
                    l.Lng = t.Lng;
                    if (string.IsNullOrWhiteSpace(l.Kanton) && !string.IsNullOrWhiteSpace(t.Kanton)) l.Kanton = t.Kanton;
                    await db.SaveChangesAsync();
                    erfolg++;
                }
                await Task.Delay(1100);   // Nominatim: max ~1 Anfrage/Sekunde
            }
        }
        _geoLaeuft = false;
        _geoFortschritt = "";
        Snackbar.Add($"Koordinaten ergänzt für {erfolg} Lokal(e).", Severity.Success);
        await Laden();
    }

    private record Zeile(Guid Id, string Name, string? Stadt, string? Kanton, int KonzertAnzahl, int AliasAnzahl,
        bool HatKoordinaten);
}

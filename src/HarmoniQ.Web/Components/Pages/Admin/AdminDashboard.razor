@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Admin – HarmoniQ</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Style="color:#D4AF37;">Admin-Dashboard</MudText>
<MudText Typo="Typo.body2" Class="mb-6" Style="color:#A78FC0;">Daten verwalten und Vorschläge prüfen.</MudText>

<MudGrid>
    @AdminCard("Personen", _personen, Icons.Material.Filled.Person, "/admin/personen")
    @AdminCard("Benutzer", _benutzer, Icons.Material.Filled.ManageAccounts, "/admin/benutzer")
    @AdminCard("Konzerte", _konzerte, Icons.Material.Filled.Event, "/admin/konzerte")
    @AdminCard("Stücke", _stuecke, Icons.Material.Filled.MusicNote, "/admin/stuecke")
    @AdminCard("Bands", _bands, Icons.Material.Filled.Groups, "/admin/bands")
    @AdminCard("Videos", _videos, Icons.Material.Filled.VideoLibrary, "/admin/videos")
    @AdminCard("Crawler (offene Funde)", _crawlerFundeOffen, Icons.Material.Filled.TravelExplore, "/admin/crawler")
</MudGrid>

<MudDivider Class="my-6" Style="border-color:#3a1060;" />

<MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">
    Ausstehende Anträge
    @if (_offenGesamt > 0)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ml-2">@_offenGesamt</MudChip>
    }
</MudText>
@if (_offenGesamt == 0)
{
    <MudAlert Severity="Severity.Success" Class="mb-4" Style="max-width:520px;">
        Alles erledigt – keine offenen Anträge.
    </MudAlert>
}
<MudGrid>
    @AntragCard("Video-Vorschläge", _videosOffen, Icons.Material.Filled.RateReview, "/admin/vorschlaege")
    @AntragCard("Mitwirkungs-Vorschläge", _mitwirkungenOffen, Icons.Material.Filled.GroupAdd, "/admin/mitwirkungen")
    @AntragCard("Richtigstellungen", _richtigstellungenOffen, Icons.Material.Filled.ReportProblem, "/admin/richtigstellungen")
    @AntragCard("Verknüpfungs-Anträge", _verknuepfungenOffen, Icons.Material.Filled.PersonPin, "/admin/verknuepfungen")
    @AntragCard("Band-Anträge", _bandantraegeOffen, Icons.Material.Filled.GroupAdd, "/admin/bandantraege")
</MudGrid>

@code {
    private int _personen, _stuecke, _bands, _videos, _konzerte, _benutzer, _crawlerFundeOffen;
    private int _videosOffen, _mitwirkungenOffen, _richtigstellungenOffen, _verknuepfungenOffen, _bandantraegeOffen;
    private int _offenGesamt;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _personen = await db.Personen.CountAsync();
        _stuecke = await db.Stuecke.CountAsync();
        _bands = await db.Bands.CountAsync();
        _videos = await db.Videos.CountAsync();
        _konzerte = await db.Konzerte.CountAsync();
        _benutzer = await db.Users.CountAsync();
        _crawlerFundeOffen = await db.CrawlFunde.CountAsync(f => f.Status == CrawlFundStatus.Offen);

        _videosOffen = await db.Videos.CountAsync(v => v.Status == VideoStatus.Ausstehend);
        _mitwirkungenOffen = await db.VideoMitwirkungen.CountAsync(m => m.Status == VideoStatus.Ausstehend);
        _richtigstellungenOffen = await db.Richtigstellungen.CountAsync(r => r.Status == RichtigstellungStatus.Offen);
        _verknuepfungenOffen = await db.PersonAnsprueche.CountAsync(a => a.Status == PersonAnspruchStatus.Offen);
        _bandantraegeOffen = await db.BandbeitrittAntraege.CountAsync(a => a.Status == PersonAnspruchStatus.Offen);
        _offenGesamt = _videosOffen + _mitwirkungenOffen + _richtigstellungenOffen + _verknuepfungenOffen + _bandantraegeOffen;
    }

    private RenderFragment AntragCard(string titel, int anzahl, string icon, string href) => __builder =>
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="4" Style="@($"background:#1a0030; border:1px solid {(anzahl > 0 ? "#D4AF37" : "#3a1060")};")">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudBadge Content="anzahl" Color="Color.Error" Overlap="true" Visible="anzahl > 0">
                            <MudIcon Icon="@icon" Style="@($"color:{(anzahl > 0 ? "#D4AF37" : "#6f5a86")};font-size:2.2rem;")" />
                        </MudBadge>
                        <div>
                            <MudText Typo="Typo.subtitle2" Style="color:#F0E6FF;">@titel</MudText>
                            <MudText Typo="Typo.caption" Style="color:#A78FC0;">
                                @(anzahl == 0 ? "keine offen" : $"{anzahl} offen")
                            </MudText>
                        </div>
                    </MudStack>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Style="color:#D4AF37;" Href="@href">Öffnen</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    };

    private RenderFragment AdminCard(string titel, int anzahl, string icon, string href) => __builder =>
    {
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
                <MudCardContent Class="d-flex flex-column align-center">
                    <MudIcon Icon="@icon" Style="color:#D4AF37;font-size:2.5rem;" />
                    <MudText Typo="Typo.h4" Class="mt-2" Style="color:#F0E6FF;">@anzahl</MudText>
                    <MudText Typo="Typo.body2" Style="color:#A78FC0;">@titel</MudText>
                </MudCardContent>
                <MudCardActions Class="justify-center">
                    <MudButton Variant="Variant.Text" Style="color:#D4AF37;" Href="@href">Verwalten</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    };
}

@page "/admin/text-bereinigung"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using HarmoniQ.Web.Services
@inject TextBereinigungService Dienst
@inject ISnackbar Snackbar

<PageTitle>Text-Bereinigung – Admin</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2" Style="color:#D4AF37;">Text-Bereinigung (Urheberrecht)</MudText>
<MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
    Schreibt importierte Fremdtexte per LLM in <b>eigenen deutschen Worten</b> neu (kein Kopieren fremder
    Formulierungen). <b>Band-Bios</b> = WMC-Import (englisch → deutsch); <b>KKL-Beschreibungen</b> = paraphrasiert.
    Zuerst Vorschau (schreibt nichts), dann übernehmen.
</MudAlert>

<div class="d-flex gap-3 mb-4 align-center flex-wrap">
    <MudSelect T="TextBereinigungService.Art" @bind-Value="_art" Label="Was" Variant="Variant.Outlined"
               Dense="true" Style="max-width:280px;">
        <MudSelectItem Value="TextBereinigungService.Art.BandBio">Band-Bios (WMC, englisch)</MudSelectItem>
        <MudSelectItem Value="TextBereinigungService.Art.KklBeschreibung">KKL-Konzert-Beschreibungen</MudSelectItem>
    </MudSelect>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SammelnAsync" Disabled="_busy">
        Vorschau erzeugen
    </MudButton>
    @if (_vorschlaege.Count > 0)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="AnwendenAsync" Disabled="_busy">
            Alle @_vorschlaege.Count übernehmen
        </MudButton>
    }
    @if (_busy)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
        <MudText Typo="Typo.body2">@_status</MudText>
    }
</div>

@if (_geladen && _vorschlaege.Count == 0 && !_busy)
{
    <MudAlert Severity="Severity.Success" Dense="true">Nichts zu bereinigen – keine passenden Texte gefunden.</MudAlert>
}

@if (_vorschlaege.Count > 0)
{
    <MudText Typo="Typo.caption" Class="mb-2 d-block" Style="color:#A78FC0;">@_vorschlaege.Count Vorschläge</MudText>
    @foreach (var v in _vorschlaege)
    {
        <MudPaper Class="pa-3 mb-2" Elevation="1" Style="background:#1a0030;border:1px solid #3a1060;">
            <MudText Typo="Typo.subtitle2" Style="color:#D4AF37;">@v.Name</MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Style="color:#6f5a86;">Original</MudText>
                    <MudText Typo="Typo.body2" Style="color:#8f7aa8;white-space:pre-line;">@Kurz(v.Alt)</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Style="color:#6f5a86;">Neu (eigene Worte, Deutsch)</MudText>
                    <MudText Typo="Typo.body2" Style="color:#F0E6FF;white-space:pre-line;">@v.Neu</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
}

@code {
    private bool _busy, _geladen;
    private string _status = "";
    private TextBereinigungService.Art _art = TextBereinigungService.Art.BandBio;
    private IReadOnlyList<TextBereinigungService.Vorschlag> _vorschlaege = [];

    private static string Kurz(string s) => s.Length > 400 ? s[..400] + " …" : s;

    private async Task SammelnAsync()
    {
        _busy = true; _geladen = false; _vorschlaege = []; _status = "Formuliere Texte neu (LLM, kann etwas dauern) …";
        StateHasChanged();
        try
        {
            _vorschlaege = await Dienst.SammelnAsync(_art);
            _geladen = true;
            Snackbar.Add($"{_vorschlaege.Count} Vorschläge erzeugt.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Fehler: {ex.Message}", Severity.Error); }
        finally { _busy = false; StateHasChanged(); }
    }

    private async Task AnwendenAsync()
    {
        _busy = true; _status = "Speichere …"; StateHasChanged();
        try
        {
            var n = await Dienst.AnwendenAsync(_vorschlaege);
            _vorschlaege = [];
            Snackbar.Add($"{n} Texte übernommen.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Fehler: {ex.Message}", Severity.Error); }
        finally { _busy = false; StateHasChanged(); }
    }
}

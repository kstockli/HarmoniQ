@page "/admin/crawler"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Services.Crawler
@using HarmoniQ.Web.Components.Pages.Admin.Dialogs
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject CrawlLaufQueue Queue
@inject IDialogService DialogService
@inject WikipediaService Wiki
@inject ISnackbar Snackbar

<PageTitle>Crawler – Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="/admin"
               StartIcon="@Icons.Material.Filled.ArrowBack">Admin</MudButton>
    <MudText Typo="Typo.h4" Style="color:#D4AF37;">Crawler / Import-Roboter</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="/admin/crawler/funde"
               StartIcon="@Icons.Material.Filled.Inventory2">Funde-Review</MudButton>
    <MudButton Variant="Variant.Text" Style="color:#9B59B6;" StartIcon="@Icons.Material.Filled.AutoStories"
               OnClick="KomponistenAnreichern" Disabled="_anreicherungLaeuft">
        @(_anreicherungLaeuft ? "Lädt …" : "Wikipedia-Anreicherung")</MudButton>
    <MudButton Variant="Variant.Text" Style="color:#9B59B6;" StartIcon="@Icons.Material.Filled.Copyright"
               OnClick="BildQuellenNachtragen" Disabled="_anreicherungLaeuft">
        @(_anreicherungLaeuft ? "Lädt …" : "Bild-Quellen nachtragen")</MudButton>
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Style="color:#D4AF37;" OnClick="Laden" title="Aktualisieren" />
</MudStack>

<!-- Neue Quelle -->
<MudPaper Class="pa-4 mb-6" Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
    <MudText Typo="Typo.h6" Style="color:#D4AF37;" Class="mb-2">Neue Quelle</MudText>
    <MudGrid>
        <MudItem xs="12" md="3">
            <MudSelect T="CrawlQuelleTyp" @bind-Value="_neu.Typ" @bind-Value:after="TypGewechselt"
                       Label="Typ" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem Value="CrawlQuelleTyp.BandDomain">BandDomain (Vereinsseite)</MudSelectItem>
                <MudSelectItem Value="CrawlQuelleTyp.Dokument">Dokument / PDF</MudSelectItem>
                <MudSelectItem Value="CrawlQuelleTyp.Event">Event (JS – C2)</MudSelectItem>
                <MudSelectItem Value="CrawlQuelleTyp.Wettbewerb">Wettbewerb (SBBW)</MudSelectItem>
                <MudSelectItem Value="CrawlQuelleTyp.Veranstalter">Veranstalter (KKL Luzern)</MudSelectItem>
                <MudSelectItem Value="CrawlQuelleTyp.BandVideos">YouTube – alle Bands (Kanäle)</MudSelectItem>
                <MudSelectItem Value="CrawlQuelleTyp.BandKonzertVorschau">Künftige Konzerte – alle Band-Webseiten</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="_neu.StartUrl" Label="Start-URL / Dokument-Link" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudAutocomplete T="Band" Value="_neuBand" ValueChanged="b => _neuBand = b"
                             SearchFunc="BandSuche" ToStringFunc="@(b => b?.Name ?? "")"
                             Label="Ziel-Band (optional)" Variant="Variant.Outlined" Dense="true" Clearable="true" />
        </MudItem>
        @if (_neu.Typ == CrawlQuelleTyp.BandDomain)
        {
            <MudItem xs="6" md="3">
                <MudNumericField @bind-Value="_neu.MaxTiefe" Label="Max. Tiefe" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="5" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudNumericField @bind-Value="_neu.MaxSeiten" Label="Max. Seiten" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="1000" />
            </MudItem>
        }
        @if (_neu.Typ == CrawlQuelleTyp.Event)
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                    Event-Seiten werden automatisch per JS gerendert (für SPA/Wix). Erfordert
                    <code>Crawler:RenderingAktiv=true</code> – lokal aktiv, in Produktion siehe DEPLOY.md.
                </MudAlert>
            </MudItem>
        }
        @if (_neu.Typ == CrawlQuelleTyp.Wettbewerb)
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                    SBBW: Start-URL = Resultate-Übersicht (<code>https://swissbrass.ch/resultate-sbbw</code>, alle Jahre)
                    oder ein einzelnes Jahres-PDF (<code>…/results_2025.pdf</code>). Erzeugt je Jahr/Kategorie einen
                    Konzert-Fund mit Rangliste (Videos folgen). Keine Ziel-Band nötig.
                </MudAlert>
            </MudItem>
        }
        @if (_neu.Typ is CrawlQuelleTyp.BandVideos or CrawlQuelleTyp.BandKonzertVorschau)
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                    @(_neu.Typ == CrawlQuelleTyp.BandVideos
                        ? "Aggregat-Lauf über ALLE Bands mit hinterlegtem YouTube-Kanal: geht deren Uploads durch (nur Videos ≥ 2 Min), erkennt Stück/Komponist:in/Ort/Anlass und legt neue Treffer als Video-Funde an. Keine Start-URL/Ziel-Band nötig. Review im normalen „Funde-Review\" (Typ YouTube-Video)."
                        : "Aggregat-Lauf über ALLE Bands mit Webseite: sucht auf Startseite + Agenda/Kalender nach KÜNFTIGEN, echten Konzerten (Jahres-/Gala-/Kirchenkonzert usw.; keine Kilbi/Ständchen/Heim-Auftritte). Programm nicht erforderlich. Keine Start-URL/Ziel-Band nötig. Review unter „Funde\".")
                    Manuell ausgelöst mit Bestätigung; läuft im Hintergrund.
                </MudAlert>
            </MudItem>
        }
        @if (_neu.Typ == CrawlQuelleTyp.Veranstalter)
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                    KKL Luzern: URL + Stil-Hinweis sind vorbelegt. Die Eventliste wird gerendert, die Event-Daten
                    kommen aus der vivenu-API; nur Events, die zum Stil-Hinweis passen, werden als Konzert-Funde
                    angelegt (Konzertsaal = „Weisser Saal"). Nur zukünftige Events; erneute Läufe blenden bereits
                    Entschiedenes aus.
                </MudAlert>
            </MudItem>
        }
        <MudItem xs="12">
            <MudTextField @bind-Value="_neu.ExtraktionsHinweis" Variant="Variant.Outlined" Lines="2"
                          Label="Zusatz-Hinweis an die Extraktion (optional, wirkt auch als Filter)"
                          Placeholder="z. B. Nur Höchstklasse; nur Konzerte ab 2023; nur Land Schweiz; nur Harmonie-Besetzung" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudCheckBox T="bool" @bind-Value="_neu.KonzertBrauchtStueck" Dense="true" Color="Color.Secondary"
                         Label="Konzert nur mit mind. einem Stück" />
        </MudItem>
        <MudItem xs="6" md="4">
            <MudCheckBox T="bool" @bind-Value="_neu.Vorstand" Dense="true" Color="Color.Secondary"
                         Label="Vorstand mit erfassen" />
        </MudItem>
        <MudItem xs="6" md="4">
            <MudCheckBox T="bool" @bind-Value="_neu.Muko" Dense="true" Color="Color.Secondary"
                         Label="Musikkommission mit erfassen" />
        </MudItem>
    </MudGrid>
    <MudButton Class="mt-2" Variant="Variant.Filled" Style="background:#D4AF37; color:#0e0018;"
               StartIcon="@Icons.Material.Filled.Add" OnClick="QuelleAnlegen">Quelle anlegen</MudButton>
</MudPaper>

<!-- Läufe (oben: man will den Fortschritt sehen und aktualisieren) -->
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h6" Style="color:#D4AF37;">Letzte Läufe</MudText>
    <MudSpacer />
    <MudCheckBox T="bool" @bind-Value="_nurLaeufeMitFunden" Dense="true" Color="Color.Secondary"
                 Label="Nur mit offenen Funden" />
</MudStack>
@if (!LaeufeGefiltert.Any())
{
    <MudAlert Severity="Severity.Info" Class="mb-6">
        @(_laeufe.Count == 0 ? "Noch keine Läufe." : "Keine Läufe mit offenen Funden.")
    </MudAlert>
}
else
{
    <MudSimpleTable Dense="true" Hover="true" Class="mb-6" Style="background:#1a0030;">
        <thead>
            <tr><th>Start</th><th>Quelle</th><th>Status</th><th>Seiten</th><th>Offene Funde</th><th>Meldung</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var l in LaeufeGefiltert)
            {
                <tr>
                    <td style="white-space:nowrap;">@l.StartAm.ToLocalTime().ToString("dd.MM HH:mm")</td>
                    <td style="max-width:260px;overflow:hidden;text-overflow:ellipsis;">@l.QuelleUrl</td>
                    <td><MudChip T="string" Size="Size.Small" Color="@StatusFarbe(l.Status)">@l.Status</MudChip></td>
                    <td>@l.SeitenBesucht</td>
                    <td>@l.OffeneFunde</td>
                    <td style="max-width:240px;overflow:hidden;text-overflow:ellipsis;color:#A78FC0;">@l.Meldung</td>
                    <td style="white-space:nowrap;">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Style="color:#D4AF37;border-color:#3a1060;"
                                   Href="@($"/admin/crawler/funde?lauf={l.Id}")">Funde</MudButton>
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                       title="Lauf löschen" OnClick="@(() => LaufLoeschen(l.Id))" />
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

<!-- Quellen -->
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h6" Style="color:#D4AF37;">Quellen</MudText>
    <MudSpacer />
    <MudCheckBox T="bool" @bind-Value="_nurQuellenOhneLaeufe" Dense="true" Color="Color.Secondary"
                 Label="Nur ohne Läufe" />
    @if (_quellen.Any(q => !q.Aktiv))
    {
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                   OnClick="VorschlaegeLoeschen">Alle Vorschläge löschen</MudButton>
    }
</MudStack>
@if (!QuellenGefiltert.Any())
{
    <MudAlert Severity="Severity.Info" Class="mb-6">
        @(_quellen.Count == 0 ? "Noch keine Quellen erfasst." : "Keine Quellen ohne Läufe.")
    </MudAlert>
}
else
{
    <MudStack Spacing="3" Class="mb-6">
        @foreach (var q in QuellenGefiltert)
        {
            <MudPaper Class="pa-3" Elevation="3" Style="background:#1a0030; border:1px solid #3a1060;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1" Wrap="Wrap.Wrap">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@q.Typ</MudChip>
                    @if (!q.Aktiv)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Vorschlag</MudChip>
                    }
                    <a href="@q.StartUrl" target="_blank"
                       style="color:#9B59B6;max-width:460px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@q.StartUrl</a>
                    @if (q.Band != null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@q.Band.Name</MudChip>
                    }
                    @if (q.Typ == CrawlQuelleTyp.BandDomain)
                    {
                        <MudText Typo="Typo.caption" Style="color:#A78FC0;">Tiefe @q.MaxTiefe / @q.MaxSeiten Seiten</MudText>
                    }
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Style="color:#6f5a86;">
                        angelegt @AuditFormat.Zeit(q.CreateTime)@AuditFormat.Wer(q.CreateUser) · letzter Lauf: @(q.LetzterLaufAm?.ToLocalTime().ToString("dd.MM.yy HH:mm") ?? "nie")
                    </MudText>
                </MudStack>
                <MudTextField @bind-Value="q.ExtraktionsHinweis" Variant="Variant.Outlined" Lines="2" Margin="Margin.Dense"
                              Label="Zusatz-Hinweis an die Extraktion (vor dem Lauf editierbar, wirkt als Filter)"
                              Placeholder="z. B. Nur Höchstklasse; nur Konzerte ab 2023; nur Land Schweiz" />
                <MudStack Row="true" Wrap="Wrap.Wrap" Class="mt-1">
                    <MudCheckBox T="bool" Dense="true" Color="Color.Secondary"
                                 Value="q.Anforderungen.HasFlag(CrawlAnforderungen.KonzertBrauchtStueck)"
                                 ValueChanged="@(v => SetzeAnforderung(q, CrawlAnforderungen.KonzertBrauchtStueck, v))"
                                 Label="Konzert nur mit mind. einem Stück" />
                    <MudCheckBox T="bool" Dense="true" Color="Color.Secondary"
                                 Value="q.Anforderungen.HasFlag(CrawlAnforderungen.VorstandCrawlen)"
                                 ValueChanged="@(v => SetzeAnforderung(q, CrawlAnforderungen.VorstandCrawlen, v))"
                                 Label="Vorstand" />
                    <MudCheckBox T="bool" Dense="true" Color="Color.Secondary"
                                 Value="q.Anforderungen.HasFlag(CrawlAnforderungen.MukoCrawlen)"
                                 ValueChanged="@(v => SetzeAnforderung(q, CrawlAnforderungen.MukoCrawlen, v))"
                                 Label="Muko" />
                </MudStack>
                <MudStack Row="true" Class="mt-2" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="@(() => LaufStarten(q))">Lauf starten</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Style="color:#9B59B6;"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="@(() => HinweisSpeichern(q))">Hinweis speichern</MudButton>
                    @if (!q.Aktiv)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                   OnClick="@(() => AktivSetzen(q, true))">Aktivieren</MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Style="color:#A78FC0;"
                                   StartIcon="@Icons.Material.Filled.PauseCircle"
                                   OnClick="@(() => AktivSetzen(q, false))">Deaktivieren</MudButton>
                    }
                    <MudSpacer />
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="@(() => QuelleLoeschen(q))">Löschen</MudButton>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}

@code {
    private List<CrawlQuelle> _quellen = [];
    private List<LaufZeile> _laeufe = [];
    private NeueQuelle _neu = new();
    private Band? _neuBand;
    private bool _nurLaeufeMitFunden;
    private bool _nurQuellenOhneLaeufe;

    // Filter: Läufe mit offenen Funden / Quellen, die noch nie liefen (LetzterLaufAm == null).
    private IEnumerable<LaufZeile> LaeufeGefiltert =>
        _nurLaeufeMitFunden ? _laeufe.Where(l => l.OffeneFunde > 0) : _laeufe;
    private IEnumerable<CrawlQuelle> QuellenGefiltert =>
        _nurQuellenOhneLaeufe ? _quellen.Where(q => q.LetzterLaufAm == null) : _quellen;

    protected override async Task OnInitializedAsync() => await Laden();

    private async Task Laden()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _quellen = await db.CrawlQuellen.Include(q => q.Band)
            .OrderByDescending(q => q.Aktiv).ThenByDescending(q => q.ErstelltAm).ToListAsync();
        var rohe = await db.CrawlLaeufe
            .OrderByDescending(l => l.StartAm).Take(40)
            .Select(l => new { l.Id, Url = l.Quelle.StartUrl, l.Status, l.SeitenBesucht, l.StartAm, l.Meldung })
            .ToListAsync();
        var laufIds = rohe.Select(r => r.Id).ToList();
        // Anzahl = nur OFFENE Funde je Lauf (übernommene/verworfene zählen nicht mehr mit).
        var offenProLauf = (await db.CrawlFunde
                .Where(f => f.LaufId != null && laufIds.Contains(f.LaufId.Value) && f.Status == CrawlFundStatus.Offen)
                .GroupBy(f => f.LaufId!.Value)
                .Select(g => new { LaufId = g.Key, Anzahl = g.Count() })
                .ToListAsync())
            .ToDictionary(x => x.LaufId, x => x.Anzahl);
        _laeufe = rohe.Select(l => new LaufZeile(l.Id, l.Url, l.Status, l.SeitenBesucht,
            offenProLauf.GetValueOrDefault(l.Id), l.StartAm, l.Meldung)).ToList();
    }

    /// <summary>Aggregat-Typen fächern über ALLE Bands auf (keine einzelne Start-URL/Ziel-Band).</summary>
    private static bool IstAggregat(CrawlQuelleTyp t) =>
        t is CrawlQuelleTyp.BandVideos or CrawlQuelleTyp.BandKonzertVorschau;

    private static string AggregatUrl(CrawlQuelleTyp t) => t == CrawlQuelleTyp.BandVideos
        ? "alle-bands://youtube-kanaele" : "alle-bands://konzert-vorschau";

    /// <summary>Belegt bei Spezial-Quelltypen sinnvolle Defaults vor (nur wenn Feld noch leer).</summary>
    private void TypGewechselt()
    {
        if (_neu.Typ == CrawlQuelleTyp.Veranstalter)
        {
            if (string.IsNullOrWhiteSpace(_neu.StartUrl)) _neu.StartUrl = KklImporter.EventsUrl;
            if (string.IsNullOrWhiteSpace(_neu.ExtraktionsHinweis)) _neu.ExtraktionsHinweis = "Blasmusik / Brassband";
        }
        else if (_neu.Typ == CrawlQuelleTyp.Wettbewerb)
        {
            if (string.IsNullOrWhiteSpace(_neu.StartUrl)) _neu.StartUrl = "https://swissbrass.ch/resultate-sbbw";
        }
        else if (IstAggregat(_neu.Typ))
        {
            _neu.StartUrl = AggregatUrl(_neu.Typ);
        }
    }

    private async Task<IEnumerable<Band>> BandSuche(string? wert, CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.Bands.AsQueryable();
        if (!string.IsNullOrWhiteSpace(wert))
            q = q.Where(b => b.Name.Contains(wert));
        return await q.OrderBy(b => b.Name).Take(20).ToListAsync(ct);
    }

    private async Task QuelleAnlegen()
    {
        // Aggregat-Typen (über alle Bands) brauchen keine echte Start-URL – Marker setzen und Validierung überspringen.
        if (IstAggregat(_neu.Typ)) _neu.StartUrl = AggregatUrl(_neu.Typ);
        Uri? uri = null;
        if (!IstAggregat(_neu.Typ)
            && (string.IsNullOrWhiteSpace(_neu.StartUrl) || !Uri.TryCreate(_neu.StartUrl.Trim(), UriKind.Absolute, out uri)))
        {
            Snackbar.Add("Bitte eine gültige Start-URL (http/https) angeben.", Severity.Warning);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        db.CrawlQuellen.Add(new CrawlQuelle
        {
            Typ = _neu.Typ,
            StartUrl = _neu.StartUrl.Trim(),
            Domain = _neu.Typ == CrawlQuelleTyp.BandDomain ? uri!.Host : null,
            BandId = _neuBand?.Id,
            BrauchtRendering = _neu.BrauchtRendering,
            MaxTiefe = _neu.MaxTiefe,
            MaxSeiten = _neu.MaxSeiten,
            ExtraktionsHinweis = string.IsNullOrWhiteSpace(_neu.ExtraktionsHinweis) ? null : _neu.ExtraktionsHinweis.Trim(),
            Anforderungen =
                (_neu.KonzertBrauchtStueck ? CrawlAnforderungen.KonzertBrauchtStueck : 0)
                | (_neu.Vorstand ? CrawlAnforderungen.VorstandCrawlen : 0)
                | (_neu.Muko ? CrawlAnforderungen.MukoCrawlen : 0)
        });
        await db.SaveChangesAsync();
        Snackbar.Add("Quelle angelegt.", Severity.Success);
        _neu = new();
        _neuBand = null;
        await Laden();
    }

    private async Task SpeichereHinweis(Guid id, string? hinweis)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.CrawlQuellen.FindAsync(id);
        if (e != null)
        {
            e.ExtraktionsHinweis = string.IsNullOrWhiteSpace(hinweis) ? null : hinweis.Trim();
            await db.SaveChangesAsync();
        }
    }

    private async Task HinweisSpeichern(CrawlQuelle q)
    {
        await SpeichereHinweis(q.Id, q.ExtraktionsHinweis);
        Snackbar.Add("Hinweis gespeichert.", Severity.Success);
    }

    private async Task SetzeAnforderung(CrawlQuelle q, CrawlAnforderungen flag, bool an)
    {
        if (an) q.Anforderungen |= flag; else q.Anforderungen &= ~flag;
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.CrawlQuellen.FindAsync(q.Id);
        if (e != null) { e.Anforderungen = q.Anforderungen; await db.SaveChangesAsync(); }
        Snackbar.Add("Anforderung gespeichert.", Severity.Success);
    }

    private async Task LaufStarten(CrawlQuelle q)
    {
        // Aggregat-Läufe (über alle Bands) sind aufwändig → Bestätigung einholen.
        if (IstAggregat(q.Typ))
        {
            var text = q.Typ == CrawlQuelleTyp.BandVideos
                ? "YouTube-Lauf über ALLE Bands mit hinterlegtem Kanal starten? Das prüft je Band die neuesten Uploads (verbraucht YouTube-Kontingent) und legt neue Video-Funde an."
                : "Konzert-Vorschau-Lauf über ALLE Bands mit Webseite starten? Das lädt je Band Startseite + Agenda-Seiten und legt künftige Konzert-Funde an.";
            var p = new DialogParameters<ConfirmDialog>
            {
                { x => x.Text, text },
                { x => x.ConfirmText, "Starten" },
                { x => x.ConfirmColor, Color.Success }
            };
            var dlg = await DialogService.ShowAsync<ConfirmDialog>("Aggregat-Lauf starten", p);
            var r = await dlg.Result;
            if (r is null || r.Canceled) return;
        }

        await SpeichereHinweis(q.Id, q.ExtraktionsHinweis); // aktuell editierten Hinweis übernehmen
        Guid laufId;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var lauf = new CrawlLauf { QuelleId = q.Id, Status = CrawlLaufStatus.Laufend };
            db.CrawlLaeufe.Add(lauf);
            await db.SaveChangesAsync();
            laufId = lauf.Id;
        }
        Queue.Einreihen(laufId);
        Snackbar.Add("Lauf gestartet (läuft im Hintergrund – mit „Aktualisieren\" beobachten).", Severity.Success);
        await Laden();
    }

    private async Task AktivSetzen(CrawlQuelle q, bool aktiv)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.CrawlQuellen.FindAsync(q.Id);
        if (e != null) { e.Aktiv = aktiv; await db.SaveChangesAsync(); }
        Snackbar.Add(aktiv ? "Quelle aktiviert." : "Quelle deaktiviert.", Severity.Success);
        await Laden();
    }

    private bool _anreicherungLaeuft;

    private async Task KomponistenAnreichern()
    {
        _anreicherungLaeuft = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Komponist:innen ohne Biografie, die noch keinen offenen Komponist-Fund haben.
            var offeneNamen = (await db.CrawlFunde
                    .Where(f => f.Status == CrawlFundStatus.Offen && f.Typ == CrawlFundTyp.Komponist)
                    .Select(f => f.DatenJson).ToListAsync())
                .Select(j => CrawlDaten.Deserialisiere<KomponistFundDaten>(j)?.Name)
                .Where(n => n != null).Select(n => n!)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var komponisten = (await db.Personen
                    .Where(p => p.Rollen.Any(r => r.Rolle == PersonRolleTyp.Komponist)
                                && (p.Biografie == null || p.Biografie == ""))
                    .OrderBy(p => p.Name).Take(50).ToListAsync())
                .Where(p => !offeneNamen.Contains(p.Name)).ToList();

            if (komponisten.Count == 0)
            {
                Snackbar.Add("Keine Komponist:innen ohne Biografie offen (oder bereits als Vorschlag).", Severity.Info);
                return;
            }

            var drossel = new SemaphoreSlim(5);
            var treffer = await Task.WhenAll(komponisten.Select(async p =>
            {
                await drossel.WaitAsync();
                try { return (Person: p, Erg: await Wiki.AnreichernAsync(p.Name)); }
                finally { drossel.Release(); }
            }));

            var neu = 0;
            foreach (var (p, e) in treffer)
            {
                if (e is null) continue;
                var daten = new KomponistFundDaten(p.Name, e.Biografie, e.BildUrl, e.Geburtsjahr, e.Url, null, e.BildAttribution);
                db.CrawlFunde.Add(new CrawlFund
                {
                    Typ = CrawlFundTyp.Komponist,
                    QuellUrl = e.Url ?? "https://de.wikipedia.org",
                    DatenJson = CrawlDaten.Serialisiere(daten),
                    DublettHinweis = $"Wikipedia-Anreicherung für bestehende Person \"{p.Name}\"",
                    Konfidenz = Konfidenz.Mittel,
                    Status = CrawlFundStatus.Offen
                });
                neu++;
            }
            await db.SaveChangesAsync();
            Snackbar.Add($"{neu} Wikipedia-Vorschläge erstellt (von {komponisten.Count} geprüft) → Funde, Typ \"Komponist\".",
                neu > 0 ? Severity.Success : Severity.Info);
        }
        finally { _anreicherungLaeuft = false; }
    }

    /// <summary>Trägt für bereits importierte Wikimedia-Commons-Bilder (Personen) die fehlende Urheber-/
    /// Lizenzangabe nach (Urheberrecht) – holt sie von der Commons-API und speichert sie direkt.</summary>
    private async Task BildQuellenNachtragen()
    {
        _anreicherungLaeuft = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var offen = await db.Personen
                .Where(p => p.BildUrl != null && p.BildAttribution == null
                            && (p.BildUrl.Contains("wikimedia") || p.BildUrl.Contains("wikipedia")))
                .ToListAsync();
            if (offen.Count == 0) { Snackbar.Add("Keine Bilder ohne Quellenangabe gefunden.", Severity.Info); return; }

            var drossel = new SemaphoreSlim(5);
            var attrs = await Task.WhenAll(offen.Select(async p =>
            {
                await drossel.WaitAsync();
                try { return (p, Attr: await Wiki.BildAttributionAsync(p.BildUrl!)); }
                finally { drossel.Release(); }
            }));
            var n = 0;
            foreach (var (p, attr) in attrs)
                if (!string.IsNullOrWhiteSpace(attr)) { p.BildAttribution = attr; n++; }
            await db.SaveChangesAsync();
            Snackbar.Add($"{n} Bild-Quellen nachgetragen (von {offen.Count} geprüft).",
                n > 0 ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex) { Snackbar.Add($"Fehler: {ex.Message}", Severity.Error); }
        finally { _anreicherungLaeuft = false; }
    }

    private async Task VorschlaegeLoeschen()
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Text, "Alle inaktiven Quellen (Vorschläge) inkl. ihrer Läufe/Funde löschen?" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Vorschläge löschen", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var n = await db.CrawlQuellen.Where(q => !q.Aktiv).ExecuteDeleteAsync();
        Snackbar.Add($"{n} Vorschläge gelöscht.", Severity.Success);
        await Laden();
    }

    private async Task LaufLoeschen(Guid id)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Text, "Diesen Lauf inkl. seiner Funde löschen? (Bereits übernommene Daten bleiben erhalten.)" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Lauf löschen", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var l = await db.CrawlLaeufe.FindAsync(id);
        if (l != null) { db.CrawlLaeufe.Remove(l); await db.SaveChangesAsync(); }
        Snackbar.Add("Lauf gelöscht.", Severity.Info);
        await Laden();
    }

    private async Task QuelleLoeschen(CrawlQuelle q)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Text, $"Quelle \"{q.StartUrl}\" inkl. ihrer Läufe und Funde löschen?" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Löschen bestätigen", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.CrawlQuellen.FindAsync(q.Id);
        if (e != null) { db.CrawlQuellen.Remove(e); await db.SaveChangesAsync(); }
        Snackbar.Add("Quelle gelöscht.", Severity.Info);
        await Laden();
    }

    private static Color StatusFarbe(CrawlLaufStatus s) => s switch
    {
        CrawlLaufStatus.Laufend => Color.Info,
        CrawlLaufStatus.Fertig => Color.Success,
        CrawlLaufStatus.Fehler => Color.Error,
        _ => Color.Default
    };

    private class NeueQuelle
    {
        public CrawlQuelleTyp Typ { get; set; } = CrawlQuelleTyp.BandDomain;
        public string StartUrl { get; set; } = "";
        public bool BrauchtRendering { get; set; }
        public int MaxTiefe { get; set; } = 2;
        public int MaxSeiten { get; set; } = 100;
        public string? ExtraktionsHinweis { get; set; }
        public bool KonzertBrauchtStueck { get; set; }
        public bool Vorstand { get; set; }
        public bool Muko { get; set; }
    }

    private record LaufZeile(Guid Id, string QuelleUrl, CrawlLaufStatus Status, int SeitenBesucht,
        int OffeneFunde, DateTime StartAm, string? Meldung);
}

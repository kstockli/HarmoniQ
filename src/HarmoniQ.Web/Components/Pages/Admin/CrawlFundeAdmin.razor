@page "/admin/crawler/funde"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Services.Crawler
@using HarmoniQ.Web.Components.Pages.Admin.Dialogs
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Crawler-Funde – Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="/admin/crawler"
               StartIcon="@Icons.Material.Filled.ArrowBack">Crawler</MudButton>
    <MudText Typo="Typo.h4" Style="color:#D4AF37;">Funde-Review</MudText>
    <MudSpacer />
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Style="color:#D4AF37;" OnClick="Laden" title="Aktualisieren" />
</MudStack>

<MudStack Row="true" Class="mb-4" Spacing="3" AlignItems="AlignItems.Center">
    <MudSelect T="CrawlFundStatus?" @bind-Value="_status" Label="Status" Dense="true" Variant="Variant.Outlined" Style="max-width:180px;" Clearable="true">
        <MudSelectItem T="CrawlFundStatus?" Value="@(CrawlFundStatus.Offen)">Offen</MudSelectItem>
        <MudSelectItem T="CrawlFundStatus?" Value="@(CrawlFundStatus.Uebernommen)">Übernommen</MudSelectItem>
        <MudSelectItem T="CrawlFundStatus?" Value="@(CrawlFundStatus.Verworfen)">Verworfen</MudSelectItem>
    </MudSelect>
    <MudSelect T="CrawlFundTyp?" @bind-Value="_typ" Label="Typ" Dense="true" Variant="Variant.Outlined" Style="max-width:180px;" Clearable="true">
        <MudSelectItem T="CrawlFundTyp?" Value="@(CrawlFundTyp.Konzert)">Konzert</MudSelectItem>
        <MudSelectItem T="CrawlFundTyp?" Value="@(CrawlFundTyp.Leitung)">Leitung</MudSelectItem>
        <MudSelectItem T="CrawlFundTyp?" Value="@(CrawlFundTyp.Stueck)">Stück</MudSelectItem>
        <MudSelectItem T="CrawlFundTyp?" Value="@(CrawlFundTyp.Komponist)">Komponist</MudSelectItem>
        <MudSelectItem T="CrawlFundTyp?" Value="@(CrawlFundTyp.Band)">Verein/Band</MudSelectItem>
        <MudSelectItem T="CrawlFundTyp?" Value="@(CrawlFundTyp.Webseite)">Webseiten-Vorschlag</MudSelectItem>
        <MudSelectItem T="CrawlFundTyp?" Value="@(CrawlFundTyp.Sonstiges)">Sonstiges</MudSelectItem>
    </MudSelect>
    <MudTextField @bind-Value="_suche" Label="Suche (Name/Ort/URL …)" Variant="Variant.Outlined"
                  Margin="Margin.Dense" Clearable="true" Style="max-width:240px;"
                  Immediate="false" OnKeyDown="@(e => { if (e.Key == "Enter") _ = Laden(); })" />
    <MudButton Variant="Variant.Outlined" Style="color:#9B59B6;border-color:#3a1060;" OnClick="Laden">Filtern</MudButton>
    @if (_laufId is not null)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Info" OnClose="@(() => { _laufId = null; _ = Laden(); })">
            nur Lauf @_laufId.Value.ToString()[..8]
        </MudChip>
    }
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.LibraryAddCheck" OnClick="AlleUebernehmen">Alle angezeigten übernehmen</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.DoneAll" OnClick="AlleVerwerfen">Alle offenen verwerfen</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="AlleLoeschen">Alle angezeigten löschen</MudButton>
</MudStack>

@if (_funde.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        Keine Funde für diesen Filter. Ohne konfigurierten LLM-Anbieter werden noch keine Funde
        automatisch erzeugt – die Extraktion folgt mit der Mistral-Anbindung (C3).
    </MudAlert>
}
else
{
    <MudStack Spacing="3">
        @foreach (var f in _funde)
        {
            <MudPaper Class="pa-3" Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@f.Typ</MudChip>
                    @if (f.Konfidenz is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">Konfidenz: @f.Konfidenz</MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Color="@(f.Status == CrawlFundStatus.Offen ? Color.Warning : f.Status == CrawlFundStatus.Uebernommen ? Color.Success : Color.Default)">@f.Status</MudChip>
                    <MudSpacer />
                    <MudLink Href="@f.QuellUrl" Target="_blank" Style="color:#9B59B6;">Quelle ↗</MudLink>
                </MudStack>

                <MudText Typo="Typo.caption" Class="d-block mb-1" Style="color:#6f5a86;">
                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Style="vertical-align:middle;font-size:1rem;" />
                    Gecrawlt @AuditFormat.Zeit(f.Gecrawlt)
                    @if (f.Status != CrawlFundStatus.Offen && f.Geaendert is not null)
                    {
                        <text> · @(f.Status == CrawlFundStatus.Uebernommen ? "übernommen" : "bearbeitet") @AuditFormat.Zeit(f.Geaendert)@AuditFormat.Wer(f.Bearbeiter)</text>
                    }
                </MudText>

                @if (!string.IsNullOrWhiteSpace(f.DublettHinweis))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@f.DublettHinweis</MudAlert>
                }

                @if (!f.JsonGueltig)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">
                        JSON ungültig – Übernahme nicht möglich. @f.JsonFehler
                    </MudAlert>
                }

                <!-- Benutzerfreundliche Zusammenfassung (aus dem aktuellen JSON berechnet) -->
                @if (!string.IsNullOrWhiteSpace(f.FriendlyBand))
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.Groups" Style="color:#D4AF37;font-size:1.5rem;" />
                        <MudText Typo="Typo.h6" Style="color:#D4AF37;font-weight:700;line-height:1.2;font-size:1.25rem;">@f.FriendlyBand</MudText>
                    </MudStack>
                }
                <MudText Typo="Typo.subtitle1" Style="color:#F0E6FF;">@f.FriendlyTitel</MudText>
                @if (!string.IsNullOrWhiteSpace(f.FriendlySub))
                {
                    <MudText Typo="Typo.body2" Style="color:#A78FC0;">@f.FriendlySub</MudText>
                }
                @if (f.FriendlyZeilen.Count > 0)
                {
                    <div class="mt-1">
                        @foreach (var z in f.FriendlyZeilen)
                        {
                            <MudText Typo="Typo.body2" Style="color:#C4B0D8;">• @z</MudText>
                        }
                    </div>
                }

                <MudStack Row="true" Class="mt-2">
                    @if (f.Status == CrawlFundStatus.Offen)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Check" Disabled="@(!f.JsonGueltig)"
                                   OnClick="@(() => Uebernehmen(f))">Übernehmen</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Close" OnClick="@(() => Verwerfen(f))">Verwerfen</MudButton>
                    }
                    else
                    {
                        @* Reaktivieren: verworfene ODER bereits übernommene Funde erneut übernehmen
                           (z. B. wenn das Ziel im CRUD-Fenster gelöscht wurde) bzw. wieder öffnen. *@
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Replay" Disabled="@(!f.JsonGueltig)"
                                   OnClick="@(() => Uebernehmen(f))">
                            @(f.Status == CrawlFundStatus.Verworfen ? "Doch übernehmen" : "Erneut übernehmen")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Style="color:#9B59B6;border-color:#3a1060;"
                                   StartIcon="@Icons.Material.Filled.LockOpen" OnClick="@(() => WiederOeffnen(f))">Wieder öffnen</MudButton>
                    }
                </MudStack>

                <!-- Rohdaten nur bei Bedarf einblendbar/editierbar -->
                <MudExpansionPanels Elevation="0" Class="mt-2">
                    <MudExpansionPanel Text="JSON anzeigen / bearbeiten" Style="background:#12001f;">
                        <MudTextField @bind-Value="f.Json" @bind-Value:after="@(() => BefuelleAnzeige(f))"
                                      Variant="Variant.Outlined" Lines="6"
                                      Style="font-family:monospace;font-size:0.8rem;"
                                      HelperText="Änderungen werden in die Vorschau übernommen (Feld verlassen oder Button unten). Beim Übernehmen gelten genau diese Daten." />
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2" Spacing="2">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Style="color:#9B59B6;border-color:#3a1060;"
                                       StartIcon="@Icons.Material.Filled.Calculate" OnClick="@(() => Neuberechnen(f))">
                                Vorschau neu berechnen
                            </MudButton>
                            @if (f.JsonGueltig)
                            {
                                <MudText Typo="Typo.caption" Style="color:#4caf50;">✓ JSON gültig</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Style="color:#f44336;">✗ JSON ungültig</MudText>
                            }
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudPaper>
        }
    </MudStack>
}

@code {
    [SupplyParameterFromQuery(Name = "lauf")] public Guid? _laufId { get; set; }

    private CrawlFundStatus? _status = CrawlFundStatus.Offen;
    private CrawlFundTyp? _typ;
    private string? _suche;
    private List<FundEdit> _funde = [];

    protected override async Task OnInitializedAsync() => await Laden();

    private async Task Laden()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.CrawlFunde.AsQueryable();
        if (_laufId is not null) q = q.Where(f => f.LaufId == _laufId);
        if (_status is not null) q = q.Where(f => f.Status == _status);
        if (_typ is not null) q = q.Where(f => f.Typ == _typ);
        if (!string.IsNullOrWhiteSpace(_suche))
        {
            var s = $"%{_suche.Trim()}%";
            q = q.Where(f => EF.Functions.ILike(f.DatenJson, s) || EF.Functions.ILike(f.QuellUrl, s));
        }

        _funde = await q.OrderByDescending(f => f.AbgerufenAm).Take(200)
            .Select(f => new FundEdit
            {
                Id = f.Id, Typ = f.Typ, QuellUrl = f.QuellUrl, Konfidenz = f.Konfidenz,
                DublettHinweis = f.DublettHinweis, Json = f.DatenJson, Status = f.Status,
                Gecrawlt = f.AbgerufenAm, Geaendert = f.ModifyTime, Bearbeiter = f.ModifyUser
            })
            .ToListAsync();

        foreach (var fe in _funde) BefuelleAnzeige(fe);
    }

    /// <summary>Berechnet die Vorschau aus dem (ggf. von Hand geänderten) JSON neu und meldet das Ergebnis.</summary>
    private void Neuberechnen(FundEdit fe)
    {
        BefuelleAnzeige(fe);
        StateHasChanged();
        Snackbar.Add(fe.JsonGueltig ? "Vorschau aktualisiert." : "JSON ungültig – siehe Meldung beim Fund.",
            fe.JsonGueltig ? Severity.Success : Severity.Error);
    }

    /// <summary>Bereitet aus dem DatenJson eine lesbare Zusammenfassung je Fund-Typ auf und setzt
    /// <see cref="FundEdit.JsonGueltig"/>/<see cref="FundEdit.JsonFehler"/> (klare Meldung bei kaputtem JSON).</summary>
    private static void BefuelleAnzeige(FundEdit fe)
    {
        // Zurücksetzen, damit eine erneute Berechnung keine alten Werte stehen lässt.
        fe.FriendlyTitel = "";
        fe.FriendlyBand = null;
        fe.FriendlySub = null;
        fe.FriendlyZeilen = [];
        fe.JsonGueltig = true;
        fe.JsonFehler = null;
        try
        {
            switch (fe.Typ)
            {
                case CrawlFundTyp.Leitung:
                    var l = CrawlDaten.Deserialisiere<LeitungFundDaten>(fe.Json);
                    if (l != null)
                    {
                        fe.FriendlyTitel = $"Dirigent:in: {l.PersonName}";
                        var t = new List<string>();
                        if (!string.IsNullOrWhiteSpace(l.Funktion) && l.Funktion != "Dirigent") t.Add(l.Funktion!);
                        if (!string.IsNullOrWhiteSpace(l.BandName)) t.Add(l.BandName!);
                        var z = Zeitraum(l.VonJahr, l.BisJahr);
                        if (z != null) t.Add(z);
                        fe.FriendlySub = string.Join(" · ", t);
                    }
                    break;
                case CrawlFundTyp.Konzert:
                    var k = CrawlDaten.Deserialisiere<KonzertFundDaten>(fe.Json);
                    if (k != null)
                    {
                        fe.FriendlyTitel = "Konzert" + (string.IsNullOrWhiteSpace(k.Name) ? "" : $": {k.Name}");
                        // Auftretende Band(s) aus den Rang-Zeilen – groß hervorgehoben angezeigt.
                        var bands = (k.Raenge ?? [])
                            .Select(r => r.Band).Where(b => !string.IsNullOrWhiteSpace(b)).Distinct().ToList();
                        fe.FriendlyBand = bands.Count is > 0 and <= 3 ? string.Join(", ", bands) : null;
                        var t = new List<string>();
                        t.Add(k.Datum is { } d ? KonzertZeitFormat.Kompakt(d, k.Uhrzeit) : "Datum fehlt");
                        if (!string.IsNullOrWhiteSpace(k.Ort)) t.Add(k.Ort!);
                        t.Add($"{(k.Programm?.Count ?? 0)} Stück(e)");
                        fe.FriendlySub = string.Join(" · ", t);
                        fe.FriendlyZeilen = (k.Programm ?? [])
                            .OrderBy(p => p.Reihenfolge ?? int.MaxValue)
                            .Select(ProgrammText).ToList();
                        // Bei vielen Bands (Wettbewerb) statt der großen Zeile eine kompakte Auflistung.
                        if (bands.Count > 3) fe.FriendlyZeilen = fe.FriendlyZeilen.Prepend("Bands: " + string.Join(", ", bands)).ToList();
                    }
                    break;
                case CrawlFundTyp.Stueck:
                    var s = CrawlDaten.Deserialisiere<StueckFundDaten>(fe.Json);
                    if (s != null)
                    {
                        fe.FriendlyTitel = $"Stück: {s.Titel}";
                        var t = new List<string>();
                        if (!string.IsNullOrWhiteSpace(s.KomponistName)) t.Add($"Komponist:in: {s.KomponistName}");
                        if (s.Jahr is { } j) t.Add(j.ToString());
                        fe.FriendlySub = string.Join(" · ", t);
                    }
                    break;
                case CrawlFundTyp.Komponist:
                    var c = CrawlDaten.Deserialisiere<KomponistFundDaten>(fe.Json);
                    if (c != null)
                    {
                        fe.FriendlyTitel = $"Komponist:in: {c.Name}";
                        if (c.Geburtsjahr is { } g) fe.FriendlySub = $"* {g}";
                        if (!string.IsNullOrWhiteSpace(c.Biografie)) fe.FriendlyZeilen = [c.Biografie!];
                    }
                    break;
                case CrawlFundTyp.Band:
                    var b = CrawlDaten.Deserialisiere<BandFundDaten>(fe.Json);
                    if (b != null)
                    {
                        fe.FriendlyTitel = $"Verein: {b.Name}";
                        var t = new List<string>();
                        if (b.Kategorie is { } kat) t.Add(kat.ToString());
                        if (b.Staerkeklasse is { } sk) t.Add(sk.ToString());
                        if (b.Gruendungsjahr is { } gj) t.Add($"gegr. {gj}");
                        if (!string.IsNullOrWhiteSpace(b.Land)) t.Add(b.Land!);
                        fe.FriendlySub = string.Join(" · ", t);
                        var z = new List<string>();
                        if (!string.IsNullOrWhiteSpace(b.Webseite)) z.Add($"Web: {b.Webseite}");
                        if (b.Aliase is { Count: > 0 }) z.Add("auch: " + string.Join(", ", b.Aliase));
                        if (!string.IsNullOrWhiteSpace(b.Geschichte))
                            z.Add(b.Geschichte!.Length > 200 ? b.Geschichte![..200] + "…" : b.Geschichte!);
                        fe.FriendlyZeilen = z;
                    }
                    break;
                case CrawlFundTyp.Webseite:
                    var w = CrawlDaten.Deserialisiere<WebseiteFundDaten>(fe.Json);
                    if (w != null)
                    {
                        fe.FriendlyTitel = $"Webseite: {w.VereinName ?? w.Url}";
                        fe.FriendlySub = string.Join(" · ",
                            new[] { w.Kategorie, w.Titel }.Where(x => !string.IsNullOrWhiteSpace(x)));
                        var z = new List<string>();
                        if (!string.IsNullOrWhiteSpace(w.Beschreibung))
                            z.Add(w.Beschreibung!.Length > 200 ? w.Beschreibung![..200] + "…" : w.Beschreibung!);
                        z.Add(w.Url);
                        fe.FriendlyZeilen = z;
                    }
                    break;
            }
        }
        catch (JsonException jx)
        {
            fe.JsonGueltig = false;
            fe.JsonFehler = "Ungültiges JSON: " + jx.Message;
        }
        catch (Exception ex)
        {
            fe.JsonGueltig = false;
            fe.JsonFehler = "Daten nicht lesbar: " + ex.Message;
        }
        if (string.IsNullOrWhiteSpace(fe.FriendlyTitel)) fe.FriendlyTitel = fe.Typ.ToString();
    }

    private static string ProgrammText(ProgrammZeileDaten p)
    {
        var sb = new System.Text.StringBuilder();
        if (p.Reihenfolge is { } r) sb.Append(r).Append(". ");
        sb.Append(p.StueckTitel);
        var bei = new List<string>();
        if (!string.IsNullOrWhiteSpace(p.KomponistName)) bei.Add(p.KomponistName!);
        if (!string.IsNullOrWhiteSpace(p.ArrangeurName)) bei.Add($"arr. {p.ArrangeurName}");
        if (bei.Count > 0) sb.Append(" — ").Append(string.Join(", ", bei));
        if (!string.IsNullOrWhiteSpace(p.BandName)) sb.Append("  ·  ").Append(p.BandName);
        return sb.ToString();
    }

    private static string? Zeitraum(int? von, int? bis)
    {
        if (von is null && bis is null) return null;
        if (von is { } v && bis is { } b) return v == b ? v.ToString() : $"{v}–{b}";
        return (von ?? bis)?.ToString();
    }

    private async Task Uebernehmen(FundEdit f)
    {
        if (!f.JsonGueltig)
        {
            Snackbar.Add("JSON ungültig – bitte korrigieren. " + f.JsonFehler, Severity.Error);
            return;
        }
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await CrawlUebernahmeService.UebernehmenAsync(db, f.Id, f.Json);
            Snackbar.Add("Übernommen.", Severity.Success);
            await Laden();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
        }
    }

    private async Task Verwerfen(FundEdit f)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await CrawlUebernahmeService.VerwerfenAsync(db, f.Id);
        Snackbar.Add("Verworfen.", Severity.Info);
        await Laden();
    }

    private async Task WiederOeffnen(FundEdit f)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await CrawlUebernahmeService.WiederOeffnenAsync(db, f.Id);
        Snackbar.Add("Wieder geöffnet.", Severity.Info);
        await Laden();
    }

    private async Task AlleUebernehmen()
    {
        var offene = _funde.Where(f => f.Status == CrawlFundStatus.Offen).ToList();
        if (offene.Count == 0) { Snackbar.Add("Keine offenen Funde im aktuellen Filter.", Severity.Info); return; }
        var ungueltig = offene.Count(f => !f.JsonGueltig);
        offene = offene.Where(f => f.JsonGueltig).ToList();
        if (offene.Count == 0) { Snackbar.Add("Alle offenen Funde haben ungültiges JSON.", Severity.Error); return; }

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Text, $"{offene.Count} angezeigte, offene Funde übernehmen? (Find-or-create; bei Webseiten entstehen Quellen-Vorschläge.)" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Übernehmen bestätigen", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        int ok = 0, fehler = 0;
        await using var db = await DbFactory.CreateDbContextAsync();
        foreach (var f in offene)
        {
            try { await CrawlUebernahmeService.UebernehmenAsync(db, f.Id, f.Json); ok++; }
            catch { fehler++; }
        }
        Snackbar.Add($"{ok} übernommen{(fehler > 0 ? $", {fehler} mit Fehler (z. B. fehlendes Datum)" : "")}" +
            $"{(ungueltig > 0 ? $", {ungueltig} mit ungültigem JSON übersprungen" : "")}.",
            fehler > 0 || ungueltig > 0 ? Severity.Warning : Severity.Success);
        await Laden();
    }

    private async Task AlleVerwerfen()
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Text, "Alle OFFENEN Funde im aktuellen Filter (Typ/Lauf) als verworfen markieren?" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Verwerfen bestätigen", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.CrawlFunde.Where(f => f.Status == CrawlFundStatus.Offen);
        if (_laufId is not null) q = q.Where(f => f.LaufId == _laufId);
        if (_typ is not null) q = q.Where(f => f.Typ == _typ);
        var n = await q.ExecuteUpdateAsync(s => s
            .SetProperty(f => f.Status, CrawlFundStatus.Verworfen)
            .SetProperty(f => f.EntschiedenAm, (DateTime?)DateTime.UtcNow));
        Snackbar.Add($"{n} Funde verworfen.", Severity.Success);
        await Laden();
    }

    private async Task AlleLoeschen()
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Text, "Alle Funde im aktuellen Filter (Status/Typ/Lauf) ENDGÜLTIG löschen? Das kann nicht rückgängig gemacht werden." }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Löschen bestätigen", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.CrawlFunde.AsQueryable();
        if (_laufId is not null) q = q.Where(f => f.LaufId == _laufId);
        if (_status is not null) q = q.Where(f => f.Status == _status);
        if (_typ is not null) q = q.Where(f => f.Typ == _typ);
        var n = await q.ExecuteDeleteAsync();
        Snackbar.Add($"{n} Funde gelöscht.", Severity.Success);
        await Laden();
    }

    private class FundEdit
    {
        public Guid Id { get; set; }
        public CrawlFundTyp Typ { get; set; }
        public string QuellUrl { get; set; } = "";
        public Konfidenz? Konfidenz { get; set; }
        public string? DublettHinweis { get; set; }
        public string Json { get; set; } = "";
        public CrawlFundStatus Status { get; set; }
        public DateTime Gecrawlt { get; set; }
        public DateTime? Geaendert { get; set; }
        public string? Bearbeiter { get; set; }

        // Aufbereitete Anzeige (aus Json berechnet beim Laden und nach jeder JSON-Änderung)
        public string FriendlyTitel { get; set; } = "";

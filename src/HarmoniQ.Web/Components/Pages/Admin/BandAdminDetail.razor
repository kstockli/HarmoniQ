@page "/admin/bands/{BandId:guid}"
@page "/admin/bands/{BandId:guid}/mitglieder"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService
@using HarmoniQ.Web.Services
@using HarmoniQ.Web.Components.Pages.Admin.Dialogs

<PageTitle>@(_band?.Name ?? "Band") – HarmoniQ Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="/admin/bands"
               StartIcon="@Icons.Material.Filled.ArrowBack">Bands</MudButton>
    <MudText Typo="Typo.h4" Style="color:#D4AF37;">@(_band?.Name ?? "Band")</MudText>
    <MudSpacer />
    @if (_band != null)
    {
        <MudButton Variant="Variant.Outlined" Style="color:#9B59B6;border-color:#9B59B6;"
                   StartIcon="@Icons.Material.Filled.Merge" OnClick="Zusammenfuehren">Zusammenführen</MudButton>
        <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="@($"/bands/{BandId}")"
                   StartIcon="@Icons.Material.Filled.OpenInNew" Target="_blank">Öffentliche Ansicht</MudButton>
    }
</MudStack>

@if (_band == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @* ── Stammdaten ───────────────────────────────────────────────── *@
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="background:#1a0030; border:1px solid #3a1060;">
        <MudText Typo="Typo.h6" Class="mb-2" Style="color:#F0E6FF;">Stammdaten</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_land" Label="Land" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="BandKategorie?" @bind-Value="_kategorie" Label="Kategorie" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var k in Enum.GetValues<BandKategorie>())
                    {
                        <MudSelectItem T="BandKategorie?" Value="@k">@KategorieLabel(k)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="Staerkeklasse?" @bind-Value="_klasse" Label="Stärkeklasse" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var k in Enum.GetValues<Staerkeklasse>())
                    {
                        <MudSelectItem T="Staerkeklasse?" Value="@k">@KlasseLabel(k)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="int?" @bind-Value="_gruendung" Label="Gründungsjahr" Variant="Variant.Outlined" Min="1500" Max="2100" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_webseite" Label="Webseite (Homepage)" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_bildUrl" Label="Bild-URL (Logo/Foto)" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_youtube" Label="YouTube-Kanal" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_instagram" Label="Instagram" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_facebook" Label="Facebook" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_x" Label="X" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_wikipedia" Label="Wikipedia" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_email" Label="E-Mail" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_mobile" Label="Mobile / Telefon" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_geschichte" Label="Geschichte / Beschreibung" Variant="Variant.Outlined" Lines="4" />
            </MudItem>
        </MudGrid>
        <MudButton Variant="Variant.Filled" Style="background:#D4AF37; color:#0e0018;" Class="mt-3"
                   StartIcon="@Icons.Material.Filled.Save" OnClick="StammdatenSpeichern"
                   Disabled="@string.IsNullOrWhiteSpace(_name)">Stammdaten speichern</MudButton>
    </MudPaper>

    @* ── Alternative Namen (Aliase) ───────────────────────────────── *@
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="background:#1a0030; border:1px solid #3a1060;">
        <MudText Typo="Typo.h6" Class="mb-1" Style="color:#F0E6FF;">Alternative Namen</MudText>
        <MudText Typo="Typo.caption" Class="mb-2 d-block" Style="color:#A78FC0;">
            Weitere Schreibweisen/Namen dieser Band (z. B. „Blasorchester Neuenkirch"). Werden beim Import
            und Zusammenführen zur Erkennung genutzt.
        </MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
            @foreach (var a in _aliase)
            {
                <MudChip T="string" Size="Size.Small" OnClose="@(() => AliasEntfernen(a.Id))"
                         Style="background:#2d1657; color:#F0E6FF;">@a.Name</MudChip>
            }
            @if (_aliase.Count == 0)
            {
                <MudText Typo="Typo.body2" Style="color:#6f5a86;">Keine.</MudText>
            }
        </MudStack>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudTextField @bind-Value="_neuerAlias" Label="Name hinzufügen" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton Variant="Variant.Outlined" Style="color:#D4AF37;border-color:#D4AF37;"
                       OnClick="AliasHinzufuegen" Disabled="@string.IsNullOrWhiteSpace(_neuerAlias)">Hinzufügen</MudButton>
        </MudStack>
    </MudPaper>

    @* ── Mitglieder (inline editierbar) ───────────────────────────── *@
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="background:#1a0030; border:1px solid #3a1060;">
        <MudText Typo="Typo.h6" Class="mb-2" Style="color:#F0E6FF;">Mitglieder (@_mitglieder.Count)</MudText>
        @if (_mitglieder.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color:#A78FC0;">Noch niemand erfasst.</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Style="background:transparent;">
                <thead>
                    <tr>
                        <th style="color:#A78FC0;">Person</th><th style="color:#A78FC0;">Instrument</th>
                        <th style="color:#A78FC0;">Funktion</th><th style="color:#A78FC0;">Von</th>
                        <th style="color:#A78FC0;">Bis</th><th style="color:#A78FC0;width:1%;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _mitglieder)
                    {
                        <tr>
                            <td style="color:#F0E6FF;">
                                <MudLink Href="@($"/personen/{m.PersonId}")" Style="color:#F0E6FF;" Underline="Underline.Hover">@m.PersonName</MudLink>
                            </td>
                            @if (_editId == m.Id)
                            {
                                <td>
                                    <MudAutocomplete T="string" @bind-Value="_eInstrument" SearchFunc="SucheInstrument"
                                                     CoerceValue="true" ResetValueOnEmptyText="false" Dense="true"
                                                     Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" />
                                </td>
                                <td><MudTextField @bind-Value="_eFunktion" Margin="Margin.Dense" Variant="Variant.Outlined" /></td>
                                <td><MudNumericField T="int?" @bind-Value="_eVon" Margin="Margin.Dense" Variant="Variant.Outlined" Min="1800" Max="2100" HideSpinButtons="true" /></td>
                                <td><MudNumericField T="int?" @bind-Value="_eBis" Margin="Margin.Dense" Variant="Variant.Outlined" Min="1800" Max="2100" HideSpinButtons="true" /></td>
                                <td style="white-space:nowrap;">
                                    <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                                   title="Speichern" OnClick="@(() => ZeileSpeichern(m.Id))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Style="color:#A78FC0;"
                                                   title="Abbrechen" OnClick="@(() => _editId = null)" />
                                </td>
                            }
                            else
                            {
                                <td style="color:#C4B0D8;">@(m.Instrument ?? "—")</td>
                                <td style="color:#C4B0D8;">@(m.Funktion ?? "—")</td>
                                <td style="color:#C4B0D8;">@(m.VonJahr?.ToString() ?? "—")</td>
                                <td style="color:#C4B0D8;">@(m.BisJahr?.ToString() ?? (m.VonJahr.HasValue ? "heute" : "—"))</td>
                                <td style="white-space:nowrap;">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Style="color:#D4AF37;"
                                                   title="Bearbeiten" OnClick="@(() => Bearbeiten(m))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   title="Entfernen" OnClick="@(() => Loeschen(m.Id))" />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>

    @* ── Mitglied hinzufügen ──────────────────────────────────────── *@
    <MudPaper Class="pa-4" Elevation="2" Style="background:#1a0030; border:1px solid #3a1060;">
        <MudText Typo="Typo.h6" Class="mb-2" Style="color:#F0E6FF;">Mitglied hinzufügen</MudText>
        <MudText Typo="Typo.caption" Class="mb-3" Style="color:#A78FC0;">
            Tippe Name/Instrument – existiert er nicht, wird er angelegt. Bestehende werden wiederverwendet (keine Dubletten).
        </MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="string" @bind-Value="_personName" Label="Person" Variant="Variant.Outlined"
                                 SearchFunc="SuchePerson" CoerceValue="true" ResetValueOnEmptyText="false" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Sichtbarkeit" @bind-Value="_sichtbarkeit" Label="Sichtbarkeit (nur für neue Person)" Variant="Variant.Outlined">
                    <MudSelectItem Value="Sichtbarkeit.Oeffentlich">Öffentlich</MudSelectItem>
                    <MudSelectItem Value="Sichtbarkeit.NurInitialen">Nur Initialen</MudSelectItem>
                    <MudSelectItem Value="Sichtbarkeit.NichtBekannt">Nicht bekannt (?)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="string" @bind-Value="_instrumentName" Label="Instrument (optional)" Variant="Variant.Outlined"
                                 SearchFunc="SucheInstrument" CoerceValue="true" ResetValueOnEmptyText="false" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_funktion" Label="Funktion (optional)" Variant="Variant.Outlined" Placeholder="z. B. Chefdirigent" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudNumericField T="int?" @bind-Value="_vonJahr" Label="Von (Jahr)" Variant="Variant.Outlined" Min="1800" Max="2100" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudNumericField T="int?" @bind-Value="_bisJahr" Label="Bis (Jahr)" Variant="Variant.Outlined" Min="1800" Max="2100" HelperText="leer = aktiv" />
            </MudItem>
        </MudGrid>
        <MudButton Variant="Variant.Filled" Style="background:#D4AF37; color:#0e0018;" Class="mt-3"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="Hinzufuegen"
                   Disabled="@string.IsNullOrWhiteSpace(_personName)">Hinzufügen</MudButton>
    </MudPaper>

    @* ── Konzerte dieser Band ─────────────────────────────────────── *@
    <MudPaper Class="pa-4 mt-4 mb-4" Elevation="2" Style="background:#1a0030; border:1px solid #3a1060;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6" Style="color:#F0E6FF;">Konzerte (@_konzerte.Count)</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Style="color:#D4AF37;border-color:#D4AF37;"
                       StartIcon="@Icons.Material.Filled.Add" Href="/admin/konzerte/erfassen">Konzert erfassen</MudButton>
        </MudStack>
        @if (_konzerte.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color:#A78FC0;">Keine Konzerte.</MudText>
        }
        else
        {
            <MudList T="string" Dense="true">
                @foreach (var k in _konzerte)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Event" Style="color:#F0E6FF;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <div style="flex:1;">
                                @k.Titel
                                <MudText Typo="Typo.caption" Class="d-block" Style="color:#A78FC0;">
                                    @k.Datum.ToString("dd.MM.yyyy")@(string.IsNullOrWhiteSpace(k.Ort) ? "" : $" · {k.Ort}")
                                </MudText>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Style="color:#D4AF37;"
                                           title="Bearbeiten (Wizard)" Href="@($"/admin/konzerte/{k.Id}/bearbeiten")" />
                            <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small" Color="Color.Error"
                                           title="Band aus Konzert entfernen" OnClick="@(() => KonzertEntfernen(k.Id))" />
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }
    </MudPaper>

    @* ── Videos dieser Band ───────────────────────────────────────── *@
    <MudPaper Class="pa-4" Elevation="2" Style="background:#1a0030; border:1px solid #3a1060;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6" Style="color:#F0E6FF;">Videos (@_videos.Count)</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Style="color:#D4AF37;border-color:#D4AF37;"
                       StartIcon="@Icons.Material.Filled.VideoLibrary" Href="/admin/videos">Videos verwalten</MudButton>
        </MudStack>
        @if (_videos.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color:#A78FC0;">Keine Videos.</MudText>
        }
        else
        {
            <MudList T="string" Dense="true">
                @foreach (var v in _videos)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.PlayCircle" Style="color:#F0E6FF;"
                                 Href="@($"/videos/{v.Id}")">
                        @v.StueckTitel
                        <MudText Typo="Typo.caption" Class="d-block" Style="color:#A78FC0;">@v.Titel</MudText>
                    </MudListItem>
                }
            </MudList>
        }
    </MudPaper>

    <AuditInfo CreateTime="@_band.CreateTime" CreateUser="@_band.CreateUser"
               ModifyTime="@_band.ModifyTime" ModifyUser="@_band.ModifyUser" />
}

@code {
    [Parameter] public Guid BandId { get; set; }

    private Band? _band;
    private string _name = "", _land = "", _webseite = "", _bildUrl = "";
    private string _geschichte = "", _youtube = "", _instagram = "", _x = "", _email = "";
    private string _facebook = "", _wikipedia = "", _mobile = "";
    private BandKategorie? _kategorie;
    private Staerkeklasse? _klasse;
    private int? _gruendung;
    private List<Zeile> _mitglieder = [];
    private List<AliasZeile> _aliase = [];
    private List<KonzertZeile> _konzerte = [];
    private List<VideoZeile> _videos = [];
    private string? _neuerAlias;
    private List<string> _personNamen = [];
    private List<string> _instrumentNamen = [];

    // Inline-Edit einer bestehenden Zeile
    private Guid? _editId;
    private string? _eInstrument, _eFunktion;
    private int? _eVon, _eBis;

    // Neues Mitglied
    private string? _personName;
    private Sichtbarkeit _sichtbarkeit = Sichtbarkeit.NurInitialen;
    private string? _instrumentName, _funktion;
    private int? _vonJahr, _bisJahr;

    protected override async Task OnParametersSetAsync() => await Laden();

    private async Task Laden()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _band = await db.Bands.Include(b => b.Links).FirstOrDefaultAsync(b => b.Id == BandId);
        if (_band == null) { Nav.NavigateTo("/admin/bands"); return; }

        _name = _band.Name; _land = _band.Land ?? ""; _webseite = _band.Webseite ?? ""; _bildUrl = _band.BildUrl ?? "";
        _geschichte = _band.Geschichte ?? "";
        _kategorie = _band.Kategorie; _klasse = _band.Staerkeklasse; _gruendung = _band.Gruendungsjahr;
        _youtube = _band.YouTube ?? ""; _instagram = _band.Instagram ?? ""; _x = _band.X ?? ""; _email = _band.EMail ?? "";
        _facebook = _band.Facebook ?? ""; _wikipedia = _band.Wikipedia ?? ""; _mobile = _band.Mobile ?? "";

        _aliase = await db.BandAliase.Where(a => a.BandId == BandId).OrderBy(a => a.Name)
            .Select(a => new AliasZeile(a.Id, a.Name)).ToListAsync();

        _konzerte = await db.KonzertBands.Where(kb => kb.BandId == BandId)
            .OrderByDescending(kb => kb.Konzert.Datum)
            .Select(kb => new KonzertZeile(kb.KonzertId, kb.Konzert.Datum, kb.Konzert.Name, kb.Konzert.Ort))
            .ToListAsync();

        _videos = await db.Videos.Where(v => v.BandId == BandId)
            .OrderBy(v => v.Stueck.Titel)
            .Select(v => new VideoZeile(v.Id, v.Titel, v.Stueck.Titel))
            .ToListAsync();

        _mitglieder = await db.BandMitgliedschaften
            .Where(m => m.BandId == BandId)
            .OrderByDescending(m => m.BisJahr == null)
            .ThenBy(m => m.Person.Name)
            .Select(m => new Zeile(m.Id, m.PersonId, m.Person.Name,
                m.Instrument != null ? m.Instrument.Name : null,
                m.Funktion, m.VonJahr, m.BisJahr))
            .ToListAsync();

        _personNamen = await db.Personen.OrderBy(p => p.Name).Select(p => p.Name).ToListAsync();
        _instrumentNamen = await db.Instrumente.OrderBy(i => i.Name).Select(i => i.Name).ToListAsync();
    }

    private Task<IEnumerable<string>> SuchePerson(string? v, CancellationToken ct) => Task.FromResult(Filter(_personNamen, v));
    private Task<IEnumerable<string>> SucheInstrument(string? v, CancellationToken ct) => Task.FromResult(Filter(_instrumentNamen, v));
    private static IEnumerable<string> Filter(IEnumerable<string> q, string? v) =>
        string.IsNullOrWhiteSpace(v) ? q.Take(15) : q.Where(x => x.Contains(v, StringComparison.OrdinalIgnoreCase)).Take(15);

    private async Task StammdatenSpeichern()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var band = await db.Bands.Include(b => b.Links).FirstOrDefaultAsync(b => b.Id == BandId);
        if (band == null) return;
        band.Name = _name.Trim();
        band.Land = Leer(_land);
        band.Webseite = Leer(_webseite);
        band.BildUrl = Leer(_bildUrl);
        band.Geschichte = Leer(_geschichte);
        band.Kategorie = _kategorie;
        band.Staerkeklasse = _klasse;
        band.Gruendungsjahr = _gruendung;
        band.YouTube = _youtube;       // Komfort-Setter pflegen die BandLink-Tabelle
        band.Instagram = _instagram;
        band.X = _x;
        band.EMail = _email;
        band.Facebook = _facebook;
        band.Wikipedia = _wikipedia;
        band.Mobile = _mobile;
        await db.SaveChangesAsync();
        Snackbar.Add("Stammdaten gespeichert.", Severity.Success);
        await Laden();
    }

    private async Task AliasHinzufuegen()
    {
        var name = _neuerAlias?.Trim();
        if (string.IsNullOrWhiteSpace(name)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await db.BandAliase.AnyAsync(a => a.BandId == BandId && a.Name == name))
        {
            db.BandAliase.Add(new BandAlias { BandId = BandId, Name = name });
            await db.SaveChangesAsync();
        }
        _neuerAlias = null;
        await Laden();
    }

    private async Task AliasEntfernen(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var a = await db.BandAliase.FindAsync(id);
        if (a != null) { db.BandAliase.Remove(a); await db.SaveChangesAsync(); }
        await Laden();
    }

    private async Task KonzertEntfernen(Guid konzertId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var kb = await db.KonzertBands.FirstOrDefaultAsync(x => x.KonzertId == konzertId && x.BandId == BandId);
        if (kb != null) { db.KonzertBands.Remove(kb); await db.SaveChangesAsync(); }
        await Laden();
    }

    private async Task Zusammenfuehren()
    {
        var parameters = new DialogParameters<BandMergeDialog> { { x => x.QuelleId, BandId }, { x => x.QuelleName, _band?.Name ?? "" } };
        var dialog = await DialogService.ShowAsync<BandMergeDialog>("Band zusammenführen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        var zielId = (Guid)result.Data!;

        await using var db = await DbFactory.CreateDbContextAsync();
        var (ok, meldung) = await BandMergeService.MergeAsync(db, BandId, zielId);
        Snackbar.Add(meldung, ok ? Severity.Success : Severity.Error);
        if (ok) Nav.NavigateTo($"/admin/bands/{zielId}");
    }

    private static string KategorieLabel(BandKategorie k) => k switch
    {
        BandKategorie.Harmonie => "Harmonie",
        BandKategorie.Brassband => "Brassband",
        BandKategorie.Fanfare => "Fanfare",
        BandKategorie.Unterhaltung => "Unterhaltung",
        BandKategorie.JugendmusikHarmonie => "Jugendmusik Harmonie",
        BandKategorie.JugendmusikBrassband => "Jugendmusik Brassband",
        BandKategorie.Blaeserensemble => "Bläserensemble",
        _ => "Sonstige"
    };

    private static string KlasseLabel(Staerkeklasse k) => k switch
    {
        Staerkeklasse.Hoechstklasse => "Höchstklasse",
        Staerkeklasse.Elite => "Elite",
        Staerkeklasse.Klasse1 => "1. Klasse",
        Staerkeklasse.Klasse2 => "2. Klasse",
        Staerkeklasse.Klasse3 => "3. Klasse",
        Staerkeklasse.Klasse4 => "4. Klasse",
        Staerkeklasse.Oberstufe => "Oberstufe",
        Staerkeklasse.Mittelstufe => "Mittelstufe",
        Staerkeklasse.Unterstufe => "Unterstufe",
        _ => k.ToString()
    };

    private record AliasZeile(Guid Id, string Name);
    private record KonzertZeile(Guid Id, DateOnly Datum, string? Name, string? Ort)
    {
        public string Titel => Name ?? Datum.ToString("dd.MM.yyyy");
    }
    private record VideoZeile(Guid Id, string Titel, string StueckTitel);

    private void Bearbeiten(Zeile m)
    {
        _editId = m.Id;
        _eInstrument = m.Instrument;
        _eFunktion = m.Funktion;
        _eVon = m.VonJahr;
        _eBis = m.BisJahr;
    }

    private async Task ZeileSpeichern(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var m = await db.BandMitgliedschaften.FindAsync(id);
        if (m == null) { _editId = null; return; }

        // Instrument find-or-create (oder entfernen).
        Guid? instrumentId = null;
        if (!string.IsNullOrWhiteSpace(_eInstrument))
        {
            var iName = _eInstrument.Trim();
            var instrument = await db.Instrumente.FirstOrDefaultAsync(i => i.Name == iName);
            if (instrument == null) { instrument = new Instrument { Name = iName }; db.Instrumente.Add(instrument); }
            instrumentId = instrument.Id;
            if (!await db.PersonInstrumente.AnyAsync(pi => pi.PersonId == m.PersonId && pi.InstrumentId == instrumentId))
                db.PersonInstrumente.Add(new PersonInstrument { PersonId = m.PersonId, InstrumentId = instrumentId.Value });
        }

        m.InstrumentId = instrumentId;
        m.Funktion = Leer(_eFunktion);
        m.VonJahr = _eVon;
        m.BisJahr = _eBis;
        await db.SaveChangesAsync();

        _editId = null;
        Snackbar.Add("Mitglied aktualisiert.", Severity.Success);
        await Laden();
    }

    private async Task Loeschen(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var m = await db.BandMitgliedschaften.FindAsync(id);
        if (m != null) { db.BandMitgliedschaften.Remove(m); await db.SaveChangesAsync(); }
        if (_editId == id) _editId = null;
        await Laden();
    }

    private async Task Hinzufuegen()
    {
        if (string.IsNullOrWhiteSpace(_personName)) return;
        var name = _personName.Trim();
        await using var db = await DbFactory.CreateDbContextAsync();

        var person = await db.Personen.FirstOrDefaultAsync(p => p.Name == name);
        if (person == null)
        {
            person = new Person { Name = name, Sichtbarkeit = _sichtbarkeit };
            db.Personen.Add(person);
            db.PersonRollen.Add(new PersonRolle { PersonId = person.Id, Rolle = PersonRolleTyp.Musikant });
        }

        Guid? instrumentId = null;
        if (!string.IsNullOrWhiteSpace(_instrumentName))
        {
            var iName = _instrumentName.Trim();
            var instrument = await db.Instrumente.FirstOrDefaultAsync(i => i.Name == iName)
                             ?? db.Instrumente.Local.FirstOrDefault(i => i.Name == iName);
            if (instrument == null) { instrument = new Instrument { Name = iName }; db.Instrumente.Add(instrument); }
            instrumentId = instrument.Id;
            if (!await db.PersonInstrumente.AnyAsync(pi => pi.PersonId == person.Id && pi.InstrumentId == instrumentId))
                db.PersonInstrumente.Add(new PersonInstrument { Person = person, Instrument = instrument });
        }

        if (await db.BandMitgliedschaften.AnyAsync(m => m.BandId == BandId && m.PersonId == person.Id))
        {
            Snackbar.Add($"{name} ist bereits Mitglied dieser Band.", Severity.Warning);
            return;
        }

        db.BandMitgliedschaften.Add(new BandMitgliedschaft
        {
            BandId = BandId, Person = person, InstrumentId = instrumentId,
            Funktion = Leer(_funktion), VonJahr = _vonJahr, BisJahr = _bisJahr
        });
        await db.SaveChangesAsync();

        Snackbar.Add($"{name} hinzugefügt.", Severity.Success);
        _personName = null; _instrumentName = null; _funktion = null; _vonJahr = null; _bisJahr = null;
        await Laden();
    }

    private static string? Leer(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private record Zeile(Guid Id, Guid PersonId, string PersonName, string? Instrument, string? Funktion, int? VonJahr, int? BisJahr);
}

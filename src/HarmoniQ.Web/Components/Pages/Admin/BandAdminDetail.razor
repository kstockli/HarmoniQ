    // Lokal-Autocomplete (Namen + Aliase); Find-or-create beim Speichern über LokalService.
    private Task<IEnumerable<string>> SucheLokal(string? wert)
    {
        IEnumerable<string> r = string.IsNullOrWhiteSpace(wert)
            ? _lokalNamen
            : _lokalNamen.Where(n => n.Contains(wert, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(r.Take(15));
    }

    protected override async Task OnParametersSetAsync() => await Laden();

    private async Task Laden()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // Zugriff: globaler Admin ODER Band-Admin dieser Band (UX-Spec Block 5).
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _istGlobalAdmin = await BandAdminService.IstGlobalAdminAsync(db, _userId);
        _darfBearbeiten = _istGlobalAdmin || await BandAdminService.IstBandAdminAsync(db, _userId, BandId);
        if (!_darfBearbeiten) { Nav.NavigateTo($"/bands/{BandId}"); return; }

        _band = await db.Bands.Include(b => b.Links).Include(b => b.HeimatLokal).FirstOrDefaultAsync(b => b.Id == BandId);
        if (_band == null) { Nav.NavigateTo(_istGlobalAdmin ? "/admin/bands" : "/account/meine-bands"); return; }

        if (_darfBearbeiten)
        {
            _bandAdmins = await (from ba in db.BandAdministratoren
                                 join u in db.Users on ba.BenutzerId equals u.Id
                                 where ba.BandId == BandId
                                 select new AdminZeile(ba.Id, u.Email ?? u.UserName ?? ba.BenutzerId)).ToListAsync();
            _offeneEinladungen = await BandAdminService.OffeneEinladungenAsync(db, BandId);
        }

        _name = _band.Name; _land = _band.Land ?? ""; _webseite = _band.Webseite ?? ""; _bildUrl = _band.BildUrl ?? "";
        _fotoUrl = _band.FotoUrl ?? ""; _fotoAttribution = _band.FotoAttribution ?? "";
        _geschichte = _band.Geschichte ?? "";
        _heimatLokal = _band.HeimatLokal?.Name ?? "";
        _lokalNamen = (await db.Lokale.Select(l => l.Name).ToListAsync())
            .Concat(await db.LokalAliase.Select(a => a.Name).ToListAsync())
            .Distinct().OrderBy(n => n).ToList();
        _kategorie = _band.Kategorie; _klasse = _band.Staerkeklasse; _gruendung = _band.Gruendungsjahr;
        _youtube = _band.YouTube ?? ""; _instagram = _band.Instagram ?? ""; _x = _band.X ?? ""; _email = _band.EMail ?? "";
        _facebook = _band.Facebook ?? ""; _wikipedia = _band.Wikipedia ?? ""; _mobile = _band.Mobile ?? "";
        _imagefilm = _band.Imagefilm ?? "";

        _aliase = await db.BandAliase.Where(a => a.BandId == BandId).OrderBy(a => a.Name)
            .Select(a => new AliasZeile(a.Id, a.Name)).ToListAsync();

        _konzerte = await db.KonzertBands.Where(kb => kb.BandId == BandId)
            .OrderByDescending(kb => kb.Konzert.Datum)
            .Select(kb => new KonzertZeile(kb.KonzertId, kb.Konzert.Datum, kb.Konzert.Uhrzeit, kb.Konzert.Name, kb.Konzert.Ort))
            .ToListAsync();

        _videos = await db.Videos.Where(v => v.BandId == BandId)
            .OrderBy(v => v.Stueck.Titel)
            .Select(v => new VideoZeile(v.Id, v.Titel, v.Stueck.Titel))
            .ToListAsync();

        _mitglieder = await db.BandMitgliedschaften
            .Where(m => m.BandId == BandId)
            .OrderByDescending(m => m.BisJahr == null)
            .ThenBy(m => m.Person.Name)
            .Select(m => new Zeile(m.Id, m.PersonId, m.Person.Name,
                m.Instrument != null ? m.Instrument.Name : null,
                m.Funktion, m.VonJahr, m.BisJahr))
            .ToListAsync();

        // Folgende Personen (ohne Mitglieder – die folgen implizit).
        _interessenten = await db.BandInteressen
            .Where(i => i.BandId == BandId && !db.BandMitgliedschaften
                .Any(m => m.BandId == BandId && m.PersonId == i.PersonId))
            .OrderBy(i => i.Person.Name)
            .Select(i => new ValueTuple<Guid, string>(i.PersonId, i.Person.Name))
            .ToListAsync();

        _personNamen = await db.Personen.OrderBy(p => p.Name).Select(p => p.Name).ToListAsync();
        _instrumentNamen = await db.Instrumente.OrderBy(i => i.Name).Select(i => i.Name).ToListAsync();
    }

    private Task<IEnumerable<string>> SuchePerson(string? v, CancellationToken ct) => Task.FromResult(Filter(_personNamen, v));
    private Task<IEnumerable<string>> SucheInstrument(string? v, CancellationToken ct) => Task.FromResult(Filter(_instrumentNamen, v));
    private static IEnumerable<string> Filter(IEnumerable<string> q, string? v) =>
        string.IsNullOrWhiteSpace(v) ? q.Take(15) : q.Where(x => x.Contains(v, StringComparison.OrdinalIgnoreCase)).Take(15);

    private async Task StammdatenSpeichern()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var band = await db.Bands.Include(b => b.Links).FirstOrDefaultAsync(b => b.Id == BandId);
        if (band == null) return;
        band.Name = _name.Trim();
        band.Land = Leer(_land);
        band.Webseite = Leer(_webseite);
        band.BildUrl = Leer(_bildUrl);
        band.FotoUrl = Leer(_fotoUrl);
        band.FotoAttribution = Leer(_fotoAttribution);
        band.Geschichte = Leer(_geschichte);
        band.Kategorie = _kategorie;
        band.Staerkeklasse = _klasse;
        band.Gruendungsjahr = _gruendung;
        band.YouTube = _youtube;       // Komfort-Setter pflegen die BandLink-Tabelle
        band.Imagefilm = _imagefilm;
        band.Instagram = _instagram;
        band.X = _x;
        band.EMail = _email;
        band.Facebook = _facebook;
        band.Wikipedia = _wikipedia;
        band.Mobile = _mobile;
        // Heimatort/Probelokal: Find-or-create über LokalService (Ortschaft genügt).
        band.HeimatLokalId = await LokalService.FindeOderErstelleAsync(db, _heimatLokal);
        await db.SaveChangesAsync();

        // Koordinaten des (evtl. neuen) Lokals ermitteln, falls noch keine – für „Bands in der Nähe".
        if (band.HeimatLokalId is Guid lid)
        {
            var lokal = await db.Lokale.FirstOrDefaultAsync(l => l.Id == lid);
            if (lokal is { Lat: null } && await Geo.GeocodeDetailAsync($"{lokal.Name}, Schweiz") is { } t)
            {
                lokal.Lat = t.Lat;
                lokal.Lng = t.Lng;
                await db.SaveChangesAsync();
            }
        }
        Snackbar.Add("Stammdaten gespeichert.", Severity.Success);
        await Laden();
    }

    private async Task AliasHinzufuegen()
    {
        var name = _neuerAlias?.Trim();
        if (string.IsNullOrWhiteSpace(name)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await db.BandAliase.AnyAsync(a => a.BandId == BandId && a.Name == name))
        {
            db.BandAliase.Add(new BandAlias { BandId = BandId, Name = name });
            await db.SaveChangesAsync();
        }
        _neuerAlias = null;
        await Laden();
    }


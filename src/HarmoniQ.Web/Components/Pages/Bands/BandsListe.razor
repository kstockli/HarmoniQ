@page "/bands"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Services
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@inject GeocodingService Geo
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Bands – HarmoniQ</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Style="color:#D4AF37;">Bands & Ensembles</MudText>

@if (_alle == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_alle.Count == 0)
{
    <MudAlert Severity="Severity.Info">Noch keine Bands erfasst.</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="background:#1a0030; border:1px solid #3a1060;">
        @* Ein Hauptfilter (Suche); Details hinter „Mehr Filter" (User-Test-Feedback: einfacher). *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudTextField @bind-Value="_suche" @bind-Value:after="FilterGeaendert" Label="Band suchen"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true"
                          DebounceInterval="250" OnKeyDown="SucheKeyDown"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            <MudButton Variant="Variant.Text" Style="color:#9B59B6;white-space:nowrap;"
                       StartIcon="@(_mehrFilter ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.Tune)"
                       OnClick="MehrFilterUmschalten">@(_mehrFilter ? "Weniger" : "Mehr Filter")</MudButton>
        </MudStack>

        @if (_mehrFilter)
        {
            <MudGrid Spacing="3" Class="mt-1">
                <MudItem xs="6" sm="4">
                    <MudSelect T="BandKategorie?" @bind-Value="_kategorie" @bind-Value:after="FilterGeaendert"
                               Label="Kategorie" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        @foreach (var k in Enum.GetValues<BandKategorie>())
                        {
                            <MudSelectItem T="BandKategorie?" Value="@k">@KategorieLabel(k)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudSelect T="Staerkeklasse?" @bind-Value="_klasse" @bind-Value:after="FilterGeaendert"
                               Label="Stärkeklasse" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        @foreach (var s in Enum.GetValues<Staerkeklasse>())
                        {
                            <MudSelectItem T="Staerkeklasse?" Value="@s">@KlasseLabel(s)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            @* Bands in der Nähe: Bezugspunkt via Standort ODER PLZ, dann Umkreis. *@
            <MudDivider Class="my-2" Style="border-color:#3a1060;" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudIcon Icon="@Icons.Material.Filled.NearMe" Style="color:#1ABC9C;" />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Style="color:#1ABC9C;border-color:#1ABC9C;"
                           StartIcon="@Icons.Material.Filled.MyLocation" OnClick="MeinStandort" Disabled="_standortLaeuft">
                    @(_standortLaeuft ? "…" : "Mein Standort")
                </MudButton>
                <MudTextField @bind-Value="_plz" Label="oder PLZ" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Style="max-width:120px;" Immediate="true" />
                <MudButton Size="Size.Small" OnClick="PlzAnwenden" Disabled="@(string.IsNullOrWhiteSpace(_plz))">Anwenden</MudButton>
                <MudSelect T="int?" @bind-Value="_radiusKm" @bind-Value:after="FilterGeaendert" Label="Umkreis"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:130px;">
                    <MudSelectItem T="int?" Value="10">≤ 10 km</MudSelectItem>
                    <MudSelectItem T="int?" Value="25">≤ 25 km</MudSelectItem>
                    <MudSelectItem T="int?" Value="50">≤ 50 km</MudSelectItem>
                    <MudSelectItem T="int?" Value="100">≤ 100 km</MudSelectItem>
                </MudSelect>
                @if (_refLat is not null)
                {
                    <MudChip T="string" Size="Size.Small" Style="color:#1ABC9C;" OnClose="StandortZuruecksetzen">Bezugspunkt gesetzt</MudChip>
                }
                else
                {
                    <MudText Typo="Typo.caption" Style="color:#6f5a86;">für „in der Nähe": Standort freigeben oder PLZ eingeben</MudText>
                }
            </MudStack>
        }
        <MudText Typo="Typo.caption" Class="mt-2 d-block" Style="color:#A78FC0;">@_gefiltert.Count von @_alle.Count Bands</MudText>
    </MudPaper>

    @* Kernspalten laut Feedback: Name · Ort · Folgen (Kategorie/Klasse/… stecken im Filter). *@
    <div id="bands-ergebnisse">
        <MudDataGrid T="Zeile" Items="_gefiltert" Hover="true" Dense="true" SortMode="SortMode.Single" Style="background:#1a0030;">
            <Columns>
                <TemplateColumn Title="Name" SortBy="@(z => z.Name)">
                    <CellTemplate>
                        <MudLink Href="@($"/bands/{context.Item.Id}")" Style="color:#F0E6FF;font-weight:500;"
                                 Underline="Underline.Hover">@context.Item.Name</MudLink>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="z => z.Ort" Title="Ort" />
                @if (_refLat is not null)
                {
                    <TemplateColumn Title="Entfernung" SortBy="@(z => z.Distanz ?? double.MaxValue)">
                        <CellTemplate>@(context.Item.Distanz is double d ? $"{d:0.#} km" : "–")</CellTemplate>
                    </TemplateColumn>
                }
                <TemplateColumn Title="Folgen" Sortable="false">
                    <CellTemplate>@FolgenZelle(context.Item.Id)</CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </div>
}

@code {
    private List<Zeile>? _alle;
    private List<Zeile> _gefiltert = [];
    private string _suche = "";
    private BandKategorie? _kategorie;
    private Staerkeklasse? _klasse;
    private double? _refLat, _refLng;   // Bezugspunkt (Standort/PLZ)
    private bool _refManuell;   // true = vom User explizit gesetzt (PLZ/„Mein Standort") → Vorrang vor GPS-Autoload
    private int? _radiusKm;
    private string _plz = "";
    private bool _standortLaeuft;
    private bool _mehrFilter;
    private bool _bereit;   // true nach erstem Render → JS-Interop (Filter merken) erlaubt

    // Folgen-Status
    private Guid? _personId;
    private HashSet<Guid> _folgeIds = [];
    private HashSet<Guid> _mitgliedIds = [];

    private const string FilterKey = "bands.filter";
    private string LoginHref => $"/Account/Login?ReturnUrl={Uri.EscapeDataString("/bands")}";

    private record FilterState(string? Q, BandKategorie? Kat, Staerkeklasse? Klasse, string? Plz, int? Km, bool Mehr,
        double? RefLat = null, double? RefLng = null, bool RefManuell = false);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _alle = await db.Bands
            .OrderBy(b => b.Name)
            .Select(b => new Zeile(b.Id, b.Name, b.Kategorie, b.Staerkeklasse, b.Land,
                b.Mitgliedschaften.Count, b.Videos.Count(v => v.Status == VideoStatus.Genehmigt),
                b.HeimatLokal != null ? b.HeimatLokal.Name : null,
                b.HeimatLokal != null ? b.HeimatLokal.Lat : null,
                b.HeimatLokal != null ? b.HeimatLokal.Lng : null))
            .ToListAsync();

        // Folgen-Status des angemeldeten Kontos (für den Folgen-Knopf in der Liste).
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _personId = await BandFolgenService.PersonIdAsync(db, userId);
        if (_personId is Guid pid)
        {
            _folgeIds = (await db.BandInteressen.Where(i => i.PersonId == pid).Select(i => i.BandId).ToListAsync()).ToHashSet();
            _mitgliedIds = (await db.BandMitgliedschaften.Where(m => m.PersonId == pid).Select(m => m.BandId).ToListAsync()).ToHashSet();
        }

        Filtern();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // (1) Zuletzt genutzten Filter wiederherstellen – überlebt „in Band rein → zurück".
        try
        {
            var json = await JS.InvokeAsync<string?>("harmoniqUi.get", FilterKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var s = System.Text.Json.JsonSerializer.Deserialize<FilterState>(json);
                if (s != null)
                {
                    _suche = s.Q ?? ""; _kategorie = s.Kat; _klasse = s.Klasse;
                    _plz = s.Plz ?? ""; _radiusKm = s.Km; _mehrFilter = s.Mehr;
                    // Explizit gesetzten Bezugspunkt (PLZ/„Mein Standort") wiederherstellen – hat Vorrang.
                    _refManuell = s.RefManuell;
                    if (_refManuell && s.RefLat is double rla && s.RefLng is double rln)
                    { _refLat = rla; _refLng = rln; }
                }
            }
        }
        catch { /* sessionStorage nicht verfügbar */ }

        // (2) Standort (falls schon freigegeben) für „in der Nähe" – aber NUR, wenn der User keinen
        // eigenen Bezugspunkt gesetzt hat (14a: manuelle PLZ darf GPS-Autoload nicht weichen).
        if (!_refManuell && _refLat is null)
        {
            try
            {
                var pos = await JS.InvokeAsync<double[]?>("harmoniqGeo.autoStandort")
                          ?? await JS.InvokeAsync<double[]?>("harmoniqGeo.load");
                // Standort nur als Bezugspunkt merken (für die Entfernungs-Spalte) – KEINEN Umkreis
                // still voreinstellen, sonst wird die Liste unbemerkt gefiltert (User-Feedback).
                if (pos is { Length: 2 }) { _refLat = pos[0]; _refLng = pos[1]; }
            }
            catch { /* Geo nicht verfügbar */ }
        }

        // Ist ein Umkreis aktiv (z. B. aus dem gemerkten Filter), MUSS das Panel offen sein –
        // sonst filtert der Umkreis unsichtbar. „Wenn angewählt, muss man ihn sehen."
        if (_radiusKm is not null) _mehrFilter = true;

        _bereit = true;
        Filtern();
        StateHasChanged();
    }

    private async Task FilterGeaendert()
    {
        Filtern();
        await FilterMerken();
    }

    private async Task MehrFilterUmschalten()
    {
        _mehrFilter = !_mehrFilter;
        await FilterMerken();
    }

    private async Task FilterMerken()
    {
        if (!_bereit) return;
        var json = System.Text.Json.JsonSerializer.Serialize(
            new FilterState(_suche, _kategorie, _klasse, _plz, _radiusKm, _mehrFilter,
                _refManuell ? _refLat : null, _refManuell ? _refLng : null, _refManuell));
        try { await JS.InvokeVoidAsync("harmoniqUi.set", FilterKey, json); } catch { }
    }

    private async Task SucheKeyDown(KeyboardEventArgs e)
    {
        // Smartphone: nach Enter zum ersten Resultat scrollen (statt oben mit Tastatur zu bleiben).
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            try { await JS.InvokeVoidAsync("harmoniqUi.scrollTo", "#bands-ergebnisse"); } catch { }
        }
    }

    private void Filtern()
    {
        var s = _suche.Trim();
        IEnumerable<Zeile> q = _alle!
            .Where(z =>
                (s == "" || z.Name.Contains(s, StringComparison.OrdinalIgnoreCase)) &&
                (_kategorie == null || z.Kategorie == _kategorie) &&
                (_klasse == null || z.Klasse == _klasse));

        if (_refLat is double rlat && _refLng is double rlng)
        {
            var list = q.ToList();
            foreach (var z in list)
                z.Distanz = (z.Lat is double la && z.Lng is double lo) ? Distanz(rlat, rlng, la, lo) : null;
            // Bands ohne hinterlegten Ort bleiben sichtbar (ohne km), Distanz-gefilterte nur bei bekannter Distanz.
            if (_radiusKm is int r)
                list = list.Where(z => z.Distanz is not double d || d <= r).ToList();
            _gefiltert = list.OrderBy(z => z.Distanz ?? double.MaxValue).ThenBy(z => z.Name).ToList();
        }
        else
        {
            _gefiltert = q.OrderBy(z => z.Name).ToList();
        }
    }

    private RenderFragment FolgenZelle(Guid bandId) => __builder =>
    {
        if (_personId is null)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Style="color:#9B59B6;"
                       Href="@LoginHref">Anmelden zum Folgen</MudButton>
        }
        else if (_mitgliedIds.Contains(bandId))
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Mitglied</MudChip>
        }
        else
        {
            var folgt = _folgeIds.Contains(bandId);
            <MudButton Size="Size.Small" Variant="@(folgt ? Variant.Filled : Variant.Outlined)"
                       Style="@(folgt ? "background:#1ABC9C;color:#0e0018;" : "color:#1ABC9C;border-color:#1ABC9C;")"
                       StartIcon="@(folgt ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)"
                       OnClick="@(() => FolgenUmschalten(bandId))">@(folgt ? "Folge ich" : "Folgen")</MudButton>
        }
    };

    private async Task FolgenUmschalten(Guid bandId)
    {
        if (_personId is not Guid pid) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var jetzt = await BandFolgenService.UmschaltenAsync(db, pid, bandId);
        if (jetzt) _folgeIds.Add(bandId); else _folgeIds.Remove(bandId);
        Snackbar.Add(jetzt ? "Du folgst dieser Band." : "Nicht mehr gefolgt.", jetzt ? Severity.Success : Severity.Info);
    }

    private async Task MeinStandort()
    {
        _standortLaeuft = true;
        var pos = await JS.InvokeAsync<double[]?>("harmoniqGeo.standort");
        _standortLaeuft = false;
        if (pos is { Length: 2 }) { await RefSetzen(pos[0], pos[1]); Snackbar.Add("Standort übernommen.", Severity.Success); }
        else Snackbar.Add("Kein Standort verfügbar (abgelehnt?). Nutze die PLZ-Eingabe.", Severity.Info);
    }

    private async Task PlzAnwenden()
    {
        var res = await Geo.GeocodePlzAsync(_plz);
        if (res is (double la, double lo)) { await RefSetzen(la, lo); Snackbar.Add($"PLZ {_plz.Trim()} übernommen.", Severity.Success); }
        else Snackbar.Add("PLZ nicht gefunden.", Severity.Warning);
    }

    private async Task RefSetzen(double lat, double lng, bool speichern = true)
    {
        _refLat = lat; _refLng = lng;
        _refManuell = true;   // explizit gesetzt → gewinnt gegen GPS-Autoload (14a)
        _radiusKm ??= 50;
        if (speichern) await JS.InvokeVoidAsync("harmoniqGeo.save", lat, lng);
        Filtern();
        await FilterMerken();
    }

    private async Task StandortZuruecksetzen()
    {
        _refLat = _refLng = null;
        _refManuell = false;
        _radiusKm = null;
        await JS.InvokeVoidAsync("harmoniqGeo.clear");
        Filtern();
        await FilterMerken();
    }

    private static double Distanz(double lat1, double lng1, double lat2, double lng2)
    {
        const double R = 6371.0;
        double Rad(double g) => g * Math.PI / 180.0;
        var dLat = Rad(lat2 - lat1);
        var dLng = Rad(lng2 - lng1);
        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2)
              + Math.Cos(Rad(lat1)) * Math.Cos(Rad(lat2)) * Math.Sin(dLng / 2) * Math.Sin(dLng / 2);
        return R * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
    }

    private static string KategorieLabel(BandKategorie k) => k switch
    {
        BandKategorie.Harmonie => "Harmonie",
        BandKategorie.Brassband => "Brassband",
        BandKategorie.Fanfare => "Fanfare",
        BandKategorie.Unterhaltung => "Unterhaltung",
        BandKategorie.JugendmusikHarmonie => "Jugendmusik Harmonie",
        BandKategorie.JugendmusikBrassband => "Jugendmusik Brassband",
        BandKategorie.Blaeserensemble => "Bläserensemble",
        _ => "Sonstige"
    };

    private static string KlasseLabel(Staerkeklasse k) => k switch
    {
        Staerkeklasse.Hoechstklasse => "Höchstklasse",
        Staerkeklasse.Elite => "Elite",
        Staerkeklasse.Klasse1 => "1. Klasse",
        Staerkeklasse.Klasse2 => "2. Klasse",
        Staerkeklasse.Klasse3 => "3. Klasse",
        Staerkeklasse.Klasse4 => "4. Klasse",
        Staerkeklasse.Oberstufe => "Oberstufe",
        Staerkeklasse.Mittelstufe => "Mittelstufe",
        Staerkeklasse.Unterstufe => "Unterstufe",
        _ => k.ToString()
    };

    private record Zeile(Guid Id, string Name, BandKategorie? Kategorie, Staerkeklasse? Klasse,
        string? Land, int Mitglieder, int Videos, string? Ort, double? Lat, double? Lng)
    {
        public double? Distanz { get; set; }   // je Bezugspunkt berechnet
    }
}

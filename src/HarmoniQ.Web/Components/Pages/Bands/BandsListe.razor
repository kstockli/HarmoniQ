@page "/bands"
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Services
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@inject GeocodingService Geo
@inject ISnackbar Snackbar

<PageTitle>Bands – HarmoniQ</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Style="color:#D4AF37;">Bands & Ensembles</MudText>

@if (_alle == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_alle.Count == 0)
{
    <MudAlert Severity="Severity.Info">Noch keine Bands erfasst.</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="background:#1a0030; border:1px solid #3a1060;">
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="_suche" @bind-Value:after="Filtern" Label="Suchen (Name)"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudSelect T="BandKategorie?" @bind-Value="_kategorie" @bind-Value:after="Filtern"
                           Label="Kategorie" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    @foreach (var k in Enum.GetValues<BandKategorie>())
                    {
                        <MudSelectItem T="BandKategorie?" Value="@k">@KategorieLabel(k)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudSelect T="Staerkeklasse?" @bind-Value="_klasse" @bind-Value:after="Filtern"
                           Label="Stärkeklasse" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    @foreach (var s in Enum.GetValues<Staerkeklasse>())
                    {
                        <MudSelectItem T="Staerkeklasse?" Value="@s">@KlasseLabel(s)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        @* Bands in der Nähe: Bezugspunkt via Standort ODER PLZ, dann Umkreis (wie Konzerte). *@
        <MudDivider Class="my-2" Style="border-color:#3a1060;" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudIcon Icon="@Icons.Material.Filled.NearMe" Style="color:#1ABC9C;" />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Style="color:#1ABC9C;border-color:#1ABC9C;"
                       StartIcon="@Icons.Material.Filled.MyLocation" OnClick="MeinStandort" Disabled="_standortLaeuft">
                @(_standortLaeuft ? "…" : "Mein Standort")
            </MudButton>
            <MudTextField @bind-Value="_plz" Label="oder PLZ" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Style="max-width:120px;" Immediate="true" />
            <MudButton Size="Size.Small" OnClick="PlzAnwenden" Disabled="@(string.IsNullOrWhiteSpace(_plz))">Anwenden</MudButton>
            <MudSelect T="int?" @bind-Value="_radiusKm" @bind-Value:after="Filtern" Label="Umkreis"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:130px;">
                <MudSelectItem T="int?" Value="10">≤ 10 km</MudSelectItem>
                <MudSelectItem T="int?" Value="25">≤ 25 km</MudSelectItem>
                <MudSelectItem T="int?" Value="50">≤ 50 km</MudSelectItem>
                <MudSelectItem T="int?" Value="100">≤ 100 km</MudSelectItem>
            </MudSelect>
            @if (_refLat is not null)
            {
                <MudChip T="string" Size="Size.Small" Style="color:#1ABC9C;" OnClose="StandortZuruecksetzen">Bezugspunkt gesetzt</MudChip>
            }
            else
            {
                <MudText Typo="Typo.caption" Style="color:#6f5a86;">für „in der Nähe": Standort freigeben oder PLZ eingeben</MudText>
            }
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2" Style="color:#A78FC0;">@_gefiltert.Count von @_alle.Count Bands</MudText>
    </MudPaper>

    <MudDataGrid T="Zeile" Items="_gefiltert" Hover="true" Dense="true" SortMode="SortMode.Single" Style="background:#1a0030;">
        <Columns>
            <TemplateColumn Title="Name" SortBy="@(z => z.Name)">
                <CellTemplate>
                    <MudLink Href="@($"/bands/{context.Item.Id}")" Style="color:#F0E6FF;font-weight:500;"
                             Underline="Underline.Hover">@context.Item.Name</MudLink>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Kategorie" SortBy="@(z => z.Kategorie.HasValue ? (int)z.Kategorie : 99)">
                <CellTemplate>@(context.Item.Kategorie.HasValue ? KategorieLabel(context.Item.Kategorie.Value) : "—")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Stärkeklasse" SortBy="@(z => z.Klasse.HasValue ? (int)z.Klasse : 99)">
                <CellTemplate>@(context.Item.Klasse.HasValue ? KlasseLabel(context.Item.Klasse.Value) : "—")</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="z => z.Ort" Title="Ort" />
            @if (_refLat is not null)
            {
                <TemplateColumn Title="Entfernung" SortBy="@(z => z.Distanz ?? double.MaxValue)">
                    <CellTemplate>@(context.Item.Distanz is double d ? $"{d:0.#} km" : "–")</CellTemplate>
                </TemplateColumn>
            }
            <PropertyColumn Property="z => z.Land" Title="Land" />
            <PropertyColumn Property="z => z.Mitglieder" Title="Mitglieder" />
            <PropertyColumn Property="z => z.Videos" Title="Videos" />
        </Columns>
    </MudDataGrid>
}

@code {
    private List<Zeile>? _alle;
    private List<Zeile> _gefiltert = [];
    private string _suche = "";
    private BandKategorie? _kategorie;
    private Staerkeklasse? _klasse;
    private double? _refLat, _refLng;   // Bezugspunkt (Standort/PLZ)
    private int? _radiusKm;
    private string _plz = "";
    private bool _standortLaeuft;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _alle = await db.Bands
            .OrderBy(b => b.Name)
            .Select(b => new Zeile(b.Id, b.Name, b.Kategorie, b.Staerkeklasse, b.Land,
                b.Mitgliedschaften.Count, b.Videos.Count(v => v.Status == VideoStatus.Genehmigt),
                b.HeimatLokal != null ? b.HeimatLokal.Name : null,
                b.HeimatLokal != null ? b.HeimatLokal.Lat : null,
                b.HeimatLokal != null ? b.HeimatLokal.Lng : null))
            .ToListAsync();
        Filtern();
    }

    // Beim ersten Render den (aktuelleren) Geo-Standort holen, falls schon freigegeben.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _refLat is not null) return;
        try
        {
            var pos = await JS.InvokeAsync<double[]?>("harmoniqGeo.autoStandort")
                      ?? await JS.InvokeAsync<double[]?>("harmoniqGeo.load");
            if (pos is { Length: 2 }) { await RefSetzen(pos[0], pos[1], speichern: false); StateHasChanged(); }
        }
        catch { /* Geo nicht verfügbar */ }
    }

    private void Filtern()
    {
        var s = _suche.Trim();
        IEnumerable<Zeile> q = _alle!
            .Where(z =>
                (s == "" || z.Name.Contains(s, StringComparison.OrdinalIgnoreCase)) &&
                (_kategorie == null || z.Kategorie == _kategorie) &&
                (_klasse == null || z.Klasse == _klasse));

        if (_refLat is double rlat && _refLng is double rlng)
        {
            var list = q.ToList();
            foreach (var z in list)
                z.Distanz = (z.Lat is double la && z.Lng is double lo) ? Distanz(rlat, rlng, la, lo) : null;
            // Nur Bands mit BEKANNTER Distanz ausserhalb des Umkreises ausblenden; Bands ohne
            // hinterlegten Ort bleiben sichtbar (ohne km), nach Distanz aufsteigend (ohne Ort zuletzt).
            if (_radiusKm is int r)
                list = list.Where(z => z.Distanz is not double d || d <= r).ToList();
            _gefiltert = list.OrderBy(z => z.Distanz ?? double.MaxValue).ThenBy(z => z.Name).ToList();
        }
        else
        {
            _gefiltert = q.OrderBy(z => z.Name).ToList();
        }
    }

    private async Task MeinStandort()
    {
        _standortLaeuft = true;
        var pos = await JS.InvokeAsync<double[]?>("harmoniqGeo.standort");
        _standortLaeuft = false;
        if (pos is { Length: 2 }) { await RefSetzen(pos[0], pos[1]); Snackbar.Add("Standort übernommen.", Severity.Success); }
        else Snackbar.Add("Kein Standort verfügbar (abgelehnt?). Nutze die PLZ-Eingabe.", Severity.Info);
    }

    private async Task PlzAnwenden()
    {
        var res = await Geo.GeocodePlzAsync(_plz);
        if (res is (double la, double lo)) { await RefSetzen(la, lo); Snackbar.Add($"PLZ {_plz.Trim()} übernommen.", Severity.Success); }
        else Snackbar.Add("PLZ nicht gefunden.", Severity.Warning);
    }

    private async Task RefSetzen(double lat, double lng, bool speichern = true)
    {
        _refLat = lat; _refLng = lng;
        _radiusKm ??= 50;
        if (speichern) await JS.InvokeVoidAsync("harmoniqGeo.save", lat, lng);
        Filtern();
    }

    private async Task StandortZuruecksetzen()
    {
        _refLat = _refLng = null;
        _radiusKm = null;
        await JS.InvokeVoidAsync("harmoniqGeo.clear");
        Filtern();
    }

    private static double Distanz(double lat1, double lng1, double lat2, double lng2)
    {
        const double R = 6371.0;
        double Rad(double g) => g * Math.PI / 180.0;
        var dLat = Rad(lat2 - lat1);
        var dLng = Rad(lng2 - lng1);
        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2)
              + Math.Cos(Rad(lat1)) * Math.Cos(Rad(lat2)) * Math.Sin(dLng / 2) * Math.Sin(dLng / 2);
        return R * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
    }

    private static string KategorieLabel(BandKategorie k) => k switch
    {
        BandKategorie.Harmonie => "Harmonie",
        BandKategorie.Brassband => "Brassband",
        BandKategorie.Fanfare => "Fanfare",
        BandKategorie.Unterhaltung => "Unterhaltung",
        BandKategorie.JugendmusikHarmonie => "Jugendmusik Harmonie",
        BandKategorie.JugendmusikBrassband => "Jugendmusik Brassband",
        BandKategorie.Blaeserensemble => "Bläserensemble",
        _ => "Sonstige"
    };

    private static string KlasseLabel(Staerkeklasse k) => k switch
    {
        Staerkeklasse.Hoechstklasse => "Höchstklasse",
        Staerkeklasse.Elite => "Elite",
        Staerkeklasse.Klasse1 => "1. Klasse",
        Staerkeklasse.Klasse2 => "2. Klasse",
        Staerkeklasse.Klasse3 => "3. Klasse",
        Staerkeklasse.Klasse4 => "4. Klasse",
        Staerkeklasse.Oberstufe => "Oberstufe",
        Staerkeklasse.Mittelstufe => "Mittelstufe",
        Staerkeklasse.Unterstufe => "Unterstufe",
        _ => k.ToString()
    };

    private record Zeile(Guid Id, string Name, BandKategorie? Kategorie, Staerkeklasse? Klasse,
        string? Land, int Mitglieder, int Videos, string? Ort, double? Lat, double? Lng)
    {
        public double? Distanz { get; set; }   // je Bezugspunkt berechnet
    }
}

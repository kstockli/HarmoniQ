@page "/bands/{Id:guid}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Services
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<PageTitle>@(_band?.Name ?? "Band") – HarmoniQ</PageTitle>

@if (_band == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 pa-0" />

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-2" Wrap="Wrap.Wrap">
        <MudIcon Icon="@Icons.Material.Filled.Groups" Style="color:#D4AF37;font-size:3rem;" />
        <div>
            <MudText Typo="Typo.h4" Style="color:#D4AF37;">@_band.Name</MudText>
            @if (_band.Land != null)
            {
                <MudText Typo="Typo.body2" Style="color:#A78FC0;">@_band.Land</MudText>
            }
        </div>
    </MudStack>

    <MudStack Row="true" Spacing="2" Class="mb-6" Wrap="Wrap.Wrap">
        @if (_band.Webseite != null)
        {
            <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="@_band.Webseite" Target="_blank"
                       StartIcon="@Icons.Material.Filled.OpenInNew">Webseite</MudButton>
        }
        <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="@($"/stuecke?band={_band.Id}")"
                   StartIcon="@Icons.Material.Filled.MusicNote">Alle Stücke dieser Band</MudButton>
        <RichtigstellungMelden Typ="RichtigstellungTyp.Band" Id="_band.Id" />
    </MudStack>

    @if (_mitglieder.Count > 0)
    {
        <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">
            Besetzung (@_mitglieder.Count)
        </MudText>
        <MudPaper Class="pa-4 mb-6" Style="background:#1a0030; border:1px solid #3a1060;">
            @if (_leitung.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Style="color:#D4AF37;">Leitung</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
                    @foreach (var m in _leitung)
                    {
                        <MudLink Href="@($"/personen/{m.PersonId}")" Style="color:#F0E6FF;" Underline="Underline.Hover">
                            @m.AnzeigeName <MudText Typo="Typo.caption" Style="color:#A78FC0;">(@m.Funktion)</MudText>
                        </MudLink>
                    }
                </MudStack>
            }
            @foreach (var gruppe in _register)
            {
                <MudText Typo="Typo.subtitle2" Style="color:#9B59B6;">@gruppe.Key</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" Class="mb-3">
                    @foreach (var m in gruppe)
                    {
                        <MudLink Href="@($"/personen/{m.PersonId}")" Style="color:#F0E6FF;" Underline="Underline.Hover">
                            @m.AnzeigeName
                        </MudLink>
                    }
                </MudStack>
            }
        </MudPaper>
    }

    @if (_konzerte.Count > 0)
    {
        <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">
            Konzerte (@_konzerte.Count)
        </MudText>
        <MudList T="string" Dense="true" Class="mb-6">
            @foreach (var k in _konzerte)
            {
                <MudListItem T="string" Href="@($"/konzerte/{k.Id}")" Icon="@Icons.Material.Filled.Event"
                             Style="color:#F0E6FF;">
                    @k.Titel
                    <MudText Typo="Typo.caption" Style="color:#A78FC0;">
                        @k.Datum.ToString("dd.MM.yyyy")@(string.IsNullOrWhiteSpace(k.Ort) ? "" : $" · {k.Ort}")
                    </MudText>
                </MudListItem>
            }
        </MudList>
    }

    @if (_videos.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Für diese Band sind noch keine Videos erfasst.</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">
            Aufnahmen (@_videos.Count)
        </MudText>
        <MudGrid Class="mb-6">
            @foreach (var v in _videos)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
                        <MudLink Href="@($"/videos/{v.Id}")">
                            <img src="@($"https://i.ytimg.com/vi/{v.YouTubeVideoId}/hqdefault.jpg")"
                                 style="width:100%;display:block;" alt="@v.Titel" />
                        </MudLink>
                        <MudCardContent>
                            <MudLink Href="@($"/videos/{v.Id}")" Style="color:#F0E6FF;font-weight:500;"
                                     Underline="Underline.Hover">@v.StueckTitel</MudLink>
                            <MudText Typo="Typo.caption" Class="d-block" Style="color:#A78FC0;">@v.Titel</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">
            Gespielte Stücke (@_stuecke.Count)
        </MudText>
        <MudList T="string" Dense="true">
            @foreach (var s in _stuecke)
            {
                <MudListItem T="string" Href="@($"/stuecke/{s.Id}")" Icon="@Icons.Material.Filled.MusicNote"
                             Style="color:#F0E6FF;">
                    @s.Titel <MudText Typo="Typo.caption" Style="color:#A78FC0;">@(s.Jahr.HasValue ? $"({s.Jahr})" : "")</MudText>
                </MudListItem>
            }
        </MudList>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Band? _band;
    private List<VideoZeile> _videos = [];
    private List<StueckZeile> _stuecke = [];
    private List<KonzertZeile> _konzerte = [];
    private List<MitgliedZeile> _mitglieder = [];
    private List<MitgliedZeile> _leitung = [];
    private List<IGrouping<string, MitgliedZeile>> _register = [];

    private List<BreadcrumbItem> _breadcrumbs => _band == null ? [] :
    [
        new("Startseite", "/"),
        new("Bands", "/bands"),
        new(_band.Name, null, disabled: true)
    ];

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _band = await db.Bands.FirstOrDefaultAsync(b => b.Id == Id);
        if (_band == null) { Nav.NavigateTo("/bands"); return; }

        var videos = await db.Videos
            .Where(v => v.BandId == Id && v.Status == VideoStatus.Genehmigt)
            .Include(v => v.Stueck)
            .OrderBy(v => v.Stueck.Titel)
            .ToListAsync();

        _videos = videos.Select(v => new VideoZeile(v.Id, v.YouTubeVideoId, v.Titel, v.StueckId, v.Stueck.Titel)).ToList();

        _stuecke = videos
            .Select(v => v.Stueck)
            .DistinctBy(s => s.Id)
            .OrderBy(s => s.Titel)
            .Select(s => new StueckZeile(s.Id, s.Titel, s.Jahr))
            .ToList();

        _konzerte = await db.KonzertBands
            .Where(kb => kb.BandId == Id)
            .OrderByDescending(kb => kb.Konzert.Datum)
            .Select(kb => new KonzertZeile(kb.KonzertId, kb.Konzert.Datum, kb.Konzert.Name, kb.Konzert.Ort))
            .ToListAsync();

        var mitglieder = await db.BandMitgliedschaften
            .Where(m => m.BandId == Id && m.BisJahr == null)
            .Include(m => m.Person)
            .Include(m => m.Instrument)
            .ToListAsync();

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var vollSichtbar = await PersonenSicht.LadeVollSichtbareAsync(db, userId);

        _mitglieder = mitglieder
            .Select(m =>
            {
                var eff = PersonenSicht.Effektiv(m.PersonId, m.Person.Sichtbarkeit, vollSichtbar);
                return new MitgliedZeile(m.PersonId,
                    PersonenSicht.AnzeigeName(m.Person.Name, eff), m.Instrument?.Name, m.Funktion);
            })
            .OrderBy(m => m.AnzeigeName)
            .ToList();

        // Anzeige-Gruppen: Leitung (mit Funktion) zuerst, dann nach Instrument.
        _leitung = _mitglieder.Where(m => m.Funktion != null).ToList();
        _register = _mitglieder
            .Where(m => m.Funktion == null)
            .GroupBy(m => m.Instrument ?? "Ohne Instrument")
            .OrderBy(g => g.Key)
            .ToList();
    }

    private record VideoZeile(Guid Id, string YouTubeVideoId, string Titel, Guid StueckId, string StueckTitel);
    private record StueckZeile(Guid Id, string Titel, int? Jahr);
    private record KonzertZeile(Guid Id, DateOnly Datum, string? Name, string? Ort)
    {
        public string Titel => Name ?? Datum.ToString("dd.MM.yyyy");
    }
    private record MitgliedZeile(Guid PersonId, string AnzeigeName, string? Instrument, string? Funktion);
}

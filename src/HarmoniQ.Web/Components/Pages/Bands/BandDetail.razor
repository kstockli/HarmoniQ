@page "/bands/{Id:guid}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Services
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar

<PageTitle>@(_band?.Name ?? "Band") – HarmoniQ</PageTitle>

@if (_band == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 pa-0" />

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-2" Wrap="Wrap.Wrap">
        @if (!string.IsNullOrWhiteSpace(_band.BildUrl))
        {
            <img src="@_band.BildUrl" style="width:64px;height:64px;object-fit:cover;border-radius:8px;" alt="@_band.Name" />
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.Groups" Style="color:#D4AF37;font-size:3rem;" />
        }
        <div>
            <MudText Typo="Typo.h4" Style="color:#D4AF37;">@_band.Name</MudText>
            <MudStack Row="true" Spacing="1" Class="mt-1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                @if (_band.Kategorie.HasValue)
                {
                    <MudChip T="string" Size="Size.Small" Style="background:#2d1657; color:#D4AF37;">@KategorieLabel(_band.Kategorie.Value)</MudChip>
                }
                @if (_band.Staerkeklasse.HasValue)
                {
                    <MudChip T="string" Size="Size.Small" Style="background:#2d1657; color:#A78FC0;">@KlasseLabel(_band.Staerkeklasse.Value)</MudChip>
                }
                @if (_band.Land != null)
                {
                    <MudText Typo="Typo.body2" Style="color:#A78FC0;">@_band.Land</MudText>
                }
                @if (_band.Gruendungsjahr.HasValue)
                {
                    <MudText Typo="Typo.body2" Style="color:#A78FC0;">· gegr. @_band.Gruendungsjahr</MudText>
                }
            </MudStack>
            @if (_aliase.Count > 0)
            {
                <MudText Typo="Typo.caption" Style="color:#6f5a86;">auch: @string.Join(", ", _aliase)</MudText>
            }
        </div>
    </MudStack>

    @* „Band folgen" (UX-Spec 4.2): private Fan-Beziehung für die Wiederkehr-Schleife. *@
    @if (_personId != null && !_istMitglied)
    {
        <MudButton Class="mb-4" Variant="@(_folgt ? Variant.Outlined : Variant.Filled)"
                   Style="@(_folgt ? "color:#1ABC9C;border-color:#1ABC9C;" : "background:#1ABC9C;color:#0e0018;")"
                   StartIcon="@(_folgt ? Icons.Material.Filled.NotificationsActive : Icons.Material.Filled.NotificationsNone)"
                   OnClick="FolgenUmschalten" Disabled="_folgenLaeuft">
            @(_folgt ? "Folge ich" : "Band folgen")
        </MudButton>
    }
    else if (_istMitglied)
    {
        <MudChip T="string" Class="mb-4" Icon="@Icons.Material.Filled.Groups"
                 Style="background:#103d36; color:#1ABC9C;">
            Du spielst in dieser Band – du erhältst ihre Neuigkeiten automatisch.
        </MudChip>
    }

    @if (!string.IsNullOrWhiteSpace(_band.Geschichte))
    {
        <MudText Typo="Typo.body1" Class="mb-4" Style="color:#C4B0D8;">@_band.Geschichte</MudText>
    }

    <MudStack Row="true" Spacing="2" Class="mb-6" Wrap="Wrap.Wrap">
        @if (_band.Webseite != null)
        {
            <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="@_band.Webseite" Target="_blank"
                       StartIcon="@Icons.Material.Filled.OpenInNew">Webseite</MudButton>
        }
        @if (_band.YouTube != null)
        {
            <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="@_band.YouTube" Target="_blank"
                       StartIcon="@Icons.Material.Filled.SmartDisplay">YouTube</MudButton>
        }
        @if (_band.Instagram != null)
        {
            <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="@_band.Instagram" Target="_blank"
                       StartIcon="@Icons.Material.Filled.CameraAlt">Instagram</MudButton>
        }
        @if (_band.X != null)
        {
            <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="@_band.X" Target="_blank"
                       StartIcon="@Icons.Material.Filled.AlternateEmail">X</MudButton>
        }
        @if (_band.Facebook != null)
        {
            <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="@_band.Facebook" Target="_blank"
                       StartIcon="@Icons.Material.Filled.Public">Facebook</MudButton>
        }
        @if (_band.Wikipedia != null)
        {
            <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="@_band.Wikipedia" Target="_blank"
                       StartIcon="@Icons.Material.Filled.MenuBook">Wikipedia</MudButton>
        }
        @if (_band.EMail != null)
        {
            <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="@($"mailto:{_band.EMail}")"
                       StartIcon="@Icons.Material.Filled.Email">E-Mail</MudButton>
        }
        @if (_band.Mobile != null)
        {
            <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="@($"tel:{_band.Mobile}")"
                       StartIcon="@Icons.Material.Filled.Phone">Telefon</MudButton>
        }
        <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="@($"/stuecke?band={_band.Id}")"
                   StartIcon="@Icons.Material.Filled.MusicNote">Alle Stücke dieser Band</MudButton>
        <RichtigstellungMelden Typ="RichtigstellungTyp.Band" Id="_band.Id" />
    </MudStack>

    @* Imagefilm der Band (YouTube oder direkte Datei) – prominent, eingebettet. *@
    @if (_imagefilmUrl != null)
    {
        <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">Imagefilm</MudText>
        <div style="max-width:820px;position:relative;aspect-ratio:16/9;overflow:hidden;border-radius:10px;border:1px solid #3a1060;background:#000;" class="mb-6">
            @if (_imagefilmDatei)
            {
                <video src="@_imagefilmUrl" controls preload="metadata"
                       style="position:absolute;inset:0;width:100%;height:100%;border:0;background:#000;" title="Imagefilm"></video>
            }
            else
            {
                <iframe src="@_imagefilmUrl"
                        style="position:absolute;inset:0;width:100%;height:100%;border:0;"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen title="Imagefilm"></iframe>
            }
        </div>
    }

    @* 1. Konzerte *@
    @if (_konzerte.Count > 0)
    {
        <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">
            Konzerte (@_konzerte.Count)
        </MudText>
        <MudList T="string" Dense="true" Class="mb-6">
            @foreach (var k in _konzerte)
            {
                <MudListItem T="string" Href="@($"/konzerte/{k.Id}")" Icon="@Icons.Material.Filled.Event"
                             Style="color:#F0E6FF;">
                    @k.Titel
                    <MudText Typo="Typo.caption" Style="color:#A78FC0;">
                        @KonzertZeitFormat.Kompakt(k.Datum, k.Uhrzeit)@(string.IsNullOrWhiteSpace(k.Ort) ? "" : $" · {k.Ort}")
                    </MudText>
                </MudListItem>
            }
        </MudList>
    }

    @* 2. Aufnahmen (Videos) *@
    @if (_videos.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-6">Für diese Band sind noch keine Videos erfasst.</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">
            Aufnahmen (@_videos.Count)
        </MudText>
        <MudGrid Class="mb-6">
            @foreach (var v in _videos)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
                        <MudLink Href="@($"/videos/{v.Id}")">
                            <VideoVorschau Plattform="@v.Plattform" ExternId="@v.ExternId" BildUrl="@v.BildUrl"
                                           Style="width:100%;display:block;" Alt="@v.Titel" />
                        </MudLink>
                        <MudCardContent>
                            <MudLink Href="@($"/videos/{v.Id}")" Style="color:#F0E6FF;font-weight:500;"
                                     Underline="Underline.Hover">@v.StueckTitel</MudLink>
                            <MudText Typo="Typo.caption" Class="d-block" Style="color:#A78FC0;">@v.Titel</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

    @* 3. Gespielte Stücke (Videos ∪ Konzertprogramme) *@
    @if (_stuecke.Count > 0)
    {
        <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">
            Gespielte Stücke (@_stuecke.Count)
        </MudText>
        <StueckZeilen ZusatzTitel="Jahr" Stuecke="@_stuecke.Select(s => new StueckZeilen.StueckRef(
            s.Id, s.Titel, s.Jahr?.ToString())).ToList()" />
    }

    @* 4. Besetzung (Mitglieder) *@
    @if (_mitglieder.Count > 0)
    {
        <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">
            Besetzung (@_mitglieder.Count)
        </MudText>
        <MudPaper Class="pa-4 mb-6" Style="background:#1a0030; border:1px solid #3a1060;">
            @if (_leitung.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Style="color:#D4AF37;">Leitung</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
                    @foreach (var m in _leitung)
                    {
                        <MudLink Href="@($"/personen/{m.PersonId}")" Style="color:#F0E6FF;" Underline="Underline.Hover">
                            @m.AnzeigeName <MudText Typo="Typo.caption" Style="color:#A78FC0;">(@m.Funktion)</MudText>
                        </MudLink>
                    }
                </MudStack>
            }
            @foreach (var gruppe in _register)
            {
                <MudText Typo="Typo.subtitle2" Style="color:#9B59B6;">@gruppe.Key</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" Class="mb-3">
                    @foreach (var m in gruppe)
                    {
                        <MudLink Href="@($"/personen/{m.PersonId}")" Style="color:#F0E6FF;" Underline="Underline.Hover">
                            @m.AnzeigeName
                        </MudLink>
                    }
                </MudStack>
            }
        </MudPaper>
    }

    @* 5. Ehemalige Besetzung *@
    @if (_ehemalige.Count > 0)
    {
        <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#9B59B6;">
            Ehemalige Besetzung (@_ehemalige.Count)
        </MudText>
        <MudPaper Class="pa-4 mb-6" Style="background:#1a0030; border:1px solid #3a1060;">
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3">
                @foreach (var m in _ehemalige)
                {
                    <MudLink Href="@($"/personen/{m.PersonId}")" Style="color:#C4B0D8;" Underline="Underline.Hover">
                        @m.AnzeigeName
                        <MudText Typo="Typo.caption" Style="color:#6f5a86;">
                            @(m.Funktion ?? m.Instrument)@(string.IsNullOrEmpty(m.Zeitraum) ? "" : $" · {m.Zeitraum}")
                        </MudText>
                    </MudLink>
                }
            </MudStack>
        </MudPaper>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Band? _band;
    private string? _imagefilmUrl;   // Embed-/Datei-URL des Imagefilms (null = keiner)
    private bool _imagefilmDatei;    // true = direkte Datei (<video>), false = iframe
    private Guid? _personId;
    private bool _folgt;
    private bool _istMitglied;
    private bool _folgenLaeuft;
    private List<string> _aliase = [];
    private List<VideoZeile> _videos = [];
    private List<StueckZeile> _stuecke = [];
    private List<KonzertZeile> _konzerte = [];

    private static string KategorieLabel(BandKategorie k) => k switch
    {
        BandKategorie.Harmonie => "Harmonie",
        BandKategorie.Brassband => "Brassband",
        BandKategorie.Fanfare => "Fanfare",
        BandKategorie.Unterhaltung => "Unterhaltung",
        BandKategorie.JugendmusikHarmonie => "Jugendmusik Harmonie",
        BandKategorie.JugendmusikBrassband => "Jugendmusik Brassband",
        BandKategorie.Blaeserensemble => "Bläserensemble",
        _ => "Sonstige"
    };
    private static string KlasseLabel(Staerkeklasse k) => k switch
    {
        Staerkeklasse.Hoechstklasse => "Höchstklasse",
        Staerkeklasse.Elite => "Elite",
        Staerkeklasse.Klasse1 => "1. Klasse",
        Staerkeklasse.Klasse2 => "2. Klasse",
        Staerkeklasse.Klasse3 => "3. Klasse",
        Staerkeklasse.Klasse4 => "4. Klasse",
        Staerkeklasse.Oberstufe => "Oberstufe",
        Staerkeklasse.Mittelstufe => "Mittelstufe",
        Staerkeklasse.Unterstufe => "Unterstufe",
        _ => k.ToString()
    };
    private List<MitgliedZeile> _mitglieder = [];
    private List<MitgliedZeile> _ehemalige = [];
    private List<MitgliedZeile> _leitung = [];
    private List<IGrouping<string, MitgliedZeile>> _register = [];

    private List<BreadcrumbItem> _breadcrumbs => _band == null ? [] :
    [
        new("Startseite", "/"),
        new("Bands", "/bands"),
        new(_band.Name, null, disabled: true)
    ];

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _band = await db.Bands.Include(b => b.Links).FirstOrDefaultAsync(b => b.Id == Id);
        // Imagefilm-URL (YouTube oder Datei) in eine einbettbare Form auflösen.
        _imagefilmUrl = null; _imagefilmDatei = false;
        if (_band != null && VideoQuelle.Parse(_band.Imagefilm) is { } iq)
        {
            _imagefilmUrl = VideoEinbettung.Embed(iq.Plattform, iq.ExternId);
            _imagefilmDatei = VideoEinbettung.IstDatei(iq.Plattform);
        }
        if (_band == null) { Nav.NavigateTo("/bands"); return; }

        _aliase = await db.BandAliase.Where(a => a.BandId == Id).OrderBy(a => a.Name)
            .Select(a => a.Name).ToListAsync();

        var videos = await db.Videos
            .Where(v => v.BandId == Id && v.Status == VideoStatus.Genehmigt)
            .Include(v => v.Stueck)
            .OrderBy(v => v.Stueck.Titel)
            .ToListAsync();

        _videos = videos.Select(v => new VideoZeile(v.Id, v.Plattform, v.ExternId, v.Titel, v.StueckId, v.Stueck.Titel, v.BildUrl)).ToList();

        // Gespielte Stücke = aus Videos UND aus Konzertprogrammen dieser Band (Union, ohne Dubletten).
        var konzertStuecke = await db.KonzertStuecke
            .Where(ks => ks.BandId == Id)
            .Select(ks => ks.Stueck)
            .ToListAsync();
        _stuecke = videos.Select(v => v.Stueck)
            .Concat(konzertStuecke)
            .DistinctBy(s => s.Id)
            .OrderBy(s => s.Titel)
            .Select(s => new StueckZeile(s.Id, s.Titel, s.Jahr))
            .ToList();

        _konzerte = await db.KonzertBands
            .Where(kb => kb.BandId == Id)
            .OrderByDescending(kb => kb.Konzert.Datum)
            .Select(kb => new KonzertZeile(kb.KonzertId, kb.Konzert.Datum, kb.Konzert.Uhrzeit, kb.Konzert.Name, kb.Konzert.Ort))
            .ToListAsync();

        var mitglieder = await db.BandMitgliedschaften
            .Where(m => m.BandId == Id)
            .Include(m => m.Person)
            .Include(m => m.Instrument)
            .ToListAsync();

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        // Folgen-Status (UX-Spec 4.2): nur für die verknüpfte Person; Mitgliedschaft impliziert Folgen.
        _personId = await BandFolgenService.PersonIdAsync(db, userId);
        if (_personId is { } pid)
        {
            _istMitglied = await BandFolgenService.IstMitgliedAsync(db, pid, Id);
            _folgt = !_istMitglied && await BandFolgenService.FolgtAsync(db, pid, Id);
        }

        var vollSichtbar = await PersonenSicht.LadeVollSichtbareAsync(db, userId);
        var heuer = DateTime.Now.Year;

        // Ehemalig = Bis-Jahr gesetzt und kleiner als das aktuelle Jahr.
        var aktiv = mitglieder.Where(m => !(m.BisJahr.HasValue && m.BisJahr < heuer)).ToList();
        var ehemalig = mitglieder.Where(m => m.BisJahr.HasValue && m.BisJahr < heuer).ToList();

        MitgliedZeile Bau(BandMitgliedschaft m)
        {
            var eff = PersonenSicht.Effektiv(m.PersonId, m.Person.Sichtbarkeit, vollSichtbar);
            return new MitgliedZeile(m.PersonId, PersonenSicht.AnzeigeName(m.Person.Name, eff),
                m.Instrument?.Name, m.Funktion, m.VonJahr, m.BisJahr);
        }

        _mitglieder = aktiv.Select(Bau).OrderBy(m => m.AnzeigeName).ToList();
        _ehemalige = ehemalig.Select(Bau).OrderBy(m => m.AnzeigeName).ToList();

        // Anzeige-Gruppen: Leitung (mit Funktion) zuerst, dann nach Instrument.
        _leitung = _mitglieder.Where(m => m.Funktion != null).ToList();
        _register = _mitglieder
            .Where(m => m.Funktion == null)
            .GroupBy(m => m.Instrument ?? "Ohne Instrument")
            .OrderBy(g => g.Key)
            .ToList();
    }

    private async Task FolgenUmschalten()
    {
        if (_personId is not { } pid || _folgenLaeuft) return;
        _folgenLaeuft = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        _folgt = await BandFolgenService.UmschaltenAsync(db, pid, Id);
        _folgenLaeuft = false;
        Snackbar.Add(_folgt ? $"Du folgst „{_band?.Name}\" jetzt." : $"Du folgst „{_band?.Name}\" nicht mehr.",
            _folgt ? Severity.Success : Severity.Info);
    }

    private record VideoZeile(Guid Id, VideoPlattform Plattform, string ExternId, string Titel, Guid StueckId, string StueckTitel, string? BildUrl);
    private record StueckZeile(Guid Id, string Titel, int? Jahr);
    private record KonzertZeile(Guid Id, DateOnly Datum, TimeOnly? Uhrzeit, string? Name, string? Ort)
    {
        public string Titel => Name ?? Datum.ToString("dd.MM.yyyy");
    }
    private record MitgliedZeile(Guid PersonId, string AnzeigeName, string? Instrument, string? Funktion,
        int? VonJahr, int? BisJahr)
    {
        public string Zeitraum => (VonJahr, BisJahr) switch
        {
            (null, null) => "",
            (var v, null) => $"seit {v}",
            (null, var b) => $"bis {b}",
            var (v, b) => $"{v}–{b}"
        };
    }
}

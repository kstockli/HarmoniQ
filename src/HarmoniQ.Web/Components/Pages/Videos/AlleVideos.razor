@page "/videos"
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Videos – HarmoniQ</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Style="color:#D4AF37;">Videos</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2" Style="background:#1a0030; border:1px solid #3a1060;">
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" md="4">
            <MudTextField @bind-Value="_suche" @bind-Value:after="Filtern"
                          Label="Suchen (Titel / Stück)" Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudAutocomplete T="string" @bind-Value="_bandText" @bind-Value:after="Filtern"
                             Label="Band" Variant="Variant.Outlined" Clearable="true"
                             SearchFunc="SucheBand" CoerceValue="true" ResetValueOnEmptyText="true"
                             MaxItems="20" Immediate="true"
                             AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudAutocomplete T="string" @bind-Value="_komponistText" @bind-Value:after="Filtern"
                             Label="Komponist" Variant="Variant.Outlined" Clearable="true"
                             SearchFunc="SucheKomponist" CoerceValue="true" ResetValueOnEmptyText="true"
                             MaxItems="20" Immediate="true"
                             AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" />
        </MudItem>
    </MudGrid>
    <MudText Typo="Typo.caption" Class="mt-2" Style="color:#A78FC0;">@_gefiltert.Count von @_alle.Count Videos</MudText>
</MudPaper>

<MudGrid>
    @foreach (var v in _gefiltert)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
                <MudLink Href="@($"/videos/{v.Id}")">
                    <div style="position:relative;">
                        <img src="@VideoEinbettung.Thumbnail(v.Plattform, v.ExternId)"
                             style="width:100%;display:block;" alt="@v.Titel" />
                        <MudIcon Icon="@Icons.Material.Filled.PlayCircle"
                                 Style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:#fff;opacity:0.85;"
                                 Size="Size.Large" />
                    </div>
                </MudLink>
                <MudCardContent>
                    <MudLink Href="@($"/videos/{v.Id}")" Style="color:#F0E6FF;font-weight:500;"
                             Underline="Underline.Hover">@v.StueckTitel</MudLink>
                    <MudText Typo="Typo.caption" Class="d-block" Style="color:#A78FC0;">@v.KomponistName</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Style="color:#9B59B6;" />
                        <MudLink Href="@($"/bands/{v.BandId}")" Typo="Typo.body2" Style="color:#9B59B6;"
                                 Underline="Underline.Hover">@v.BandName</MudLink>
                        @if (v.BandLand != null)
                        {
                            <MudText Typo="Typo.caption" Style="color:#A78FC0;">· @v.BandLand</MudText>
                        }
                    </MudStack>
                    @if (v.Anzahl > 0)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-2">
                            <MudText Typo="Typo.body2" Style="color:#D4AF37;">@v.Schnitt.ToString("0.0")</MudText>
                            <MudRating ReadOnly="true" SelectedValue="@((int)Math.Round(v.Schnitt))" MaxValue="5" Size="Size.Small" />
                            <MudText Typo="Typo.caption" Style="color:#A78FC0;">(@v.Anzahl)</MudText>
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mt-2 d-block" Style="color:#A78FC0;">Noch keine Bewertungen</MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    [SupplyParameterFromQuery(Name = "band")] public Guid? BandQuery { get; set; }

    private List<Zeile> _alle = [];
    private List<Zeile> _gefiltert = [];
    private List<string> _bandNamen = [];
    private List<string> _komponisten = [];

    private string _suche = "";
    private string? _bandText;
    private string? _komponistText;

    // Einheitliches Filter-Muster (wie /stuecke, /personen): tippen → Vorschläge → wählen,
    // ODER unvollständigen Text als LIKE stehen lassen (CoerceValue).
    private Task<IEnumerable<string>> SucheBand(string? wert, CancellationToken ct)
    {
        IEnumerable<string> r = string.IsNullOrWhiteSpace(wert)
            ? _bandNamen : _bandNamen.Where(n => n.Contains(wert, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(r.Take(20));
    }

    private Task<IEnumerable<string>> SucheKomponist(string? wert, CancellationToken ct)
    {
        IEnumerable<string> r = string.IsNullOrWhiteSpace(wert)
            ? _komponisten : _komponisten.Where(n => n.Contains(wert, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(r.Take(20));
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _bandNamen = await db.Bands.OrderBy(b => b.Name).Select(b => b.Name).ToListAsync();
        _komponisten = await db.Personen
            .Where(p => p.Rollen.Any(r => r.Rolle == PersonRolleTyp.Komponist))
            .OrderBy(p => p.Name).Select(p => p.Name).ToListAsync();

        var schnitte = await db.Bewertungen
            .GroupBy(b => b.VideoId)
            .Select(g => new { VideoId = g.Key, Anzahl = g.Count(), Schnitt = g.Average(b => b.GesamtEindruck) })
            .ToDictionaryAsync(x => x.VideoId);

        var videos = await db.Videos
            .Where(v => v.Status == VideoStatus.Genehmigt)
            .Include(v => v.Band)
            .Include(v => v.Stueck).ThenInclude(s => s.Beitraege).ThenInclude(b => b.Person)
            .ToListAsync();

        _alle = videos.Select(v => new Zeile(
            v.Id, v.Plattform, v.ExternId, v.Titel,
            v.StueckId, v.Stueck.Titel,
            // Anzeige = Komponisten-Text; Suche = Text + zugeordnete Personen-Namen (Text-Like statt Dropdown).
            v.Stueck.KomponistenText,
            string.Join(" ", new[] { v.Stueck.KomponistenText ?? "" }
                .Concat(v.Stueck.Komponisten.Select(p => p.Name))).ToLowerInvariant(),
            v.BandId, v.Band?.Name ?? "Unbekannt", v.Band?.Land,
            schnitte.TryGetValue(v.Id, out var s) ? s.Anzahl : 0,
            schnitte.TryGetValue(v.Id, out var s2) ? s2.Schnitt : 0
        )).OrderBy(z => z.StueckTitel).ToList();

        // Vorbelegung aus ?band= (Guid → Name) für den Text-Filter.
        if (BandQuery is { } bq)
            _bandText = await db.Bands.Where(b => b.Id == bq).Select(b => b.Name).FirstOrDefaultAsync();
        Filtern();
    }

    private void Filtern()
    {
        _gefiltert = _alle
            .Where(z =>
                (string.IsNullOrWhiteSpace(_bandText)
                    || z.BandName.Contains(_bandText, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(_komponistText)
                    || z.KomponistSuche.Contains(_komponistText.ToLowerInvariant())) &&
                (_suche == "" || z.StueckTitel.Contains(_suche, StringComparison.OrdinalIgnoreCase)
                              || z.Titel.Contains(_suche, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    private record Zeile(Guid Id, VideoPlattform Plattform, string ExternId, string Titel,
        Guid StueckId, string StueckTitel, string? KomponistName, string KomponistSuche,
        Guid? BandId, string BandName, string? BandLand, int Anzahl, double Schnitt);
}

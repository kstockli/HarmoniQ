@page "/account/profil"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Components.Shared
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Meine Beiträge – HarmoniQ</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Style="color:#D4AF37;">Meine Beiträge</MudText>

@* ── Meine Vorschläge (Status) ─────────────────────────────────────────── *@
@if (_vorschlaege == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_vorschlaege.Count > 0)
{
    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#D4AF37;">Meine Vorschläge (@_vorschlaege.Count)</MudText>
    <MudList T="string" Dense="true" Class="mb-6">
        @foreach (var v in _vorschlaege)
        {
            <MudListItem T="string" Href="@($"/stuecke/{v.StueckId}")" Icon="@v.Icon" Style="color:#F0E6FF;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <div style="flex:1;min-width:0;">
                        @v.Titel
                        <MudText Typo="Typo.caption" Class="d-block" Style="color:#A78FC0;">@v.Subtitel</MudText>
                    </div>
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(v.Status)" Variant="Variant.Outlined">
                        @StatusLabel(v.Status)
                    </MudChip>
                </MudStack>
            </MudListItem>
        }
    </MudList>
}

<MudText Typo="Typo.h5" Class="mb-2" Style="color:#D4AF37;">Meine Bewertungen</MudText>

@if (_zeilen == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_zeilen.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-2">
        Du hast noch keine Aufnahmen bewertet. Stöbere durch die
        <MudLink Href="/stuecke" Style="color:#D4AF37;">Stücke</MudLink> und gib deine erste Bewertung ab!
    </MudAlert>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-4" Style="color:#A78FC0;">
        @_zeilen.Count Bewertung@(_zeilen.Count == 1 ? "" : "en")
    </MudText>

    <MudGrid>
        @foreach (var z in _zeilen)
        {
            <MudItem xs="12" md="6">
                <MudCard Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
                    <MudCardContent>
                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start">
                            <MudLink Href="@($"/stuecke/{z.StueckId}")" Style="flex-shrink:0;">
                                <img src="@($"https://i.ytimg.com/vi/{z.YouTubeVideoId}/mqdefault.jpg")"
                                     style="width:120px;border-radius:8px;display:block;" alt="@z.StueckTitel" />
                            </MudLink>
                            <div style="flex:1;min-width:0;">
                                <MudLink Href="@($"/stuecke/{z.StueckId}")" Style="color:#F0E6FF;font-weight:600;"
                                         Underline="Underline.Hover">@z.StueckTitel</MudLink>
                                <MudText Typo="Typo.caption" Class="d-block" Style="color:#A78FC0;">@z.BandName</MudText>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                                    <MudRating ReadOnly="true" SelectedValue="z.GesamtEindruck" MaxValue="5" Size="Size.Small" />
                                    <MudText Typo="Typo.caption" Style="color:#A78FC0;">Gesamt</MudText>
                                </MudStack>
                            </div>
                        </MudStack>

                        <MudDivider Class="my-3" Style="border-color:#3a1060;" />

                        <BewertungsBalken Label="Präzision" Wert="z.Praezision" />
                        <BewertungsBalken Label="Musikalität" Wert="z.Musikalitaet" />
                        <BewertungsBalken Label="Akustik" Wert="z.AkustischeQualitaet" />
                        <BewertungsBalken Label="Videobild" Wert="z.VideoQualitaet" />

                        @if (!string.IsNullOrWhiteSpace(z.Kommentar))
                        {
                            <MudText Typo="Typo.body2" Class="mt-3" Style="color:#C4B0D8;font-style:italic;">
                                „@z.Kommentar"
                            </MudText>
                        }
                        <MudText Typo="Typo.caption" Class="mt-2 d-block" Style="color:#6f5a86;">
                            bewertet am @z.ErstelltAm.ToString("dd.MM.yyyy")
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<Zeile>? _zeilen;
    private List<VorschlagZeile>? _vorschlaege;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId == null) { _zeilen = []; _vorschlaege = []; return; }

        await using var db = await DbFactory.CreateDbContextAsync();

        // Eigene Video-Vorschläge.
        var videos = await db.Videos
            .Where(v => v.VorgeschlagenVonId == userId)
            .OrderByDescending(v => v.ErstelltAm)
            .Select(v => new { v.StueckId, StueckTitel = v.Stueck.Titel, v.Status })
            .ToListAsync();

        // Eigene Mitwirkungs-Vorschläge.
        var mitwirkungen = await db.VideoMitwirkungen
            .Where(m => m.VorgeschlagenVonId == userId)
            .Select(m => new
            {
                m.Video.StueckId,
                StueckTitel = m.Video.Stueck.Titel,
                PersonName = m.Person.Name,
                m.Rolle,
                InstrumentName = m.Instrument != null ? m.Instrument.Name : null,
                m.Status
            })
            .ToListAsync();

        _vorschlaege =
            videos.Select(v => new VorschlagZeile(
                v.StueckId, v.StueckTitel, "Video-Vorschlag",
                Icons.Material.Filled.VideoLibrary, v.Status))
            .Concat(mitwirkungen.Select(m => new VorschlagZeile(
                m.StueckId, m.StueckTitel,
                $"Besetzung: {m.PersonName}" +
                    (m.Rolle == MitwirkungRolle.Dirigent ? " (Dirigent:in)"
                     : m.InstrumentName != null ? $" ({m.InstrumentName})" : ""),
                Icons.Material.Filled.GroupAdd, m.Status)))
            .ToList();

        _zeilen = await db.Bewertungen
            .Where(b => b.BenutzerId == userId)
            .Include(b => b.Video).ThenInclude(v => v.Stueck)
            .Include(b => b.Video).ThenInclude(v => v.Band)
            .OrderByDescending(b => b.ErstelltAm)
            .Select(b => new Zeile(
                b.Video.StueckId,
                b.Video.Stueck.Titel,
                b.Video.YouTubeVideoId,
                b.Video.Band != null ? b.Video.Band.Name : "Unbekannte Band",
                b.GesamtEindruck, b.Praezision, b.Musikalitaet,
                b.AkustischeQualitaet, b.VideoQualitaet, b.Kommentar, b.ErstelltAm))
            .ToListAsync();
    }

    private record Zeile(Guid StueckId, string StueckTitel, string YouTubeVideoId, string BandName,
        int GesamtEindruck, int Praezision, int Musikalitaet,
        int AkustischeQualitaet, int VideoQualitaet, string? Kommentar, DateTime ErstelltAm);

    private record VorschlagZeile(Guid StueckId, string Titel, string Subtitel, string Icon, VideoStatus Status);

    private static Color StatusColor(VideoStatus s) => s switch
    {
        VideoStatus.Genehmigt => Color.Success,
        VideoStatus.Ausstehend => Color.Warning,
        VideoStatus.Abgelehnt => Color.Error,
        _ => Color.Default
    };

    private static string StatusLabel(VideoStatus s) => s switch
    {
        VideoStatus.Genehmigt => "Genehmigt",
        VideoStatus.Ausstehend => "In Prüfung",
        VideoStatus.Abgelehnt => "Abgelehnt",
        _ => s.ToString()
    };
}

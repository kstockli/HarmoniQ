@page "/account/onboarding"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Services
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Willkommen – HarmoniQ</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Style="color:#D4AF37;">Wer bist du?</MudText>

@* Der frühere Onboarding-Zwischenschritt (Namens-Dialog) entfällt: „Meine Person" zeigt das Profil-
   Formular direkt und legt beim Speichern die eigene Person an. Diese Seite leitet nur noch weiter
   (bestehende Links/Buttons bleiben so gültig). Ausnahme: ein offener „Das bin ich"-Anspruch. *@
@if (!_geladen)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_offenerAnspruch != null)
{
    <MudAlert Severity="Severity.Info">
        Dein Antrag „Das bin ich“ für <b>@_offenerAnspruch</b> wird gerade von einer Admin-Person geprüft.
        Sobald er genehmigt ist, kannst du dein Profil unter <MudLink Href="/account/person">Meine Person</MudLink> pflegen.
    </MudAlert>
}

@code {
    private bool _geladen;
    private string? _offenerAnspruch;
    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        await using var db = await DbFactory.CreateDbContextAsync();

        // Verknüpft ODER noch nicht verknüpft: In beiden Fällen ist „Meine Person" der richtige Ort
        // (dort wird das Profil angelegt bzw. gepflegt). Nur ein offener Anspruch bleibt hier stehen.
        var verknuepft = await db.Personen.AnyAsync(p => p.BenutzerId == _userId);
        if (!verknuepft)
        {
            _offenerAnspruch = await db.PersonAnsprueche
                .Where(a => a.BenutzerId == _userId && a.Status == PersonAnspruchStatus.Offen)
                .Select(a => a.Person.Name)
                .FirstOrDefaultAsync();
        }

        if (_offenerAnspruch == null)
        {
            Nav.NavigateTo("/account/person", replace: true);
            return;
        }
        _geladen = true;
    }
}

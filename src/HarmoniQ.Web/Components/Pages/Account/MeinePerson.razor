@page "/account/person"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Meine Person – HarmoniQ</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Style="color:#D4AF37;">Meine Person</MudText>

@if (!_geladen)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_personId == null)
{
    <MudAlert Severity="Severity.Info">
        Dein Konto ist noch mit keiner Person verknüpft. Öffne <MudLink Href="/personen">die Personen-Übersicht</MudLink>,
        finde „dich“ und klicke auf <b>„Das bin ich“</b>. Nach Freigabe durch eine:n Admin kannst du hier deine Daten pflegen.
    </MudAlert>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-4" Style="color:#A78FC0;">
        Du bist mit dieser Person verknüpft und kannst ihre Daten selbst pflegen.
        <MudLink Href="@($"/personen/{_personId}")">Öffentliche Ansicht</MudLink>
    </MudText>

    <MudPaper Class="pa-4" Elevation="2" Style="background:#1a0030; border:1px solid #3a1060; max-width:720px;">
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_m.Name" Label="Name" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="int?" @bind-Value="_m.Geburtsjahr" Label="Geburtsjahr (optional)"
                                 Variant="Variant.Outlined" Min="1850" Max="2100" />
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="Sichtbarkeit" @bind-Value="_m.Sichtbarkeit" Label="Sichtbarkeit" Variant="Variant.Outlined"
                           HelperText="Steuert, wie Außenstehende dich sehen. Bandkolleg:innen sehen dich immer vollständig.">
                    <MudSelectItem Value="Sichtbarkeit.Oeffentlich">Öffentlich (voller Name + Bild)</MudSelectItem>
                    <MudSelectItem Value="Sichtbarkeit.NurInitialen">Nur Initialen (kein Bild)</MudSelectItem>
                    <MudSelectItem Value="Sichtbarkeit.NichtBekannt">Nicht bekannt (anonym, „?“)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_m.BildUrl" Label="Bild-URL (optional)" Variant="Variant.Outlined"
                              Placeholder="https://…/foto.jpg"
                              HelperText="Wird nur bei Sichtbarkeit „Öffentlich“ angezeigt." />
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="Guid" MultiSelection="true" @bind-SelectedValues="_instrumentSel" Label="Instrumente"
                           Variant="Variant.Outlined" MultiSelectionTextFunc="NamenText"
                           HelperText="Welche Instrumente spielst du?">
                    @foreach (var i in _instrumente)
                    {
                        <MudSelectItem T="Guid" Value="@i.Id">@i.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_m.Biografie" Label="Biografie (optional)" Variant="Variant.Outlined" Lines="4" />
            </MudItem>

            <MudItem xs="12"><MudText Typo="Typo.subtitle2" Style="color:#9B59B6;">Links</MudText></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_m.Webseite" Label="Webseite" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_m.Instagram" Label="Instagram" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_m.X" Label="X" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_m.Facebook" Label="Facebook" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_m.YouTube" Label="YouTube" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>

        <MudButton Variant="Variant.Filled" Style="background:#D4AF37; color:#0e0018;" Class="mt-4"
                   StartIcon="@Icons.Material.Filled.Save" OnClick="Speichern"
                   Disabled="@(string.IsNullOrWhiteSpace(_m.Name))">Speichern</MudButton>
    </MudPaper>

    @* Bandmitgliedschaften *@
    <MudPaper Class="pa-4 mt-4" Elevation="2" Style="background:#1a0030; border:1px solid #3a1060; max-width:720px;">
        <MudText Typo="Typo.h6" Class="mb-1" Style="color:#F0E6FF;">Meine Bands</MudText>
        @if (_meineBands.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color:#A78FC0;">Du bist (noch) keiner Band zugeordnet.</MudText>
        }
        else
        {
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-1">
                @foreach (var b in _meineBands)
                {
                    <MudChip T="string" Size="Size.Small" Style="background:#2d1657; color:#A78FC0;">@b</MudChip>
                }
            </MudStack>
        }

        @if (_offeneAntraege.Count > 0)
        {
            <MudText Typo="Typo.caption" Class="d-block mt-2" Style="color:#A78FC0;">In Prüfung:</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                @foreach (var b in _offeneAntraege)
                {
                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.HourglassTop"
                             Style="background:#3a1060; color:#A78FC0;">@b</MudChip>
                }
            </MudStack>
        }

        <MudButton Variant="Variant.Outlined" Class="mt-3" Style="color:#D4AF37; border-color:#D4AF37;"
                   StartIcon="@Icons.Material.Filled.GroupAdd" OnClick="BandVorschlagen">
            Bandmitgliedschaft vorschlagen
        </MudButton>
        <MudText Typo="Typo.caption" Class="d-block mt-1" Style="color:#6f5a86;">
            Beitritte zu Bands werden von einer Admin-Person bestätigt.
        </MudText>
    </MudPaper>
}

@code {
    private bool _geladen;
    private Guid? _personId;
    private string? _userId;
    private Modell _m = new();
    private List<(Guid Id, string Name)> _instrumente = [];
    private IReadOnlyCollection<Guid> _instrumentSel = new HashSet<Guid>();
    private List<string> _meineBands = [];
    private List<string> _offeneAntraege = [];

    private string NameOf(Guid id) => _instrumente.FirstOrDefault(i => i.Id == id).Name ?? "?";
    private string NamenText(IReadOnlyList<string> vals) => string.Join(", ", vals.Select(v => NameOf(Guid.Parse(v))));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        await using var db = await DbFactory.CreateDbContextAsync();
        _instrumente = await db.Instrumente.OrderBy(i => i.Name)
            .Select(i => new ValueTuple<Guid, string>(i.Id, i.Name)).ToListAsync();

        var person = await db.Personen.Include(p => p.Links).Include(p => p.Instrumente)
            .FirstOrDefaultAsync(p => p.BenutzerId == _userId);

        if (person != null)
        {
            _personId = person.Id;
            _instrumentSel = new HashSet<Guid>(person.Instrumente.Select(pi => pi.InstrumentId));
            _m = new Modell
            {
                Name = person.Name,
                Biografie = person.Biografie,
                BildUrl = person.BildUrl,
                Geburtsjahr = person.Geburtsjahr,
                Sichtbarkeit = person.Sichtbarkeit,
                Webseite = person.Webseite,
                Instagram = person.Instagram,
                X = person.X,
                Facebook = person.Facebook,
                YouTube = person.YouTube
            };

            await LadeBandsAsync(db, person.Id);
        }
        _geladen = true;
    }

    private async Task LadeBandsAsync(ApplicationDbContext db, Guid personId)
    {
        _meineBands = await db.BandMitgliedschaften
            .Where(m => m.PersonId == personId)
            .OrderBy(m => m.Band.Name)
            .Select(m => m.Band.Name)
            .ToListAsync();

        _offeneAntraege = await db.BandbeitrittAntraege
            .Where(a => a.PersonId == personId && a.Status == PersonAnspruchStatus.Offen)
            .OrderBy(a => a.Band.Name)
            .Select(a => a.Band.Name)
            .ToListAsync();
    }

    private async Task BandVorschlagen()
    {
        if (_personId == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();

        // Bands, in denen man weder Mitglied ist noch einen offenen Antrag hat.
        var schon = await db.BandMitgliedschaften.Where(m => m.PersonId == _personId)
            .Select(m => m.BandId).ToListAsync();
        var offen = await db.BandbeitrittAntraege
            .Where(a => a.PersonId == _personId && a.Status == PersonAnspruchStatus.Offen)
            .Select(a => a.BandId).ToListAsync();
        var ausgeschlossen = schon.Concat(offen).ToHashSet();

        var bandOptionen = await db.Bands
            .Where(b => !ausgeschlossen.Contains(b.Id))
            .OrderBy(b => b.Name)
            .Select(b => new BandbeitrittDialog.Option(b.Id, b.Name))
            .ToListAsync();

        if (bandOptionen.Count == 0)
        {
            Snackbar.Add("Für alle Bands besteht bereits eine Mitgliedschaft oder ein offener Antrag.", Severity.Info);
            return;
        }

        var instrumentOptionen = _instrumente.Select(i => new BandbeitrittDialog.Option(i.Id, i.Name)).ToList();
        var parameters = new DialogParameters<BandbeitrittDialog>
        {
            { x => x.Bands, bandOptionen },
            { x => x.Instrumente, instrumentOptionen },
            { x => x.Hinweis, "Dein Beitritt wird von einer Admin-Person bestätigt." },
            { x => x.OkText, "Vorschlagen" }
        };
        var dialog = await DialogService.ShowAsync<BandbeitrittDialog>("Bandmitgliedschaft vorschlagen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        var wahl = (BandbeitrittDialog.Auswahl)result.Data!;

        db.BandbeitrittAntraege.Add(new BandbeitrittAntrag
        {
            PersonId = _personId.Value,
            BandId = wahl.BandId,
            InstrumentId = wahl.InstrumentId,
            BeantragtVonId = _userId
        });
        await db.SaveChangesAsync();
        Snackbar.Add("Antrag gesendet – ein:e Admin prüft den Beitritt.", Severity.Success);
        await LadeBandsAsync(db, _personId.Value);
    }

    private async Task Speichern()
    {
        if (_personId == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var person = await db.Personen.Include(p => p.Links).Include(p => p.Instrumente)
            .FirstOrDefaultAsync(p => p.Id == _personId && p.BenutzerId == _userId);
        if (person == null) { Snackbar.Add("Person nicht gefunden oder nicht (mehr) verknüpft.", Severity.Error); return; }

        person.Name = _m.Name.Trim();
        person.Biografie = Leer(_m.Biografie);
        person.BildUrl = Leer(_m.BildUrl);
        person.Geburtsjahr = _m.Geburtsjahr;
        person.Sichtbarkeit = _m.Sichtbarkeit;
        person.Webseite = _m.Webseite;     // Convenience-Setter pflegen die Links-Tabelle
        person.Instagram = _m.Instagram;
        person.X = _m.X;
        person.Facebook = _m.Facebook;
        person.YouTube = _m.YouTube;

        // Instrumente synchronisieren
        var sel = _instrumentSel.ToHashSet();
        foreach (var weg in person.Instrumente.Where(pi => !sel.Contains(pi.InstrumentId)).ToList())
        {
            person.Instrumente.Remove(weg);
            db.PersonInstrumente.Remove(weg);
        }
        foreach (var iid in sel.Where(id => person.Instrumente.All(pi => pi.InstrumentId != id)))
        {
            var pi = new PersonInstrument { PersonId = person.Id, InstrumentId = iid };
            person.Instrumente.Add(pi);
            db.PersonInstrumente.Add(pi);
        }

        await db.SaveChangesAsync();
        Snackbar.Add("Gespeichert.", Severity.Success);
    }

    private static string? Leer(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private class Modell
    {
        public string Name { get; set; } = "";
        public string? Biografie { get; set; }
        public string? BildUrl { get; set; }
        public int? Geburtsjahr { get; set; }
        public Sichtbarkeit Sichtbarkeit { get; set; } = Sichtbarkeit.Oeffentlich;
        public string? Webseite { get; set; }
        public string? Instagram { get; set; }
        public string? X { get; set; }
        public string? Facebook { get; set; }
        public string? YouTube { get; set; }
    }
}

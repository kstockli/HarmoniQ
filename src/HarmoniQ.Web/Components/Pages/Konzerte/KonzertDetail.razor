@page "/konzerte/{Id:guid}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Services
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@(_konzert?.Titel ?? "Konzert") – HarmoniQ</PageTitle>

@if (_konzert == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 pa-0" />

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-2" Wrap="Wrap.Wrap">
        <MudIcon Icon="@Icons.Material.Filled.Event" Style="color:#D4AF37;font-size:3rem;" />
        <div>
            <MudText Typo="Typo.h4" Style="color:#D4AF37;">@_konzert.Titel</MudText>
            <MudText Typo="Typo.body2" Style="color:#A78FC0;">
                @_konzert.Datum.ToString("dddd, dd.MM.yyyy")@(string.IsNullOrWhiteSpace(_konzert.Ort) ? "" : $" · {_konzert.Ort}")
            </MudText>
        </div>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_konzert.BildUrl))
    {
        <img src="@_konzert.BildUrl" style="width:100%;max-width:680px;border-radius:8px;display:block;" class="mb-4" alt="" />
    }
    @if (!string.IsNullOrWhiteSpace(_konzert.Beschreibung))
    {
        <MudText Typo="Typo.body1" Class="mb-4" Style="color:#F0E6FF;">@_konzert.Beschreibung</MudText>
    }

    <MudStack Row="true" Spacing="2" Class="mb-6" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
        @* „Mitgewirkt" nur für Bühnen-Beteiligte (Dirigent/Musikant/Komponist); Publikum nutzt das Tagebuch unten. *@
        @if (_eigenePersonId is not null && _kannMitwirken)
        {
            @if (_eigeneTeilnahmeRollen.Count > 0)
            {
                <MudChip T="string" Icon="@Icons.Material.Filled.CheckCircle" Variant="Variant.Outlined"
                         Style="color:#A78FC0; border-color:#3a1060;">
                    Du hast mitgewirkt (@string.Join(", ", _eigeneTeilnahmeRollen.Select(RolleLabelKurz)))
                </MudChip>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Style="color:#D4AF37; border-color:#D4AF37;"
                           StartIcon="@Icons.Material.Filled.Groups" OnClick="IchWarDabei">Ich habe mitgewirkt</MudButton>
            }
        }
        <RichtigstellungMelden Typ="RichtigstellungTyp.Konzert" Id="_konzert.Id" />
    </MudStack>

    <KonzertTagebuchPanel KonzertId="_konzert.Id" Programm="_tagebuchProgramm" />

    @if (_eindruecke.Count > 0)
    {
        <MudPaper Class="pa-4 mb-6" Elevation="1" Style="background:#1a0030; border:1px solid #3a1060;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.People" Style="color:#1ABC9C;" />
                <MudText Typo="Typo.h6" Style="color:#D4AF37;">Eindrücke der Besucher:innen</MudText>
            </MudStack>
            <MudStack Spacing="3">
                @foreach (var e in _eindruecke)
                {
                    <div>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudLink Href="@($"/personen/{e.PersonId}")" Style="color:#F0E6FF;font-weight:500;" Underline="Underline.Hover">@e.Name</MudLink>
                            @if (!e.ZeigtInhalt)
                            {
                                <MudText Typo="Typo.caption" Style="color:#6f5a86;">war dabei</MudText>
                            }
                        </MudStack>
                        @if (e.ZeigtInhalt && !string.IsNullOrWhiteSpace(e.Notiz))
                        {
                            <MudText Typo="Typo.body2" Style="color:#C4B0D8;font-style:italic;">„@e.Notiz"</MudText>
                        }
                        @if (e.Bewertungen.Count > 0)
                        {
                            <MudStack Spacing="0" Class="mt-1">
                                @foreach (var (titel, st, notiz) in e.Bewertungen)
                                {
                                    <MudText Typo="Typo.caption" Style="color:#A78FC0;">
                                        @titel
                                        @if (st is int s)
                                        {
                                            <span style="color:#F1C40F;">&nbsp;@(new string('★', s))</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(notiz))
                                        {
                                            <span style="color:#C4B0D8;font-style:italic;">&nbsp;– @notiz</span>
                                        }
                                    </MudText>
                                }
                            </MudStack>
                        }
                    </div>
                }
            </MudStack>
        </MudPaper>
    }

    @if (_mitwirkende.Count > 0)
    {
        <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">Mitwirkende & Gäste (@_mitwirkende.Count)</MudText>
        <MudPaper Class="pa-4 mb-6" Style="background:#1a0030; border:1px solid #3a1060;">
            @foreach (var gruppe in _mitwirkende.GroupBy(m => m.Rolle).OrderBy(g => (int)g.Key))
            {
                <MudText Typo="Typo.subtitle2" Style="color:#9B59B6;">@RolleLabel(gruppe.Key)</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" Class="mb-3">
                    @foreach (var m in gruppe)
                    {
                        <MudLink Href="@($"/personen/{m.PersonId}")" Style="color:#F0E6FF;" Underline="Underline.Hover">
                            @m.AnzeigeName@(m.BandName != null ? $" ({m.BandName})" : "")
                        </MudLink>
                    }
                </MudStack>
            }
        </MudPaper>
    }

    @if (_bands.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Für dieses Konzert sind noch keine Bands erfasst.</MudAlert>
    }
    else
    {
        @if (_istWettbewerb)
        {
            <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">Rangliste</MudText>
            <MudSimpleTable Dense="true" Hover="true" Bordered="true" Class="mb-6"
                            Style="background:#1a0030; border:1px solid #3a1060;">
                <thead>
                    <tr style="color:#9B59B6;">
                        <th style="color:#9B59B6;">Rang</th>
                        <th style="color:#9B59B6;">Band</th>
                        <th style="color:#9B59B6;">Dirigent:in</th>
                        <th style="color:#9B59B6;">Stücke</th>
                        <th style="color:#9B59B6;">Punkte</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in _bands)
                    {
                        <tr>
                            <td style="color:#D4AF37;font-weight:600;">@(b.Rang?.ToString() ?? "–")</td>
                            <td><MudLink Href="@($"/bands/{b.Id}")" Style="color:#F0E6FF;" Underline="Underline.Hover">@b.Name</MudLink></td>
                            <td>
                                @if (b.Dirigent is { } d)
                                {
                                    <MudLink Href="@($"/personen/{d.Id}")" Style="color:#F0E6FF;" Underline="Underline.Hover">@d.Name</MudLink>
                                }
                                else { <span style="color:#A78FC0;">–</span> }
                            </td>
                            <td>
                                @foreach (var s in b.Stuecke)
                                {
                                    <div class="mb-1">
                                        <MudLink Href="@($"/stuecke/{s.Id}")" Style="color:#F0E6FF;" Underline="Underline.Hover">@s.Titel</MudLink>
                                        @KomponistMarkup(s.Id)
                                    </div>
                                }
                            </td>
                            <td style="color:#A78FC0;">@(b.Punkte?.ToString() ?? "")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        @foreach (var band in _bands)
        {
            // Bei Wettbewerben sind alle Bands schon in der Rangliste – pro Band nur zeigen, wenn es Videos gibt.
            var bandVideos = VideosVon(band.Id).ToList();
            if (_istWettbewerb && bandVideos.Count == 0) { continue; }

            <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">
                <MudLink Href="@($"/bands/{band.Id}")" Style="color:#D4AF37;" Underline="Underline.Hover">@band.Name</MudLink>
                @if (band.Rang is { } rang)
                {
                    <MudChip T="string" Size="Size.Small" Class="ml-2" Style="background:#D4AF37;color:#0e0018;">Rang @rang</MudChip>
                }
            </MudText>
            @if (bandVideos.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mb-4" Style="color:#A78FC0;">(keine Videos an diesem Konzert)</MudText>
            }
            else
            {
                <MudGrid Class="mb-4">
                    @foreach (var v in bandVideos)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
                                <MudLink Href="@($"/videos/{v.Id}")">
                                    <img src="@VideoEinbettung.Thumbnail(v.Plattform, v.ExternId)"
                                         style="width:100%;display:block;" alt="@v.Titel" />
                                </MudLink>
                                <MudCardContent>
                                    <MudLink Href="@($"/videos/{v.Id}")" Style="color:#F0E6FF;font-weight:500;"
                                             Underline="Underline.Hover">@v.StueckTitel</MudLink>
                                    <MudText Typo="Typo.caption" Class="d-block" Style="color:#A78FC0;">@v.Titel</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        }

        @if (_videos.Any(v => v.BandId == null))
        {
            <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#9B59B6;">Weitere Aufnahmen</MudText>
            <MudGrid class="mb-4">
                @foreach (var v in _videos.Where(v => v.BandId == null))
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
                            <MudLink Href="@($"/videos/{v.Id}")">
                                <img src="@VideoEinbettung.Thumbnail(v.Plattform, v.ExternId)"
                                     style="width:100%;display:block;" alt="@v.Titel" />
                            </MudLink>
                            <MudCardContent>
                                <MudLink Href="@($"/videos/{v.Id}")" Style="color:#F0E6FF;font-weight:500;"
                                         Underline="Underline.Hover">@v.StueckTitel</MudLink>
                                <MudText Typo="Typo.caption" Class="d-block" Style="color:#A78FC0;">@v.Titel</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private KonzertKopf? _konzert;
    private List<BandZeile> _bands = [];
    private List<VideoZeile> _videos = [];
    private List<ProgrammZeile> _programm = [];
    private List<MitwirkendeZeile> _mitwirkende = [];
    private Dictionary<Guid, List<PersonRef>> _komponisten = new();
    private bool _istWettbewerb;

    // Programmpunkte fürs vereinte Programm-/Bewertungs-Panel (mit Komponist:innen + Links).
    // Auch bei Wettbewerben: die Rangliste zeigt Platzierung/Punkte, das Panel die private Bewertung.
    private List<KonzertTagebuchPanel.Programmpunkt> _tagebuchProgramm =>
        _programm.Select(p => new KonzertTagebuchPanel.Programmpunkt(
            p.KonzertStueckId, p.StueckId, p.StueckTitel, p.BandId, p.BandName,
            _komponisten.TryGetValue(p.StueckId, out var ks)
                ? ks.Select(k => new KonzertTagebuchPanel.Komponist(k.Id, k.Name)).ToList()
                : [])).ToList();

    private Guid? _eigenePersonId;
    private bool _kannMitwirken;   // Person hat eine Bühnenrolle (nicht nur Zuhörer:in)
    private PersonRolleTyp _vorschlagRolle = PersonRolleTyp.Musikant;
    private List<PersonRolleTyp> _eigeneTeilnahmeRollen = [];
    private List<EindruckZeile> _eindruecke = [];

    private List<BreadcrumbItem> _breadcrumbs => _konzert == null ? [] :
    [
        new("Startseite", "/"),
        new("Konzerte", "/konzerte"),
        new(_konzert.Titel, null, disabled: true)
    ];

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var k = await db.Konzerte.FirstOrDefaultAsync(x => x.Id == Id);
        if (k == null) { Nav.NavigateTo("/konzerte"); return; }
        _konzert = new KonzertKopf(k.Id, k.Datum, k.Name, k.Ort, k.Beschreibung, k.BildUrl);

        // Videos dieses Konzerts (genehmigt), nach Band gruppierbar.
        var videos = await db.Videos
            .Where(v => v.KonzertId == Id && v.Status == VideoStatus.Genehmigt)
            .Include(v => v.Stueck)
            .OrderBy(v => v.Stueck.Titel)
            .ToListAsync();
        _videos = videos
            .Select(v => new VideoZeile(v.Id, v.BandId, v.Plattform, v.ExternId, v.Titel, v.Stueck.Titel))
            .ToList();

        // Teilnehmende Bands inkl. Platzierung/Punkte (Wettbewerb) aus KonzertBand.
        var bandRows = await db.KonzertBands
            .Where(kb => kb.KonzertId == Id)
            .Select(kb => new BandRoh(kb.BandId, kb.Band.Name, kb.Rang, kb.Punkte))
            .ToListAsync();

        // Falls ein Video eine Band hat, die (noch) nicht als Teilnehmerin geführt ist, ergänzen.
        var bekannteBandIds = bandRows.Select(b => b.Id).ToHashSet();
        foreach (var bid in _videos.Where(v => v.BandId != null).Select(v => v.BandId!.Value).Distinct())
        {
            if (bekannteBandIds.Add(bid))
            {
                var name = await db.Bands.Where(b => b.Id == bid).Select(b => b.Name).FirstOrDefaultAsync();
                if (name != null) bandRows.Add(new BandRoh(bid, name, null, null));
            }
        }
        _istWettbewerb = bandRows.Any(b => b.Rang != null);

        // Programm (Konzert↔Stück, optional je Band), nach Reihenfolge dann Titel.
        _programm = await db.KonzertStuecke
            .Where(ks => ks.KonzertId == Id)
            .OrderBy(ks => ks.Reihenfolge)
            .ThenBy(ks => ks.Stueck.Titel)
            .Select(ks => new ProgrammZeile(ks.Id, ks.StueckId, ks.Stueck.Titel, ks.BandId, ks.Band != null ? ks.Band.Name : null))
            .ToListAsync();

        // Mitwirkende & Gäste (Konzert↔Person mit Rolle); Namen sichtbarkeitsabhängig.
        var mitwirkende = await db.KonzertPersonen
            .Where(kp => kp.KonzertId == Id)
            .Include(kp => kp.Person)
            .Include(kp => kp.Band)
            .ToListAsync();

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var vollSichtbar = await PersonenSicht.LadeVollSichtbareAsync(db, userId);

        _mitwirkende = mitwirkende
            .Select(kp =>
            {
                var eff = PersonenSicht.Effektiv(kp.PersonId, kp.Person.Sichtbarkeit, vollSichtbar);
                return new MitwirkendeZeile(kp.PersonId,
                    PersonenSicht.AnzeigeName(kp.Person.Name, eff), kp.Rolle, kp.BandId, kp.Band?.Name);
            })
            .OrderBy(m => m.AnzeigeName)
            .ToList();

        // Komponist:innen je Stück (sichtbarkeitsabhängig) – für klickbare Komponisten in der Tabelle.
        var stueckIds = _programm.Select(p => p.StueckId).Distinct().ToList();
        var beitraege = await db.StueckBeitraege
            .Where(b => stueckIds.Contains(b.StueckId) && b.Rolle == StueckRolle.Komponist)
            .Include(b => b.Person)
            .ToListAsync();
        _komponisten = beitraege
            .GroupBy(b => b.StueckId)
            .ToDictionary(g => g.Key, g => g.Select(b =>
            {
                var eff = PersonenSicht.Effektiv(b.PersonId, b.Person.Sichtbarkeit, vollSichtbar);
                return new PersonRef(b.PersonId, PersonenSicht.AnzeigeName(b.Person.Name, eff));
            }).ToList());

        // Bands anreichern: Dirigent:in (aus Mitwirkenden, klickbar) + gespielte Stücke (aus Programm),
        // sortiert nach Rang (Wettbewerb), sonst nach Name.
        _bands = bandRows
            .Select(b =>
            {
                var dir = _mitwirkende.FirstOrDefault(m => m.Rolle == PersonRolleTyp.Dirigent && m.BandId == b.Id);
                return new BandZeile(b.Id, b.Name, b.Rang, b.Punkte,
                    dir == null ? null : new PersonRef(dir.PersonId, dir.AnzeigeName),
                    _programm.Where(p => p.BandId == b.Id).Select(p => new StueckRef(p.StueckId, p.StueckTitel)).ToList());
            })
            .OrderBy(b => b.Rang == null).ThenBy(b => b.Rang).ThenBy(b => b.Name)
            .ToList();

        // Eigene verknüpfte Person + Rollen-Vorschlag (für „Ich habe mitgewirkt").
        _eigenePersonId = null;
        _kannMitwirken = false;
        _eigeneTeilnahmeRollen = [];
        List<Guid> freundIds = [];
        if (!string.IsNullOrEmpty(userId))
        {
            var eigene = await db.Personen
                .Where(p => p.BenutzerId == userId)
                .Select(p => new { p.Id, Rollen = p.Rollen.Select(r => r.Rolle).ToList() })
                .FirstOrDefaultAsync();
            if (eigene != null)
            {
                _eigenePersonId = eigene.Id;
                var distinct = eigene.Rollen.Distinct().ToList();
                // Nur Personen mit Bühnenrolle (nicht nur Zuhörer:in) können „mitwirken".
                var buehne = distinct.Where(r => r != PersonRolleTyp.Zuhoerer).ToList();
                _kannMitwirken = buehne.Count > 0;
                _vorschlagRolle = buehne.Count == 1 ? buehne[0] : PersonRolleTyp.Musikant;
                _eigeneTeilnahmeRollen = mitwirkende
                    .Where(kp => kp.PersonId == eigene.Id)
                    .Select(kp => kp.Rolle)
                    .ToList();

                var meineId = eigene.Id;
                freundIds = await db.Freundschaften
                    .Where(f => f.Status == FreundschaftStatus.Bestaetigt
                        && (f.AnfragerPersonId == meineId || f.EmpfaengerPersonId == meineId))
                    .Select(f => f.AnfragerPersonId == meineId ? f.EmpfaengerPersonId : f.AnfragerPersonId)
                    .ToListAsync();
            }
        }

        await EindrueckeLadenAsync(db, userId, freundIds);
    }

    // Geteilte Tagebuch-Eindrücke für die Konzertseite: öffentliche für alle, Freundes-Einträge für mich.
    private async Task EindrueckeLadenAsync(ApplicationDbContext db, string? userId, List<Guid> freundIds)
    {
        _eindruecke = [];

        // Besuche dieses Konzerts, die überhaupt geteilt sind (nicht „Nur ich"), ohne meinen eigenen.
        var besuche = await db.KonzertBesuche
            .Where(b => b.KonzertId == Id && b.Sichtbarkeit != TagebuchSichtbarkeit.NurIch
                        && b.BenutzerId != userId)
            .Join(db.Personen, b => b.BenutzerId, p => p.BenutzerId,
                (b, p) => new { b.BenutzerId, b.Sichtbarkeit, b.Notiz, PersonId = p.Id, p.Name })
            .ToListAsync();

        // Sichtbar: öffentlich (alle) ODER von einer bestätigten Freund:in.
        var sichtbar = besuche
            .Where(b => b.Sichtbarkeit == TagebuchSichtbarkeit.Oeffentlich || freundIds.Contains(b.PersonId))
            .ToList();
        if (sichtbar.Count == 0) return;

        // Inhalt (Notiz + Sterne) nur ab Stufe „Freunde"/„Öffentlich"; „FreundeAnwesenheit" = nur Anwesenheit.
        var inhaltUser = sichtbar
            .Where(b => b.Sichtbarkeit is TagebuchSichtbarkeit.Freunde or TagebuchSichtbarkeit.Oeffentlich)
            .Select(b => b.BenutzerId).ToList();
        var eindr = await db.StueckEindruecke
            .Where(s => inhaltUser.Contains(s.BenutzerId) && (s.Sterne != null || s.Notiz != null)
                        && db.KonzertStuecke.Any(ks => ks.Id == s.KonzertStueckId && ks.KonzertId == Id))
            .Select(s => new { s.BenutzerId, Titel = s.KonzertStueck.Stueck.Titel, s.Sterne, s.Notiz })
            .ToListAsync();
        var sterneProUser = eindr.GroupBy(x => x.BenutzerId)
            .ToDictionary(g => g.Key, g => g.Select(x => (x.Titel, x.Sterne, x.Notiz)).ToList());

        _eindruecke = sichtbar
            .OrderBy(b => b.Name)
            .Select(b =>
            {
                var zeigtInhalt = b.Sichtbarkeit is TagebuchSichtbarkeit.Freunde or TagebuchSichtbarkeit.Oeffentlich;
                return new EindruckZeile(b.PersonId, b.Name,
                    zeigtInhalt,
                    zeigtInhalt ? b.Notiz : null,
                    zeigtInhalt && sterneProUser.TryGetValue(b.BenutzerId, out var lst) ? lst : []);
            })
            .ToList();
    }

    private async Task IchWarDabei()
    {
        if (_eigenePersonId is not Guid pid) return;

        var parameters = new DialogParameters<IchWarDabeiDialog> { { x => x.Vorschlag, _vorschlagRolle } };
        var dialog = await DialogService.ShowAsync<IchWarDabeiDialog>("Ich war dabei", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        var rolle = (PersonRolleTyp)result.Data!;
        await using var db = await DbFactory.CreateDbContextAsync();
        var existiert = await db.KonzertPersonen.AnyAsync(kp =>
            kp.KonzertId == Id && kp.PersonId == pid && kp.Rolle == rolle);
        if (!existiert)
        {
            db.KonzertPersonen.Add(new KonzertPerson { KonzertId = Id, PersonId = pid, Rolle = rolle });
            await db.SaveChangesAsync();
        }
        Snackbar.Add("Danke – als dabei eingetragen.", Severity.Success);
        await OnParametersSetAsync();
    }

    private static string RolleLabelKurz(PersonRolleTyp r) => r switch
    {
        PersonRolleTyp.Komponist => "Komponist:in",
        PersonRolleTyp.Dirigent => "Dirigent:in",
        PersonRolleTyp.Musikant => "Musikant:in",
        PersonRolleTyp.Zuhoerer => "Zuhörer:in",
        _ => r.ToString()
    };

    private IEnumerable<VideoZeile> VideosVon(Guid bandId) => _videos.Where(v => v.BandId == bandId);

    private static string RolleLabel(PersonRolleTyp r) => r switch
    {
        PersonRolleTyp.Komponist => "Komponist:innen",
        PersonRolleTyp.Dirigent => "Dirigent:innen",
        PersonRolleTyp.Musikant => "Musikant:innen",
        PersonRolleTyp.Zuhoerer => "Zuhörer:innen",
        _ => r.ToString()
    };

    /// <summary>Komma-getrennte, klickbare Personen-Links (z. B. Komponist:innen eines Stücks).</summary>
    private RenderFragment PersonenLinks(List<PersonRef> personen) =>@<span>
        @{ var erster = true; }
        @foreach (var person in personen)
        {
            @if (!erster)
            {
                <span style="color:#A78FC0;">, </span>
            }
            <MudLink Href="@($"/personen/{person.Id}")" Style="color:#9B59B6;" Underline="Underline.Hover">@person.Name</MudLink>
            erster = false;
        }
    </span>;

    /// <summary>Hängt „ – Komponist:in(nen)" (klickbar) an einen Stück-Titel an, falls bekannt.</summary>
    private RenderFragment KomponistMarkup(Guid stueckId) =>@<span>
        @if (_komponisten.TryGetValue(stueckId, out var ks) && ks.Count > 0)
        {
            <span style="color:#A78FC0;"> – </span>
            @PersonenLinks(ks)
        }
    </span>;

    private record KonzertKopf(Guid Id, DateOnly Datum, string? Name, string? Ort, string? Beschreibung, string? BildUrl)
    {
        public string Titel => Name ?? Datum.ToString("dd.MM.yyyy");
    }
    private record BandRoh(Guid Id, string Name, int? Rang, int? Punkte);
    private record StueckRef(Guid Id, string Titel);
    private record PersonRef(Guid Id, string Name);
    private record BandZeile(Guid Id, string Name, int? Rang, int? Punkte, PersonRef? Dirigent, List<StueckRef> Stuecke);
    private record VideoZeile(Guid Id, Guid? BandId, VideoPlattform Plattform, string ExternId, string Titel, string StueckTitel);
    private record ProgrammZeile(Guid KonzertStueckId, Guid StueckId, string StueckTitel, Guid? BandId, string? BandName);
    private record EindruckZeile(Guid PersonId, string Name, bool ZeigtInhalt, string? Notiz,
        List<(string Titel, int? Sterne, string? Notiz)> Bewertungen);
    private record MitwirkendeZeile(Guid PersonId, string AnzeigeName, PersonRolleTyp Rolle, Guid? BandId, string? BandName);
}

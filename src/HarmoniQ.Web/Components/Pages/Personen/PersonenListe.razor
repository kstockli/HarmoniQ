@page "/personen"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Services
@using HarmoniQ.Web.Components.Shared
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Personen – HarmoniQ</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Style="color:#D4AF37;">Personen</MudText>

@if (_kontext != null)
{
    <MudChip T="string" Class="mb-3" Color="Color.Primary" Icon="@Icons.Material.Filled.FilterAlt"
             OnClose="@(() => Nav.NavigateTo("/personen"))">@_kontext</MudChip>
}

<MudPaper Class="pa-4 mb-4" Elevation="2" Style="background:#1a0030; border:1px solid #3a1060;">
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="_suche" @bind-Value:after="Filtern" Label="Name suchen"
                          Variant="Variant.Outlined" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudSelect T="PersonRolleTyp?" @bind-Value="_rolle" @bind-Value:after="Filtern"
                       Label="Rolle" Variant="Variant.Outlined" Clearable="true">
                <MudSelectItem T="PersonRolleTyp?" Value="@(PersonRolleTyp.Komponist)">Komponist:in</MudSelectItem>
                <MudSelectItem T="PersonRolleTyp?" Value="@(PersonRolleTyp.Dirigent)">Dirigent:in</MudSelectItem>
                <MudSelectItem T="PersonRolleTyp?" Value="@(PersonRolleTyp.Musikant)">Musikant:in</MudSelectItem>
                <MudSelectItem T="PersonRolleTyp?" Value="@(PersonRolleTyp.Zuhoerer)">Zuhörer:in</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="4">
            <MudAutocomplete T="string" @bind-Value="_instrumentText" @bind-Value:after="Filtern"
                             Label="Instrument" Variant="Variant.Outlined" Clearable="true"
                             SearchFunc="SucheInstrument" CoerceValue="true" ResetValueOnEmptyText="true"
                             MaxItems="20" Immediate="true"
                             AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" />
        </MudItem>
    </MudGrid>
    <MudText Typo="Typo.caption" Class="mt-2" Style="color:#A78FC0;">@_gefiltert.Count von @_alle.Count Personen</MudText>
</MudPaper>

@if (_alle.Count == 0)
{
    <MudAlert Severity="Severity.Info">Noch keine Personen erfasst.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var p in _gefiltert)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="4" Style="background:#1a0030; border:1px solid #3a1060;">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudAvatar Style="background:#3a1060; color:#D4AF37;">
                                @{ var bild = Bild(p); var name = Name(p); }
                                @if (bild != null)
                                {
                                    <img src="@bild" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" alt="@name" />
                                }
                                else { @(name.Length > 0 ? name[0].ToString() : "?") }
                            </MudAvatar>
                            <div>
                                <MudLink Href="@($"/personen/{p.Id}")" Style="color:#F0E6FF;font-weight:600;"
                                         Underline="Underline.Hover">@Name(p)</MudLink>
                                <div>
                                    @foreach (var r in p.Rollen)
                                    {
                                        var ri = Darstellung.RolleIcon(r);
                                        <MudChip T="string" Size="Size.Small" Class="mr-1"
                                                 Style="background:#2d1657; color:#A78FC0;">
                                            @if (ri != null)
                                            {
                                                <img src="@ri" alt="" style="width:14px;height:14px;margin-right:3px;vertical-align:text-bottom;" />
                                            }
                                            @RolleText(r)
                                        </MudChip>
                                    }
                                </div>
                                @if (p.Instrumente.Count > 0)
                                {
                                    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:2px 8px;margin-top:2px;">
                                        @foreach (var inst in p.Instrumente)
                                        {
                                            <span style="display:inline-flex;align-items:center;gap:3px;">
                                                <img src="@Darstellung.InstrumentIcon(inst.Familie, inst.SymbolUrl)" alt=""
                                                     title="@inst.Name" style="width:16px;height:16px;" />
                                                <MudText Typo="Typo.caption" Style="color:#6f5a86;">@inst.Name</MudText>
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    [SupplyParameterFromQuery(Name = "stueck")] public Guid? StueckQuery { get; set; }
    [SupplyParameterFromQuery(Name = "komponist")] public Guid? KomponistQuery { get; set; }
    [SupplyParameterFromQuery(Name = "band")] public Guid? BandQuery { get; set; }

    private List<Zeile> _alle = [];
    private List<Zeile> _gefiltert = [];
    private List<Instrument> _instrumente = [];
    private HashSet<Guid> _vollSichtbar = [];
    private string _suche = "";
    private PersonRolleTyp? _rolle;
    private string? _instrumentText;
    private string? _kontext;

    private Task<IEnumerable<string>> SucheInstrument(string? wert, CancellationToken ct)
    {
        var namen = _instrumente.Select(i => i.Name);
        IEnumerable<string> r = string.IsNullOrWhiteSpace(wert)
            ? namen
            : namen.Where(n => n.Contains(wert, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(r.Take(20));
    }

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _instrumente = await db.Instrumente.OrderBy(i => i.Name).ToListAsync();

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _vollSichtbar = await PersonenSicht.LadeVollSichtbareAsync(db, userId);

        var q = db.Personen
            .Include(p => p.Rollen)
            .Include(p => p.Instrumente).ThenInclude(pi => pi.Instrument)
            .AsQueryable();

        _kontext = null;
        if (StueckQuery is { } sid)
        {
            q = q.Where(p => p.Mitwirkungen.Any(m => m.Video.StueckId == sid));
            var titel = await db.Stuecke.Where(s => s.Id == sid).Select(s => s.Titel).FirstOrDefaultAsync();
            if (titel != null) _kontext = $"hat \"{titel}\" gespielt";
        }
        else if (KomponistQuery is { } kid)
        {
            q = q.Where(p => p.Mitwirkungen.Any(m =>
                m.Video.Stueck.Beitraege.Any(b => b.PersonId == kid && b.Rolle == StueckRolle.Komponist)));
            var name = await db.Personen.Where(x => x.Id == kid).Select(x => x.Name).FirstOrDefaultAsync();
            if (name != null) _kontext = $"hat Stücke von {name} gespielt";
        }
        else if (BandQuery is { } bid)
        {
            q = q.Where(p => p.Mitwirkungen.Any(m => m.Video.BandId == bid));
            var name = await db.Bands.Where(x => x.Id == bid).Select(x => x.Name).FirstOrDefaultAsync();
            if (name != null) _kontext = $"hat bei {name} mitgewirkt";
        }

        var personen = await q.ToListAsync();
        _alle = personen.Select(p => new Zeile(
            p.Id,
            p.Name,
            p.Sichtbarkeit,
            p.BildUrl,
            p.Rollen.Select(r => r.Rolle).ToList(),
            p.Instrumente.Select(pi => new InstrItem(pi.InstrumentId, pi.Instrument.Name,
                pi.Instrument.Familie, pi.Instrument.SymbolUrl)).OrderBy(x => x.Name).ToList()
        )).ToList();

        Filtern();
    }

    private Sichtbarkeit Eff(Zeile z) => PersonenSicht.Effektiv(z.Id, z.Sichtbarkeit, _vollSichtbar);
    private string Name(Zeile z) => PersonenSicht.AnzeigeName(z.RawName, Eff(z));
    private string? Bild(Zeile z) => PersonenSicht.BildUrl(z.BildUrl, Eff(z));

    private void Filtern()
    {
        _gefiltert = _alle
            // Effektiv „NichtBekannt“ (versteckte Personen) aus der Übersicht ausblenden.
            .Where(z => Eff(z) != Sichtbarkeit.NichtBekannt)
            .Where(z =>
                (_rolle == null || z.Rollen.Contains(_rolle.Value)) &&
                (string.IsNullOrWhiteSpace(_instrumentText)
                    || z.Instrumente.Any(n => n.Name.Contains(_instrumentText, StringComparison.OrdinalIgnoreCase))) &&
                (_suche == "" || Name(z).Contains(_suche, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(z => Name(z))
            .ToList();
    }

    private static string RolleText(PersonRolleTyp r) => r switch
    {
        PersonRolleTyp.Komponist => "Komponist:in",
        PersonRolleTyp.Dirigent => "Dirigent:in",
        PersonRolleTyp.Musikant => "Musikant:in",
        PersonRolleTyp.Zuhoerer => "Zuhörer:in",
        _ => r.ToString()
    };

    private record Zeile(Guid Id, string RawName, Sichtbarkeit Sichtbarkeit, string? BildUrl,
        List<PersonRolleTyp> Rollen, List<InstrItem> Instrumente);
    private record InstrItem(Guid Id, string Name, InstrumentFamilie? Familie, string? SymbolUrl);
}

@page "/personen/{Id:guid}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@using HarmoniQ.Web.Services
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@AnzeigeName – HarmoniQ</PageTitle>

@if (_person == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 pa-0" />

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="mb-4" Wrap="Wrap.Wrap">
        <MudAvatar Style="background:#3a1060; color:#D4AF37; width:80px; height:80px; font-size:2rem;">
            @if (BildAnzeige != null)
            {
                <img src="@BildAnzeige" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" alt="@AnzeigeName" />
            }
            else { @(AnzeigeName.Length > 0 ? AnzeigeName[0].ToString() : "?") }
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h4" Style="color:#D4AF37;">@AnzeigeName</MudText>
            <MudStack Row="true" Spacing="1" Class="mt-1" Wrap="Wrap.Wrap">
                @foreach (var r in _person.Rollen)
                {
                    <MudChip T="string" Size="Size.Small" Style="background:#2d1657; color:#A78FC0;">@RolleText(r.Rolle)</MudChip>
                }
                @if (_person.Geburtsjahr.HasValue)
                {
                    <MudChip T="string" Size="Size.Small" Style="background:#2d1657; color:#A78FC0;">* @_person.Geburtsjahr</MudChip>
                }
            </MudStack>
        </div>
    </MudStack>

    @if (_eff != Sichtbarkeit.Oeffentlich)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            Diese Person wird aus Datenschutzgründen nur eingeschränkt angezeigt (@_eff).
        </MudAlert>
    }
    else if (_person.Sichtbarkeit != Sichtbarkeit.Oeffentlich)
    {
        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
            Du siehst diese Person vollständig, weil ihr in derselben Band seid.
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(_person.Biografie))
    {
        <MudText Typo="Typo.body1" Class="mb-4" Style="color:#C4B0D8;">@_person.Biografie</MudText>
    }

    @* Links *@
    @if (_person.Links.Count > 0)
    {
        <MudStack Row="true" Spacing="2" Class="mb-4" Wrap="Wrap.Wrap">
            @foreach (var l in _person.Links)
            {
                <MudButton Variant="Variant.Text" Style="color:#9B59B6;" Href="@l.Url" Target="_blank"
                           StartIcon="@LinkIcon(l.Typ)">@l.Typ</MudButton>
            }
        </MudStack>
    }

    @if (_person.Instrumente.Count > 0)
    {
        <MudText Typo="Typo.body2" Class="mb-4" Style="color:#A78FC0;">
            <b>Instrumente:</b> @string.Join(", ", _person.Instrumente.Select(pi => pi.Instrument.Name))
        </MudText>
    }

    @if (_bands.Count > 0)
    {
        <MudText Typo="Typo.body2" Class="mb-4" Style="color:#A78FC0;">
            <b>Bands:</b>
            @foreach (var b in _bands)
            {
                <MudLink Href="@($"/bands/{b.BandId}")" Style="color:#9B59B6;" Underline="Underline.Hover">@b.BandName</MudLink>
                <span style="color:#A78FC0;">@(b.Detail) </span>
            }
        </MudText>
    }

    @* Selbst-Verknüpfung „das bin ich“ *@
    <div class="mb-2">
        @if (_verknuepftMitMir)
        {
            <MudChip T="string" Icon="@Icons.Material.Filled.Verified" Style="background:#1d4d2b; color:#9fe0b0;">
                Mit deinem Konto verknüpft
            </MudChip>
            <MudButton Variant="Variant.Outlined" Class="ml-1" Style="color:#D4AF37; border-color:#D4AF37;"
                       StartIcon="@Icons.Material.Filled.Edit" Href="/account/person">
                Meine Daten bearbeiten
            </MudButton>
        }
        else if (_offenerAntrag)
        {
            <MudChip T="string" Icon="@Icons.Material.Filled.HourglassTop" Style="background:#3a1060; color:#A78FC0;">
                Verknüpfungs-Antrag in Prüfung
            </MudChip>
        }
        else if (_userId != null && !_personVerknuepft && !_ichHabeSchonPerson)
        {
            <MudButton Variant="Variant.Outlined" Style="color:#D4AF37; border-color:#D4AF37;"
                       StartIcon="@Icons.Material.Filled.PersonPin" OnClick="DasBinIch">
                Das bin ich
            </MudButton>
        }
    </div>

    <RichtigstellungMelden Typ="RichtigstellungTyp.Person" Id="_person.Id" />

    <MudDivider Class="my-4" Style="border-color:#3a1060;" />

    @* Werke (StückBeiträge) *@
    <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">Werke (@_werke.Count)</MudText>
    @if (_werke.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mb-4" Style="color:#A78FC0;">Keine Werke erfasst.</MudText>
    }
    else
    {
        <MudList T="string" Dense="true" Class="mb-4">
            @foreach (var w in _werke)
            {
                <MudListItem T="string" Href="@($"/stuecke/{w.StueckId}")" Icon="@Icons.Material.Filled.MusicNote" Style="color:#F0E6FF;">
                    @w.Titel
                    <MudText Typo="Typo.caption" Style="color:#A78FC0;">
                        @(w.Jahr.HasValue ? $"({w.Jahr}) " : "")· @RolleText(w.Rolle)
                    </MudText>
                </MudListItem>
            }
        </MudList>
    }

    @* Auftritte (VideoMitwirkungen) *@
    <MudText Typo="Typo.h5" GutterBottom="true" Style="color:#D4AF37;">Auftritte (@_auftritte.Count)</MudText>
    @if (_auftritte.Count == 0)
    {
        <MudText Typo="Typo.body2" Style="color:#A78FC0;">Noch keine Auftritte erfasst.</MudText>
    }
    else
    {
        <MudList T="string" Dense="true">
            @foreach (var a in _auftritte)
            {
                <MudListItem T="string" Href="@($"/videos/{a.VideoId}")" Icon="@Icons.Material.Filled.PlayCircle" Style="color:#F0E6FF;">
                    @a.StueckTitel
                    <MudText Typo="Typo.caption" Style="color:#A78FC0;">
                        @MitwirkungText(a)@(a.BandName != null ? $" · {a.BandName}" : "")
                    </MudText>
                </MudListItem>
            }
        </MudList>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Person? _person;
    private List<WerkZeile> _werke = [];
    private List<AuftrittZeile> _auftritte = [];
    private List<BandZeile> _bands = [];

    private string? _userId;
    private bool _personVerknuepft;   // Person hat (irgend)ein Konto
    private bool _verknuepftMitMir;   // Person ist mit MIR verknüpft
    private bool _offenerAntrag;      // ich habe bereits einen offenen Antrag
    private bool _ichHabeSchonPerson; // mein Konto ist bereits mit (irgend)einer Person verknüpft
    private Sichtbarkeit _eff = Sichtbarkeit.Oeffentlich;  // effektive Sichtbarkeit für DICH

    private string AnzeigeName => _person == null ? "Person" : PersonenSicht.AnzeigeName(_person.Name, _eff);
    private string? BildAnzeige => _person == null ? null : PersonenSicht.BildUrl(_person.BildUrl, _eff);

    private List<BreadcrumbItem> _breadcrumbs => _person == null ? [] :
    [
        new("Startseite", "/"),
        new("Personen", "/personen"),
        new(AnzeigeName, null, disabled: true)
    ];

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _person = await db.Personen
            .Include(p => p.Rollen)
            .Include(p => p.Links)
            .Include(p => p.Instrumente).ThenInclude(pi => pi.Instrument)
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (_person == null) { Nav.NavigateTo("/personen"); return; }

        _werke = await db.StueckBeitraege
            .Where(b => b.PersonId == Id)
            .OrderByDescending(b => b.Stueck.Jahr)
            .ThenBy(b => b.Stueck.Titel)
            .Select(b => new WerkZeile(b.StueckId, b.Stueck.Titel, b.Stueck.Jahr, b.Rolle))
            .ToListAsync();

        _auftritte = await db.VideoMitwirkungen
            .Where(m => m.PersonId == Id && m.Status == VideoStatus.Genehmigt)
            .Select(m => new AuftrittZeile(
                m.VideoId, m.Video.StueckId, m.Video.Stueck.Titel, m.Rolle,
                m.Instrument != null ? m.Instrument.Name : null,
                m.Stimme != null ? m.Stimme.Bezeichnung : null,
                m.Video.Band != null ? m.Video.Band.Name : null))
            .ToListAsync();

        _bands = await db.BandMitgliedschaften
            .Where(m => m.PersonId == Id)
            .OrderByDescending(m => m.BisJahr == null)
            .ThenBy(m => m.Band.Name)
            .Select(m => new BandZeile(
                m.BandId, m.Band.Name,
                m.Funktion ?? (m.Instrument != null ? m.Instrument.Name : null),
                m.VonJahr, m.BisJahr))
            .ToListAsync();

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        _personVerknuepft = _person.BenutzerId != null;
        _verknuepftMitMir = _userId != null && _person.BenutzerId == _userId;
        _offenerAntrag = _userId != null && await db.PersonAnsprueche.AnyAsync(a =>
            a.PersonId == Id && a.BenutzerId == _userId && a.Status == PersonAnspruchStatus.Offen);
        _ichHabeSchonPerson = _userId != null && await db.Personen.AnyAsync(p => p.BenutzerId == _userId);

        var vollSichtbar = await PersonenSicht.LadeVollSichtbareAsync(db, _userId);
        _eff = PersonenSicht.Effektiv(_person.Id, _person.Sichtbarkeit, vollSichtbar);
    }

    private async Task DasBinIch()
    {
        if (_person == null || _userId == null) return;
        var parameters = new DialogParameters<PersonAnspruchDialog> { { x => x.PersonName, _person.Name } };
        var dialog = await DialogService.ShowAsync<PersonAnspruchDialog>("Mit Person verknüpfen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        var begruendung = result.Data as string;

        await using var db = await DbFactory.CreateDbContextAsync();
        // Doppelte offene Anträge vermeiden.
        if (await db.PersonAnsprueche.AnyAsync(a =>
            a.PersonId == Id && a.BenutzerId == _userId && a.Status == PersonAnspruchStatus.Offen))
        {
            _offenerAntrag = true;
            return;
        }
        db.PersonAnsprueche.Add(new PersonAnspruch
        {
            PersonId = Id,
            BenutzerId = _userId,
            Begruendung = string.IsNullOrWhiteSpace(begruendung) ? null : begruendung.Trim()
        });
        await db.SaveChangesAsync();
        _offenerAntrag = true;
        Snackbar.Add("Antrag gesendet – ein:e Admin prüft die Verknüpfung.", Severity.Success);
    }

    private static string RolleText(PersonRolleTyp r) => r switch
    {
        PersonRolleTyp.Komponist => "Komponist:in",
        PersonRolleTyp.Dirigent => "Dirigent:in",
        PersonRolleTyp.Musikant => "Musikant:in",
        _ => r.ToString()
    };

    private static string RolleText(StueckRolle r) => r switch
    {
        StueckRolle.Komponist => "Komponist:in",
        StueckRolle.Arrangeur => "Arrangeur:in",
        StueckRolle.Bearbeiter => "Bearbeiter:in",
        _ => r.ToString()
    };

    private static string MitwirkungText(AuftrittZeile a)
    {
        if (a.Rolle == MitwirkungRolle.Dirigent) return "Dirigent:in";
        var teile = new List<string> { "Musikant:in" };
        if (a.Instrument != null) teile.Add(a.Instrument);
        if (a.Stimme != null) teile.Add(a.Stimme);
        return string.Join(" · ", teile);
    }

    private static string LinkIcon(LinkTyp t) => t switch
    {
        LinkTyp.Instagram => Icons.Custom.Brands.Instagram,
        LinkTyp.Facebook => Icons.Custom.Brands.Facebook,
        LinkTyp.X => Icons.Custom.Brands.Twitter,
        LinkTyp.YouTube => Icons.Custom.Brands.YouTube,
        _ => Icons.Material.Filled.OpenInNew
    };

    private record WerkZeile(Guid StueckId, string Titel, int? Jahr, StueckRolle Rolle);
    private record AuftrittZeile(Guid VideoId, Guid StueckId, string StueckTitel, MitwirkungRolle Rolle, string? Instrument, string? Stimme, string? BandName);
    private record BandZeile(Guid BandId, string BandName, string? Rolle, int? VonJahr, int? BisJahr)
    {
        public string Detail
        {
            get
            {
                var teile = new List<string>();
                if (Rolle != null) teile.Add(Rolle);
                if (VonJahr.HasValue || BisJahr.HasValue)
                    teile.Add($"{VonJahr?.ToString() ?? "?"}–{BisJahr?.ToString() ?? "heute"}");
                return teile.Count > 0 ? $"({string.Join(", ", teile)})" : "";
            }
        }
    }
}

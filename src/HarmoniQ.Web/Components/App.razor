@using Microsoft.AspNetCore.Components.Endpoints
@inject IConfiguration Config
@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    @* ── SEO & Social-Sharing (UX-Spec Phase 0 / Block 9.1, Befund A7) ─────────────── *@
    <meta name="description" content="@SeoBeschreibung" />
    <link rel="canonical" href="@SeoBasisUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HarmoniQ" />
    <meta property="og:title" content="HarmoniQ – die Blasmusik-Datenbank" />
    <meta property="og:description" content="@SeoBeschreibung" />
    <meta property="og:url" content="@SeoBasisUrl" />
    <meta property="og:image" content="@($"{SeoBasisUrl}/img/harmoniq-logo.png")" />
    <meta property="og:locale" content="de_CH" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="HarmoniQ – die Blasmusik-Datenbank" />
    <meta name="twitter:description" content="@SeoBeschreibung" />
    <meta name="twitter:image" content="@($"{SeoBasisUrl}/img/harmoniq-logo.png")" />
    <ResourcePreloader />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["HarmoniQ.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="img/harmoniq-icon.svg" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="img/icon-192.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#1a0a2e" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="HarmoniQ" />
    <script>
        // Früh registrieren: beforeinstallprompt feuert teils vor dem Blazor-Start.
        window.__pwaPrompt = null;
        window.addEventListener('beforeinstallprompt', function (e) {
            e.preventDefault();
            window.__pwaPrompt = e;
        });
        window.addEventListener('appinstalled', function () { window.__pwaPrompt = null; });
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('service-worker.js').catch(function () { });
        }
    </script>
    @* Datenschutzkonforme Analytics (Plausible/Umami o.ä.) – nur aktiv, wenn in der Konfiguration
       eine Script-URL hinterlegt ist (cookielos, kein Tracking by default). UX-Spec Block 9.1. *@
    @if (AnalyticsAktiv)
    {
        <script defer src="@AnalyticsScriptUrl" data-website-id="@AnalyticsWebsiteId"></script>
    }
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="@Assets["js/pwreveal.js"]"></script>
    <script src="@Assets["js/lokalkarte.js"]"></script>
    <script src="@Assets["js/geo.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Account-/Identity-Seiten sind mit [ExcludeFromInteractiveRouting] markiert und
    // werden statisch gerendert (sie brauchen HttpContext für Form-Posts). Alles andere
    // läuft interaktiv (InteractiveServer) – so finden die MudBlazor-Provider im Layout
    // ihren interaktiven Render-Kontext.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    // SEO/Sharing: Basis-URL (Produktion) konfigurierbar, Default = Live-Domain.
    private string SeoBasisUrl => (Config["Seo:BasisUrl"] ?? "https://harmoniq.q-no.ch").TrimEnd('/');
    private const string SeoBeschreibung =
        "Entdecke Blasmusik-Konzerte, Stücke, Orchester und die Menschen dahinter – " +
        "vergleiche Aufnahmen auf YouTube und merke dir, welche Konzerte du besucht hast.";

    // Analytics (Umami): aktiv nur außerhalb von Development (keine lokalen Dev-Zugriffe in der
    // Statistik) und nur wenn eine Script-URL konfiguriert ist.
    private string? AnalyticsScriptUrl => Config["Analytics:ScriptUrl"];
    private string? AnalyticsWebsiteId => Config["Analytics:WebsiteId"];
    private bool AnalyticsAktiv => !Env.IsDevelopment() && !string.IsNullOrWhiteSpace(AnalyticsScriptUrl);
}

@inherits LayoutComponentBase
@using Microsoft.Extensions.Hosting
@using Microsoft.AspNetCore.Components.Authorization
@inject IWebHostEnvironment Env
@inject AuthenticationStateProvider AuthProvider
@inject HarmoniQ.Web.Data.BenutzerKontext BenutzerKontext

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<PwaInstall />

<MudLayout>
    <MudAppBar Elevation="2" Style="@_appBarStyle">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudLink Href="/" Class="ml-2 d-flex align-center">
            <img src="img/harmoniq-logo.svg" alt="HarmoniQ" style="height:40px;display:block;" />
        </MudLink>
        @if (_dev)
        {
            <MudChip T="string" Size="Size.Small" Class="ml-3"
                     Style="background:#ffffff; color:#a11111; font-weight:700;"
                     Icon="@Icons.Material.Filled.Construction">DEV (localhost)</MudChip>
        }
        <MudSpacer />
        <AuthorizeView Context="auth">
            <Authorized>
                <MudButton Color="Color.Inherit" Href="/account/profil"
                           StartIcon="@Icons.Material.Filled.AccountCircle">
                    @auth.User.Identity?.Name
                </MudButton>
                <form action="Account/Logout" method="post" style="display:inline; margin-left:.5rem;">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="" />
                    <button type="submit" class="appbar-logout" title="Abmelden">
                        Abmelden
                    </button>
                </form>
            </Authorized>
            <NotAuthorized>
                <MudButton Color="Color.Inherit" Href="Account/Login" StartIcon="@Icons.Material.Filled.Login">
                    Anmelden
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always"
               Style="background: #12001f;">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Style="background: #0e0018; min-height: 100vh;">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-10">
            @Body
            @* Platz, damit die fixe Bottom-Navigation den Inhalt auf dem Smartphone nicht überdeckt. *@
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <div style="height:64px;"></div>
            </MudHidden>
        </MudContainer>
    </MudMainContent>

    @* ── Bottom-Navigation (nur Smartphone, smartphone-first, UX-Spec §6) ──── *@
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <div style="position:fixed;bottom:0;left:0;right:0;z-index:1300;display:flex;
                    background:#12001f;border-top:1px solid #3a1060;">
            @BottomTab("/", Icons.Material.Filled.Home, "Start")
            @BottomTab("/konzerte", Icons.Material.Filled.Event, "Konzerte")
            @BottomTab("/account/tagebuch", Icons.Material.Filled.MenuBook, "Tagebuch")
            @BottomTab("/videos", Icons.Material.Filled.VideoLibrary, "Videos")
            <div @onclick="ToggleDrawer" style="@_bottomItemStyle">
                <MudIcon Icon="@Icons.Material.Filled.Menu" Size="Size.Small" Style="color:#D4AF37;" />
                <span style="font-size:.68rem;color:#A78FC0;">Mehr</span>
            </div>
        </div>
    </MudHidden>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _dev;
    // Im Dev rote App-Bar, in Prod das violette Verlaufs-Design.
    private string _appBarStyle = "background: linear-gradient(90deg, #1a0a2e 0%, #2d1657 100%);";

    protected override void OnInitialized()
    {
        _dev = Env.IsDevelopment();
        if (_dev)
            _appBarStyle = "background: linear-gradient(90deg, #5a1111 0%, #a11111 100%);";
    }

    protected override async Task OnInitializedAsync()
    {
        // Aktuelle Person für die Audit-Spalten (createuser/modifyuser) im Circuit hinterlegen.
        var state = await AuthProvider.GetAuthenticationStateAsync();
        BenutzerKontext.Setzen(state.User.Identity?.IsAuthenticated == true ? state.User.Identity.Name : null);
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private const string _bottomItemStyle =
        "flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;" +
        "padding:6px 0;cursor:pointer;text-decoration:none;gap:2px;";

    // Ein Tab der Bottom-Navigation (Icon + Label, führt auf eine Route).
    private RenderFragment BottomTab(string href, string icon, string label) =>@<a href="@href" style="@_bottomItemStyle">
        <MudIcon Icon="@icon" Size="Size.Small" Style="color:#D4AF37;" />
        <span style="font-size:.68rem;color:#A78FC0;">@label</span>
    </a>;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#D4AF37",       // Gold
            Secondary = "#9B59B6",     // Violett
            Background = "#0e0018",
            Surface = "#1a0030",
            AppbarBackground = "#1a0a2e",
            DrawerBackground = "#12001f",
            TextPrimary = "#F0E6FF",
            TextSecondary = "#A78FC0",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#D4AF37",
            Secondary = "#9B59B6",
            Background = "#0e0018",
            Surface = "#1a0030",
            AppbarBackground = "#1a0a2e",
            DrawerBackground = "#12001f",
            TextPrimary = "#F0E6FF",
            TextSecondary = "#A78FC0",
            ActionDefault = "#D4AF37",
        },
        Typography = new Typography
        {
            H4 = new DefaultTypography { FontFamily = ["Playfair Display", "serif"], FontWeight = "700" },
            H5 = new DefaultTypography { FontFamily = ["Playfair Display", "serif"], FontWeight = "600" },
        }
    };
}

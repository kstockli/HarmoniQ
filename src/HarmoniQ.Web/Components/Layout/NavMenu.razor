@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Data.Models
@inject NavigationManager Nav
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<MudNavMenu Class="pa-2">
    <MudText Typo="Typo.overline" Class="px-4 pt-4 pb-1 mud-text-secondary">Musik</MudText>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        Startseite
    </MudNavLink>
    <MudNavLink Href="/konzerte" Icon="@Icons.Material.Filled.Event">
        Konzerte
    </MudNavLink>
    <MudNavLink Href="/komponisten" Icon="@Icons.Material.Filled.Person">
        Komponist:innen
    </MudNavLink>
    <MudNavLink Href="/personen" Icon="@Icons.Material.Filled.Groups2">
        Personen
    </MudNavLink>
    <MudNavLink Href="/stuecke" Icon="@Icons.Material.Filled.MusicNote">
        Stücke
    </MudNavLink>
    <MudNavLink Href="/videos" Icon="@Icons.Material.Filled.VideoLibrary">
        Videos
    </MudNavLink>
    <MudNavLink Href="/bands" Icon="@Icons.Material.Filled.Groups">
        Bands
    </MudNavLink>

    <MudDivider Class="my-2" />

    <AuthorizeView>
        <Authorized>
            <MudText Typo="Typo.overline" Class="px-4 pt-2 pb-1 mud-text-secondary">Konto</MudText>
            <MudNavLink Href="/account/tagebuch" Icon="@Icons.Material.Filled.MenuBook">
                Mein Tagebuch
            </MudNavLink>
            <MudNavLink Href="/account/profil" Icon="@Icons.Material.Filled.FavoriteBorder">
                Meine Beiträge
            </MudNavLink>
            <MudNavLink Href="/account/freunde" Icon="@Icons.Material.Filled.People">
                Mein Netzwerk
            </MudNavLink>
            <MudNavLink Href="/account/person" Icon="@Icons.Material.Filled.Badge">
                Meine Person
            </MudNavLink>
            <MudNavLink Href="Account/Manage" Icon="@Icons.Material.Filled.Settings">
                Profil
            </MudNavLink>
            <MudDivider Class="my-2" />
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudText Typo="Typo.overline" Class="px-4 pt-2 pb-1 mud-text-secondary">Admin</MudText>
            <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AdminPanelSettings">
                Dashboard
            </MudNavLink>

            <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-1 mud-text-secondary">Stammdaten</MudText>
            <MudNavLink Href="/admin/personen" Icon="@Icons.Material.Filled.Groups2">
                Personen
            </MudNavLink>
            <MudNavLink Href="/admin/benutzer" Icon="@Icons.Material.Filled.ManageAccounts">
                Benutzer
            </MudNavLink>
            <MudNavLink Href="/admin/konzerte" Icon="@Icons.Material.Filled.Event">
                Konzerte
            </MudNavLink>
            <MudNavLink Href="/admin/lokale" Icon="@Icons.Material.Filled.Place">
                Lokale
            </MudNavLink>
            <MudNavLink Href="/admin/instrumente" Icon="@Icons.Material.Filled.Piano">
                Instrumente
            </MudNavLink>
            <MudNavLink Href="/admin/stuecke" Icon="@Icons.Material.Filled.MusicNote">
                Stücke
            </MudNavLink>
            <MudNavLink Href="/admin/bands" Icon="@Icons.Material.Filled.Groups">
                Bands
            </MudNavLink>
            <MudNavLink Href="/admin/videos" Icon="@Icons.Material.Filled.VideoLibrary">
                Videos
            </MudNavLink>
            <MudNavLink Href="/admin/bewertungen" Icon="@Icons.Material.Filled.Star">
                Bewertungen
            </MudNavLink>

            <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-1 mud-text-secondary">Vorschläge</MudText>
            <MudNavLink Href="/admin/vorschlaege" Icon="@Icons.Material.Filled.RateReview">
                Video-Vorschläge @Badge(_videosOffen)
            </MudNavLink>
            <MudNavLink Href="/admin/mitwirkungen" Icon="@Icons.Material.Filled.GroupAdd">
                Mitwirkungs-Vorschläge @Badge(_mitwirkungenOffen)
            </MudNavLink>
            <MudNavLink Href="/admin/richtigstellungen" Icon="@Icons.Material.Filled.ReportProblem">
                Richtigstellungen @Badge(_richtigstellungenOffen)
            </MudNavLink>
            <MudNavLink Href="/admin/tagebuch-moderation" Icon="@Icons.Material.Filled.Public">
                Öffentl. Tagebuch
            </MudNavLink>
            <MudNavLink Href="/admin/verknuepfungen" Icon="@Icons.Material.Filled.PersonPin">
                Verknüpfungs-Anträge @Badge(_verknuepfungenOffen)
            </MudNavLink>
            <MudNavLink Href="/admin/bandantraege" Icon="@Icons.Material.Filled.GroupAdd">
                Band-Anträge @Badge(_bandantraegeOffen)
            </MudNavLink>

            <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-1 mud-text-secondary">Import-Assistenten</MudText>
            <MudNavLink Href="/admin/crawler" Icon="@Icons.Material.Filled.TravelExplore">
                Crawler @Badge(_crawlerFundeOffen)</MudNavLink>
            <MudNavLink Href="/admin/import" Icon="@Icons.Material.Filled.Download">
                Import-Assistent</MudNavLink>
            <MudNavLink Href="/admin/wmc-import" Icon="@Icons.Material.Filled.Public">
                WMC 2026 (einmalig)</MudNavLink>
            <MudDivider Class="my-2" />
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private int _videosOffen, _mitwirkungenOffen, _richtigstellungenOffen, _verknuepfungenOffen, _bandantraegeOffen, _crawlerFundeOffen;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _videosOffen = await db.Videos.CountAsync(v => v.Status == VideoStatus.Ausstehend);
            _mitwirkungenOffen = await db.VideoMitwirkungen.CountAsync(m => m.Status == VideoStatus.Ausstehend);
            _richtigstellungenOffen = await db.Richtigstellungen.CountAsync(r => r.Status == RichtigstellungStatus.Offen);
            _verknuepfungenOffen = await db.PersonAnsprueche.CountAsync(a => a.Status == PersonAnspruchStatus.Offen);
            _bandantraegeOffen = await db.BandbeitrittAntraege.CountAsync(a => a.Status == PersonAnspruchStatus.Offen);
            _crawlerFundeOffen = await db.CrawlFunde.CountAsync(f => f.Status == CrawlFundStatus.Offen);
        }
        catch { /* Menü darf nie wegen Zählern brechen */ }
    }

    private RenderFragment? Badge(int n) => n <= 0 ? null : __builder =>
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ml-1 px-1" Style="height:18px;">@n</MudChip>
    };
}

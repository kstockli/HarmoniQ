@page "/Account/ResetPasswordConfirmation"
<PageTitle>Passwort geändert – HarmoniQ</PageTitle>

<div class="auth-wrap">
    <div class="auth-card">
        <h1 class="auth-title">Passwort geändert</h1>
        <p class="auth-sub" role="alert">
            Dein Passwort wurde zurückgesetzt. Du kannst dich jetzt mit dem neuen Passwort anmelden.
        </p>
        <div class="auth-links"><a href="Account/Login">Jetzt anmelden</a></div>
    </div>
</div>

@page "/Account/ConfirmEmailChange"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using HarmoniQ.Web.Data
@using HarmoniQ.Web.Services

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>E-Mail-Änderung bestätigen – HarmoniQ</PageTitle>

<div class="auth-wrap">
    <div class="auth-card">
        <h1 class="auth-title">E-Mail-Änderung</h1>
        <StatusMessage Message="@message" />
        <div class="auth-links"><a href="Account/Manage/Email">Zur E-Mail-Verwaltung</a></div>
    </div>
</div>

@code {
    private string? message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Email is null || Code is null)
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Login", "Fehler: Ungültiger Bestätigungslink für die E-Mail-Änderung.", HttpContext);
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            message = "Benutzer konnte nicht gefunden werden.";
            return;
        }

        var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        var result = await UserManager.ChangeEmailAsync(user, Email, code);
        if (!result.Succeeded)
        {
            message = "Fehler beim Ändern der E-Mail-Adresse.";
            return;
        }

        // In unserer UI sind E-Mail und Benutzername identisch – daher auch den Benutzernamen aktualisieren.
        var setUserNameResult = await UserManager.SetUserNameAsync(user, Email);
        if (!setUserNameResult.Succeeded)
        {
            message = "Fehler beim Ändern des Benutzernamens.";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);

        // E-Mail-Link einer ggf. verknüpften Person mitziehen.
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await PersonLinkSync.SyncEmailAsync(db, user.Id, Email);
        }

        message = "Danke! Deine neue E-Mail-Adresse wurde bestätigt.";
    }
}

@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using HarmoniQ.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Anmelden</PageTitle>

<div class="auth-wrap">
    <div class="auth-card">
        <h1 class="auth-title">@Titel</h1>
        <p class="auth-sub">@Untertitel</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="auth-error">@errorMessage</div>
        }
        @if (_emailUnbestaetigt)
        {
            <div class="auth-links">
                <a href="@(NavigationManager.GetUriWithQueryParameters("Account/ResendEmailConfirmation", new Dictionary<string, object?> { ["email"] = Input.Email }))">
                    Bestätigungs-E-Mail erneut senden
                </a>
            </div>
        }

        @* Schritt 1: externe Dienste zuerst, dann E-Mail. *@
        @if (Input.Phase == "email")
        {
            <ExternalLoginPicker />
            <div class="auth-divider">oder</div>
        }

        <EditForm Model="Input" method="post" OnSubmit="Weiter" FormName="auth">
            <input type="hidden" name="Input.Phase" value="@Input.Phase" />

            @if (Input.Phase == "email")
            {
                <div class="auth-field">
                    <label for="Input.Email" class="auth-label">E-Mail-Adresse</label>
                    <InputText @bind-Value="Input.Email" id="Input.Email" class="auth-input"
                               autocomplete="username webauthn" aria-required="true" placeholder="name@beispiel.ch" />
                </div>
                <button type="submit" class="auth-btn">Weiter</button>

                <div class="auth-divider">oder</div>
                <div style="text-align:center;">
                    <PasskeySubmit Operation="PasskeyOperation.Request" Name="Input.Passkey" EmailName="Input.Email" class="btn btn-link">Mit Passkey anmelden</PasskeySubmit>
                </div>
            }
            else
            {
                @* Schritt 2: E-Mail steht fest (änderbar über „ändern"). *@
                <div class="auth-field">
                    <label class="auth-label">E-Mail-Adresse</label>
                    <div style="display:flex; align-items:center; gap:.5rem;">
                        <InputText @bind-Value="Input.Email" class="auth-input" readonly style="flex:1;" />
                        <button type="submit" name="Input.Aktion" value="aendern" formnovalidate
                                class="btn btn-link" style="white-space:nowrap;">ändern</button>
                    </div>
                </div>

                @if (Input.Phase == "login")
                {
                    <div class="auth-field">
                        <label for="Input.Password" class="auth-label">Passwort</label>
                        <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="auth-input"
                                   autocomplete="current-password" aria-required="true" placeholder="Dein Passwort" />
                    </div>
                    <label class="auth-check">
                        <InputCheckbox @bind-Value="Input.RememberMe" /> Angemeldet bleiben
                    </label>
                    <button type="submit" class="auth-btn">Anmelden</button>
                    <div class="auth-links">
                        <a href="Account/ForgotPassword">Passwort vergessen?</a>
                    </div>
                }
                else
                {
                    <p class="auth-sub" style="margin-top:0;">Diese E-Mail hat noch kein Konto – wir erstellen dir jetzt eines.</p>
                    <div class="auth-field">
                        <label for="Input.Password" class="auth-label">Passwort wählen</label>
                        <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="auth-input"
                                   autocomplete="new-password" aria-required="true" placeholder="Mindestens 6 Zeichen" />
                    </div>
                    <div class="auth-field">
                        <label for="Input.ConfirmPassword" class="auth-label">Passwort wiederholen</label>
                        <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="auth-input"
                                   autocomplete="new-password" aria-required="true" placeholder="Passwort nochmals eingeben" />
                    </div>
                    <button type="submit" class="auth-btn">Konto erstellen</button>
                }
            }
        </EditForm>
    </div>
</div>

@code {
    private string? errorMessage;
    private bool _emailUnbestaetigt;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string Titel => Input.Phase switch
    {
        "login" => "Willkommen zurück",
        "register" => "Konto erstellen",
        _ => "Anmelden oder registrieren"
    };

    private string Untertitel => Input.Phase switch
    {
        "login" => "Gib dein Passwort ein.",
        "register" => "Nur noch ein Passwort wählen – fertig.",
        _ => "Melde dich an oder erstelle ein Konto – ein Einstieg für beides."
    };

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Sauberer Start: bestehendes externes Cookie entfernen.
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task Weiter()
    {
        errorMessage = null;

        // „ändern": zurück zu Schritt 1, E-Mail bleibt bearbeitbar erhalten.
        if (Input.Aktion == "aendern")
        {
            Input.Phase = "email";
            Input.Password = Input.ConfirmPassword = "";
            Input.Aktion = null;
            return;
        }

        // Passkey (aus Schritt 1): keine Formularvalidierung nötig.
        if (!string.IsNullOrEmpty(Input.Passkey?.Error))
        {
            errorMessage = $"Fehler: {Input.Passkey.Error}";
            return;
        }
        if (!string.IsNullOrEmpty(Input.Passkey?.CredentialJson))
        {
            NachSignIn(await SignInManager.PasskeySignInAsync(Input.Passkey.CredentialJson));
            return;
        }

        var email = (Input.Email ?? "").Trim();
        if (string.IsNullOrWhiteSpace(email) || !new EmailAddressAttribute().IsValid(email))
        {
            Input.Phase = "email";
            errorMessage = "Bitte gib eine gültige E-Mail-Adresse ein.";
            return;
        }

        // Schritt 1 → entscheiden: bekanntes Konto (Anmelden) oder neu (Registrieren).
        if (Input.Phase == "email")
        {
            var vorhanden = await UserManager.FindByEmailAsync(email);
            Input.Phase = vorhanden is null ? "register" : "login";
            Input.Password = Input.ConfirmPassword = "";
            return;
        }

        if (Input.Phase == "login")
        {
            if (string.IsNullOrEmpty(Input.Password))
            {
                errorMessage = "Bitte gib dein Passwort ein.";
                return;
            }
            NachSignIn(await SignInManager.PasswordSignInAsync(email, Input.Password, Input.RememberMe, lockoutOnFailure: false));
            return;
        }

        // register
        if (Input.Password.Length < 6)
        {
            errorMessage = "Das Passwort muss mindestens 6 Zeichen lang sein.";
            return;
        }
        if (Input.Password != Input.ConfirmPassword)
        {
            errorMessage = "Passwort und Bestätigung stimmen nicht überein.";
            return;
        }
        await RegistrierenAsync(email);
    }

    private void NachSignIn(SignInResult result)
    {
        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.RequiresTwoFactor)
        {
            RedirectManager.RedirectTo("Account/LoginWith2fa",
                new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = Input.RememberMe });
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("User account locked out.");
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else if (result.IsNotAllowed)
        {
            _emailUnbestaetigt = true;
            errorMessage = "Dein Konto ist noch nicht bestätigt. Bitte öffne den Link in der Bestätigungs-E-Mail – oder fordere sie unten erneut an.";
        }
        else
        {
            errorMessage = "Anmeldung fehlgeschlagen: Passwort ist falsch.";
        }
    }

    private async Task RegistrierenAsync(string email)
    {
        var user = CreateUser();
        await UserStore.SetUserNameAsync(user, email, CancellationToken.None);
        var emailStore = GetEmailStore();
        await emailStore.SetEmailAsync(user, email, CancellationToken.None);
        var result = await UserManager.CreateAsync(user, Input.Password);

        if (!result.Succeeded)
        {
            errorMessage = "Registrierung fehlgeschlagen: " + string.Join(", ", result.Errors.Select(e => e.Description));
            return;
        }

        Logger.LogInformation("User created a new account with password.");

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code, ["returnUrl"] = ReturnUrl });

        await EmailSender.SendConfirmationLinkAsync(user, email, HtmlEncoder.Default.Encode(callbackUrl));

        if (UserManager.Options.SignIn.RequireConfirmedAccount)
        {
            RedirectManager.RedirectTo("Account/RegisterConfirmation",
                new() { ["email"] = email, ["returnUrl"] = ReturnUrl });
        }
        else
        {
            await SignInManager.SignInAsync(user, isPersistent: false);
            RedirectManager.RedirectTo(ReturnUrl);
        }
    }

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException($"Can't create an instance of '{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' is not an abstract class and has a parameterless constructor.");
        }
    }

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException("The default UI requires a user store with email support.");
        }
        return (IUserEmailStore<ApplicationUser>)UserStore;
    }

    private sealed class InputModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
        public bool RememberMe { get; set; }

        // Ablaufsteuerung der einen Maske: email → login | register.
        public string Phase { get; set; } = "email";
        // Nur für den „ändern"-Knopf (zurück zu Schritt 1).
        public string? Aktion { get; set; }

        public PasskeyInputModel? Passkey { get; set; }
    }
}

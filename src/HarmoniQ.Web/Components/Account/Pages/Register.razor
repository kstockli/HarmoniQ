@page "/Account/Register"

@inject IdentityRedirectManager RedirectManager

@* Registrierung läuft jetzt über die eine identifier-first-Maske (/Account/Login). Diese Route
   bleibt für alte Links/Lesezeichen bestehen und leitet dorthin weiter (ReturnUrl bleibt erhalten). *@

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
        => RedirectManager.RedirectTo("Account/Login", new() { ["ReturnUrl"] = ReturnUrl });
}

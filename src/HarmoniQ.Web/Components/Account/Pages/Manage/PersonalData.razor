@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using HarmoniQ.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Persönliche Daten</PageTitle>

<StatusMessage />
<h3 style="color:#F0E6FF;">Persönliche Daten</h3>

<div class="row">
    <div class="col-md-8">
        <p style="color:#C4B0D8;">Dein Konto enthält persönliche Daten, die du uns mitgeteilt hast. Hier kannst du diese Daten herunterladen oder löschen.</p>
        <p>
            <strong style="color:#e0a0a0;">Das Löschen dieser Daten entfernt dein Konto dauerhaft – das lässt sich nicht rückgängig machen.</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Herunterladen</button>
        </form>
        <p class="mt-2">
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Löschen</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}

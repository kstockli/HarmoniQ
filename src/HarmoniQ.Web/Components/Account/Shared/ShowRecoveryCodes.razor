<StatusMessage Message="@StatusMessage" />
<h3 style="color:#F0E6FF;">Wiederherstellungscodes</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <strong>Bewahre diese Codes an einem sicheren Ort auf.</strong>
    </p>
    <p>
        Wenn du dein Gerät verlierst und keine Wiederherstellungscodes hast, verlierst du den Zugang zu deinem Konto.
    </p>
</div>
<div class="row">
    <div class="col-md-12">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <div>
                <code class="recovery-code">@recoveryCode</code>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
